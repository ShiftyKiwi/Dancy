+        private static PapAnimationTransformTrackSummary CreateSummary( AnimationKeys keys ) {
+            var times = keys.TranslationKeys.Keys.OrderBy( time => time ).ToArray();
+            if( times.Length == 0 ) return new PapAnimationTransformTrackSummary();
+            var first = TransformValue( keys, times[0] );
+            var last = TransformValue( keys, times[^1] );
+            var translationRange = 0f;
+            var rotationRange = 0f;
+            var scaleRange = 0f;
+            foreach( var time in times ) {
+                var value = TransformValue( keys, time );
+                translationRange = Math.Max( translationRange, Vector3.Distance( ToTranslation( first ), ToTranslation( value ) ) );
+                rotationRange = Math.Max( rotationRange, RotationDifferenceDegrees( ToRotation( first ), ToRotation( value ) ) );
+                scaleRange = Math.Max( scaleRange, Vector3.Distance( ToScale( first ), ToScale( value ) ) );
+            }
+            return new PapAnimationTransformTrackSummary {
+                SampleCount = times.Length,
+                TranslationChanges = translationRange > 0.0001f,
+                RotationChanges = rotationRange > 0.1f,
+                ScaleChanges = scaleRange > 0.0001f,
+                TranslationRangeMagnitude = translationRange,
+                RotationRangeDegrees = rotationRange,
+                ScaleRangeMagnitude = scaleRange,
+                FirstSample = first,
+                LastSample = last,
+            };
+        }
