+            if( sourceTimes.Length != reference.TranslationKeys.Count || sourceTimes.Any( time => !reference.TranslationKeys.ContainsKey( time ) ) ) {
+                throw new ArgumentException( "Source and reference samples do not share the same sample times." );
+            }
+            var translation = 0f;
+            var rotation = 0f;
+            var scale = 0f;
+            foreach( var time in sourceTimes ) {
+                var left = TransformValue( source, time );
+                var right = TransformValue( reference, time );
+                translation = Math.Max( translation, Vector3.Distance( ToTranslation( left ), ToTranslation( right ) ) );
+                rotation = Math.Max( rotation, RotationDifferenceDegrees( ToRotation( left ), ToRotation( right ) ) );
+                scale = Math.Max( scale, Vector3.Distance( ToScale( left ), ToScale( right ) ) );
+            }
+            return new PapAnimationTransformDifference {
+                MaximumTranslationDifference = translation,
+                MaximumRotationDifferenceDegrees = rotation,
+                MaximumScaleDifference = scale,
+            };
+        }
