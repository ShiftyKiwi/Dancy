@@ -0,0 +1,268 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Security.Cryptography;
+using System.Threading.Tasks;
+using Dancy.Animation;
+using Dancy.Domain;
+using Dancy.Pap;
+using ECommons.DalamudServices;
+using Penumbra.Api.IpcSubscribers;
+
+namespace Dancy.BoneMasking;
+
+internal static class DalamudFrameworkInvocation
+{
+    public static T Invoke<T>(Func<T> action)
+    {
+        var completion = new TaskCompletionSource<T>(TaskCreationOptions.RunContinuationsAsynchronously);
+        Svc.Framework.RunOnFrameworkThread(() =>
+        {
+            try { completion.TrySetResult(action()); }
+            catch (Exception exception) { completion.TrySetException(exception); }
+        });
+        return completion.Task.GetAwaiter().GetResult();
+    }
+}
+
+internal sealed class DalamudActiveGamePathResolver : IActiveGamePathResolver
+{
+    private readonly ResolvePlayerPath resolvePlayerPath = new(Plugin.PluginInterface);
+
+    public string ResolveForPlayer(string logicalGamePath)
+        => DalamudFrameworkInvocation.Invoke(() => resolvePlayerPath.Invoke(logicalGamePath));
+}
+
+/// <summary>
+/// Resolves the character's effective skeleton through Penumbra first. Base
+/// game skeletons are copied once into Dancy-owned storage because VFXEditor's
+/// public contract requires a local file path.
+/// </summary>
+internal sealed class DalamudTargetSkeletonPathResolver : ITargetSkeletonPathResolver
+{
+    private readonly IActiveGamePathResolver activePaths;
+    private readonly string skeletonRoot;
+
+    public DalamudTargetSkeletonPathResolver(IActiveGamePathResolver activePaths, string dancyPatchRoot)
+    {
+        this.activePaths = activePaths ?? throw new ArgumentNullException(nameof(activePaths));
+        skeletonRoot = Path.Combine(Path.GetFullPath(dancyPatchRoot), "skeletons");
+    }
+
+    public bool TryResolve(string logicalGamePath, out string skeletonPath, out string skeletonIdentity, out string error)
+    {
+        skeletonPath = string.Empty;
+        skeletonIdentity = string.Empty;
+        error = string.Empty;
+        var identity = CharacterPathIdentity.FromGamePath(logicalGamePath);
+        if (!identity.IsKnown)
+        {
+            error = "The logical PAP path does not identify a known playable character model.";
+            return false;
+        }
+
+        var gameSkeletonPath = $"chara/human/{identity.Code}/skeleton/base/b0001/skl_{identity.Code}b0001.sklb";
+        try
+        {
+            var effective = activePaths.ResolveForPlayer(gameSkeletonPath);
+            if (Path.IsPathRooted(effective) && File.Exists(effective))
+            {
+                var fullPath = Path.GetFullPath(effective);
+                skeletonPath = fullPath;
+                skeletonIdentity = gameSkeletonPath + "|" + HashFile(fullPath);
+                return true;
+            }
+
+            var file = Plugin.DataManager.GetFile(gameSkeletonPath);
+            if (file is null)
+            {
+                error = "The game skeleton file was not available.";
+                return false;
+            }
+            if (file.Reader.BaseStream.CanSeek)
+                file.Reader.BaseStream.Position = 0;
+            using var buffer = new MemoryStream();
+            file.Reader.BaseStream.CopyTo(buffer);
+            var bytes = buffer.ToArray();
+            var hash = Convert.ToHexString(SHA256.HashData(bytes));
+            Directory.CreateDirectory(skeletonRoot);
+            var localPath = Path.Combine(skeletonRoot, hash.ToLowerInvariant() + ".sklb");
+            if (!File.Exists(localPath))
+            {
+                var temporary = localPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
+                File.WriteAllBytes(temporary, bytes);
+                File.Move(temporary, localPath, overwrite: false);
+            }
+            skeletonPath = localPath;
+            skeletonIdentity = gameSkeletonPath + "|" + hash;
+            return true;
+        }
+        catch (Exception exception)
+        {
+            error = exception.Message;
+            return false;
+        }
+    }
+
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+}
+
+/// <summary>
+/// Reads the vanilla PAP directly from game data, never through Penumbra's
+/// effective-path resolver. VFXEditor's IPC requires a local file path, so the
+/// immutable game-data bytes are copied under Dancy-owned storage with their
+/// hash and selected Havok motion recorded as provenance.
+/// </summary>
+internal sealed class DalamudVanillaReferencePapPathResolver : IReferencePapPathResolver
+{
+    private readonly string referenceRoot;
+
+    public DalamudVanillaReferencePapPathResolver(string dancyPatchRoot)
+        => referenceRoot = Path.Combine(Path.GetFullPath(dancyPatchRoot), "reference-paps");
+
+    public bool TryResolve(string logicalGamePath, int animationIndex, out AnimationReferencePap reference, out string error)
+    {
+        reference = new AnimationReferencePap();
+        error = string.Empty;
+        if (animationIndex < 0)
+        {
+            error = "The requested reference animation index is invalid.";
+            return false;
+        }
+        try
+        {
+            var gamePath = GamePathIdentity.Normalize(logicalGamePath);
+            var file = Plugin.DataManager.GetFile(gamePath);
+            if (file is null)
+            {
+                error = "The vanilla game PAP was not available.";
+                return false;
+            }
+            if (file.Reader.BaseStream.CanSeek)
+                file.Reader.BaseStream.Position = 0;
+            using var buffer = new MemoryStream();
+            file.Reader.BaseStream.CopyTo(buffer);
+            var bytes = buffer.ToArray();
+            var inspection = PapFileInspector.Inspect(bytes);
+            if (animationIndex >= inspection.HavokIndices.Count || inspection.HavokIndices[animationIndex] < 0)
+            {
+                error = "The vanilla game PAP does not contain the requested Havok animation.";
+                return false;
+            }
+            var hash = Convert.ToHexString(SHA256.HashData(bytes));
+            Directory.CreateDirectory(referenceRoot);
+            var localPath = Path.Combine(referenceRoot, hash.ToLowerInvariant() + ".pap");
+            if (!File.Exists(localPath))
+            {
+                var temporary = localPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
+                File.WriteAllBytes(temporary, bytes);
+                try { File.Move(temporary, localPath, overwrite: false); }
+                catch (IOException) when (File.Exists(localPath)) { File.Delete(temporary); }
+            }
+            reference = new AnimationReferencePap
+            {
+                PhysicalPath = localPath,
+                Sha256 = hash,
+                MotionIndex = inspection.HavokIndices[animationIndex],
+                Identity = "vanilla|" + gamePath + "|" + hash + "|havok:" + inspection.HavokIndices[animationIndex],
+            };
+            return true;
+        }
+        catch (Exception exception)
+        {
+            error = exception.Message;
+            return false;
+        }
+    }
+}
+
+public sealed class BoneMaskLivePatchResult
+{
+    public bool Succeeded { get; init; }
+    public string Message { get; init; } = string.Empty;
+    public IReadOnlyList<string> StaleSources { get; init; } = Array.Empty<string>();
+    public IReadOnlyDictionary<string, string> Mappings { get; init; } = new Dictionary<string, string>();
+}
+
+/// <summary>
+/// Applies only Dancy-owned files as a player-collection temporary mod. This
+/// leaves the source Penumbra mod, its options, and its metadata untouched.
+/// </summary>
+public sealed class BoneMaskLivePatchService
+{
+    private const int Priority = 9000;
+    private readonly GetCollectionForObject collectionForObject = new(Plugin.PluginInterface);
+    private readonly AddTemporaryMod addTemporaryMod = new(Plugin.PluginInterface);
+    private readonly RemoveTemporaryMod removeTemporaryMod = new(Plugin.PluginInterface);
+
+    public BoneMaskLivePatchResult Enable(BoneMaskPatchRecord record)
+    {
+        ArgumentNullException.ThrowIfNull(record);
+        var stale = BoneMaskPatchStaleness.FindChangedSources(record.Assets);
+        if (stale.Count > 0)
+            return new BoneMaskLivePatchResult { Message = "Source animation changed; rebuild this Dancy patch before enabling it.", StaleSources = stale };
+
+        var mappings = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var asset in record.Assets)
+        {
+            if (string.IsNullOrWhiteSpace(asset.LogicalGamePath) || !File.Exists(asset.OutputPapPath))
+                return new BoneMaskLivePatchResult { Message = "A generated Dancy PAP is missing; rebuild this patch before enabling it." };
+            var currentHash = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(asset.OutputPapPath)));
+            if (!string.Equals(currentHash, asset.OutputPapSha256, StringComparison.OrdinalIgnoreCase))
+                return new BoneMaskLivePatchResult { Message = "A generated Dancy PAP changed on disk; rebuild this patch before enabling it." };
+            mappings[asset.LogicalGamePath] = asset.OutputPapPath;
+        }
+        if (mappings.Count == 0)
+            return new BoneMaskLivePatchResult { Message = "This Dancy patch contains no game-path redirects." };
+
+        try
+        {
+            var result = DalamudFrameworkInvocation.Invoke(() =>
+            {
+                var playerIndex = Plugin.ObjectTable.LocalPlayer?.ObjectIndex ?? -1;
+                if (playerIndex < 0)
+                    throw new InvalidOperationException("The local player is unavailable.");
+                var collection = collectionForObject.Invoke(playerIndex);
+                if (!collection.Item1 || !collection.Item2 || collection.Item3.Item1 == Guid.Empty)
+                    throw new InvalidOperationException("Penumbra did not provide an effective player collection.");
+                return addTemporaryMod.Invoke(Tag(record), collection.Item3.Item1, mappings, string.Empty, Priority).ToString();
+            });
+            if (!string.Equals(result, "Success", StringComparison.OrdinalIgnoreCase))
+                return new BoneMaskLivePatchResult { Message = "Penumbra rejected the Dancy temporary patch: " + result };
+            record.Enabled = true;
+            return new BoneMaskLivePatchResult { Succeeded = true, Message = "Dancy Bone Mask patch enabled.", Mappings = mappings };
+        }
+        catch (Exception exception)
+        {
+            return new BoneMaskLivePatchResult { Message = "Could not enable Dancy Bone Mask patch: " + exception.Message };
+        }
+    }
+
+    public BoneMaskLivePatchResult Disable(BoneMaskPatchRecord record)
+    {
+        ArgumentNullException.ThrowIfNull(record);
+        try
+        {
+            var result = DalamudFrameworkInvocation.Invoke(() =>
+            {
+                var playerIndex = Plugin.ObjectTable.LocalPlayer?.ObjectIndex ?? -1;
+                if (playerIndex < 0)
+                    throw new InvalidOperationException("The local player is unavailable.");
+                var collection = collectionForObject.Invoke(playerIndex);
+                if (!collection.Item1 || !collection.Item2 || collection.Item3.Item1 == Guid.Empty)
+                    throw new InvalidOperationException("Penumbra did not provide an effective player collection.");
+                return removeTemporaryMod.Invoke(Tag(record), collection.Item3.Item1, Priority).ToString();
+            });
+            if (result is not "Success" and not "NothingDone" and not "NothingChanged")
+                return new BoneMaskLivePatchResult { Message = "Penumbra could not remove the Dancy temporary patch: " + result };
+            record.Enabled = false;
+            return new BoneMaskLivePatchResult { Succeeded = true, Message = "Dancy Bone Mask patch disabled." };
+        }
+        catch (Exception exception)
+        {
+            return new BoneMaskLivePatchResult { Message = "Could not disable Dancy Bone Mask patch: " + exception.Message };
+        }
+    }
+
+    private static string Tag(BoneMaskPatchRecord record) => "Dancy.BoneMask." + record.PatchId;
+}
diff --git a/Dancy/BoneMasking/InstalledPenumbraSourceResolver.cs b/Dancy/BoneMasking/InstalledPenumbraSourceResolver.cs
new file mode 100644
index 0000000..a1f8b8e
--- /dev/null
+++ b/Dancy/BoneMasking/InstalledPenumbraSourceResolver.cs
@@ -0,0 +1,166 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using Dancy.Domain;
+using Dancy.Penumbra;
+using Dancy.Persistence;
+using Newtonsoft.Json.Linq;
+
+namespace Dancy.BoneMasking;
+
+public interface IActiveGamePathResolver
+{
+    string ResolveForPlayer(string logicalGamePath);
+}
+
+/// <summary>
+/// Combines Penumbra's supported effective-path resolution with read-only v4
+/// metadata inspection. Metadata alone is not treated as proof that an option
+/// is active: its physical PAP must match Penumbra's current player result.
+/// </summary>
+public static class InstalledPenumbraSourceResolver
+{
+    public static InstalledModSourceResolution ResolveMod(
+        string penumbraRoot,
+        string sourceModDirectory,
+        string sourceModName,
+        IActiveGamePathResolver activePathResolver)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(penumbraRoot);
+        ArgumentException.ThrowIfNullOrWhiteSpace(sourceModDirectory);
+        ArgumentNullException.ThrowIfNull(activePathResolver);
+        var errors = new List<string>();
+        var warnings = new List<string>();
+        if (!PathSafety.TryResolveInsideRoot(penumbraRoot, sourceModDirectory, out var modFolder) || !Directory.Exists(modFolder))
+        {
+            errors.Add("Dancy refused the requested source mod directory.");
+            return Result(sourceModDirectory, sourceModName, [], null, null, warnings, errors);
+        }
+
+        var metaPath = Path.Combine(modFolder, "meta.json");
+        if (!File.Exists(metaPath))
+        {
+            errors.Add("The source mod does not contain meta.json.");
+            return Result(sourceModDirectory, sourceModName, [], null, null, warnings, errors);
+        }
+
+        JObject meta;
+        try
+        {
+            meta = JObject.Parse(File.ReadAllText(metaPath));
+        }
+        catch (Exception exception)
+        {
+            errors.Add($"Could not parse source meta.json: {exception.Message}");
+            return Result(sourceModDirectory, sourceModName, [], null, null, warnings, errors);
+        }
+
+        if ((meta["FileVersion"]?.Value<int?>() ?? 0) < 4)
+        {
+            errors.Add("Installed Bone Mask currently requires Penumbra FileVersion 4 metadata.");
+            return Result(sourceModDirectory, sourceModName, [], null, null, warnings, errors);
+        }
+
+        var resolvedName = meta["Name"]?.ToString();
+        if (!string.IsNullOrWhiteSpace(resolvedName))
+            sourceModName = resolvedName;
+
+        var companions = CompanionAssetResolver.Resolve(meta, modFolder);
+        var papOptionGroups = PapOptionGroupResolver.Resolve(meta);
+        warnings.AddRange(companions.Warnings);
+
+        var active = new List<InstalledPapMapping>();
+        foreach (var mapping in PenumbraMetadataScanner.ScanV4(meta)
+                     .Where(mapping => mapping.GamePath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase)
+                                       && mapping.ModPath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase)))
+        {
+            if (!PathSafety.TryResolveInsideRoot(modFolder, mapping.ModPath, out var candidate) || !File.Exists(candidate))
+            {
+                warnings.Add($"Skipped missing or unsafe PAP mapping {mapping.GamePath}.");
+                continue;
+            }
+
+            string effective;
+            try
+            {
+                effective = activePathResolver.ResolveForPlayer(mapping.GamePath);
+            }
+            catch (Exception exception)
+            {
+                warnings.Add($"Could not resolve active path {mapping.GamePath}: {exception.Message}");
+                continue;
+            }
+
+            if (!EquivalentPath(candidate, effective))
+                continue;
+
+            active.Add(new InstalledPapMapping
+            {
+                SourceModDirectory = sourceModDirectory,
+                SourceModName = sourceModName,
+                SourceGroupName = mapping.GroupName,
+                SourceOptionName = mapping.OptionName,
+                LogicalGamePath = GamePathIdentity.Normalize(mapping.GamePath),
+                SourceRelativePapPath = mapping.ModPath.Replace('\\', '/'),
+                SourcePhysicalPapPath = Path.GetFullPath(candidate),
+                SourcePapSha256 = HashFile(candidate),
+            });
+        }
+
+        if (active.Count == 0)
+            errors.Add("None of this mod's PAP mappings is currently active for the player collection.");
+        return Result(sourceModDirectory, sourceModName, active, companions, papOptionGroups, warnings, errors);
+    }
+
+    private static InstalledModSourceResolution Result(
+        string directory,
+        string name,
+        IReadOnlyList<InstalledPapMapping> mappings,
+        CompanionAssetResolution? companions,
+        IReadOnlyList<BoneMaskPapOptionGroupRecord>? papOptionGroups,
+        IReadOnlyList<string> warnings,
+        IReadOnlyList<string> errors)
+        => new()
+        {
+            SourceModDirectory = directory,
+            SourceModName = name,
+            ActiveMappings = mappings
+                .GroupBy(mapping => GamePathIdentity.Normalize(mapping.LogicalGamePath), StringComparer.OrdinalIgnoreCase)
+                .Select(group => group.OrderBy(mapping => mapping.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase).First())
+                .OrderBy(mapping => mapping.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+                .ToArray(),
+            PhysicalSourceGroups = mappings
+                .GroupBy(mapping => Path.GetFullPath(mapping.SourcePhysicalPapPath), StringComparer.OrdinalIgnoreCase)
+                .Select(group => new PhysicalPapSourceGroup
+                {
+                    SourcePhysicalPapPath = group.Key,
+                    SourcePapSha256 = group.First().SourcePapSha256,
+                    LogicalGamePaths = group.Select(mapping => mapping.LogicalGamePath).OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray(),
+                })
+                .OrderBy(group => group.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase)
+                .ToArray(),
+            DefaultCompanionAssets = companions?.DefaultAssets ?? [],
+            CompanionGroups = companions?.Groups ?? [],
+            PapOptionGroups = papOptionGroups ?? [],
+            Warnings = warnings.Distinct(StringComparer.Ordinal).ToArray(),
+            Errors = errors.Distinct(StringComparer.Ordinal).ToArray(),
+        };
+
+    private static bool EquivalentPath(string expected, string actual)
+    {
+        if (string.IsNullOrWhiteSpace(actual) || !Path.IsPathRooted(actual))
+            return false;
+        try
+        {
+            return string.Equals(Path.GetFullPath(expected), Path.GetFullPath(actual), StringComparison.OrdinalIgnoreCase);
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+    }
+
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+}
diff --git a/Dancy/Diagnostics/DancyBoneMaskLiveSelfTestRunner.cs b/Dancy/Diagnostics/DancyBoneMaskLiveSelfTestRunner.cs
