@@ -0,0 +1,131 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace Dancy.Animation;
+
+/// <summary>
+/// Selects the source of each local transform component. REMOVE_TRACK is only
+/// valid for all three components and is converted to an explicit exclusion by
+/// the VFXEditor writer; it is never treated as an identity transform.
+/// </summary>
+public enum AnimationTransformComponentMode
+{
+    Source,
+    TargetReference,
+    Rest,
+    RemoveTrack,
+}
+
+public sealed class AnimationTransformComponentMask
+{
+    public string BoneName { get; init; } = string.Empty;
+    public AnimationTransformComponentMode TranslationMode { get; init; } = AnimationTransformComponentMode.Source;
+    public AnimationTransformComponentMode RotationMode { get; init; } = AnimationTransformComponentMode.Source;
+    public AnimationTransformComponentMode ScaleMode { get; init; } = AnimationTransformComponentMode.Source;
+
+    public bool RequiresTargetReference => TranslationMode == AnimationTransformComponentMode.TargetReference
+                                        || RotationMode == AnimationTransformComponentMode.TargetReference
+                                        || ScaleMode == AnimationTransformComponentMode.TargetReference;
+
+    public bool RemovesTrack => TranslationMode == AnimationTransformComponentMode.RemoveTrack
+                             && RotationMode == AnimationTransformComponentMode.RemoveTrack
+                             && ScaleMode == AnimationTransformComponentMode.RemoveTrack;
+
+    public string Canonical => string.Join("|", new[]
+    {
+        BoneName.Trim().ToLowerInvariant(),
+        ToProtocolMode(TranslationMode),
+        ToProtocolMode(RotationMode),
+        ToProtocolMode(ScaleMode),
+    });
+
+    public static string ToProtocolMode(AnimationTransformComponentMode mode) => mode switch
+    {
+        AnimationTransformComponentMode.Source => "SOURCE",
+        AnimationTransformComponentMode.TargetReference => "TARGET_REFERENCE",
+        AnimationTransformComponentMode.Rest => "REST",
+        AnimationTransformComponentMode.RemoveTrack => "REMOVE_TRACK",
+        _ => throw new ArgumentOutOfRangeException(nameof(mode)),
+    };
+}
+
+public sealed class AnimationReferencePap
+{
+    public string PhysicalPath { get; init; } = string.Empty;
+    public string Sha256 { get; init; } = string.Empty;
+    public string Identity { get; init; } = string.Empty;
+    public int MotionIndex { get; init; } = -1;
+}
+
+public sealed class AnimationTransformComponentEvidence
+{
+    public string BoneName { get; init; } = string.Empty;
+    public AnimationTransformComponentMode TranslationMode { get; init; }
+    public AnimationTransformComponentMode RotationMode { get; init; }
+    public AnimationTransformComponentMode ScaleMode { get; init; }
+    public bool TranslationMatchesSelectedSource { get; init; }
+    public bool RotationMatchesSelectedSource { get; init; }
+    public bool ScaleMatchesSelectedSource { get; init; }
+    public AnimationTransformTrackEvidence? SourceReferenceAnalysis { get; init; }
+    public AnimationTransformTrackSummary? Output { get; init; }
+}
+
+public sealed class AnimationTransformTrackSummary
+{
+    public int SampleCount { get; init; }
+    public bool TranslationChanges { get; init; }
+    public bool RotationChanges { get; init; }
+    public bool ScaleChanges { get; init; }
+    public float TranslationRangeMagnitude { get; init; }
+    public float RotationRangeDegrees { get; init; }
+    public float ScaleRangeMagnitude { get; init; }
+    public AnimationTransform? FirstSample { get; init; }
+    public AnimationTransform? LastSample { get; init; }
+}
+
+public sealed class AnimationTransformDifferenceEvidence
+{
+    public float MaximumTranslationDifference { get; init; }
+    public float MaximumRotationDifferenceDegrees { get; init; }
+    public float MaximumScaleDifference { get; init; }
+}
+
+public sealed class AnimationTransformTrackEvidence
+{
+    public string BoneName { get; init; } = string.Empty;
+    public bool SourceTrackPresent { get; init; }
+    public bool ReferenceTrackPresent { get; init; }
+    public AnimationTransformTrackSummary? Source { get; init; }
+    public AnimationTransformTrackSummary? Reference { get; init; }
+    public AnimationTransformDifferenceEvidence? SourceToReference { get; init; }
+}
+
+public static class AnimationTransformComponentMasks
+{
+    public static IReadOnlyList<AnimationTransformComponentMask> Normalize(IEnumerable<AnimationTransformComponentMask>? masks)
+    {
+        var result = new List<AnimationTransformComponentMask>();
+        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var mask in masks ?? Array.Empty<AnimationTransformComponentMask>())
+        {
+            var name = mask.BoneName?.Trim() ?? string.Empty;
+            if (string.IsNullOrWhiteSpace(name))
+                throw new ArgumentException("Every transform component mask requires a bone name.", nameof(masks));
+            var removeCount = new[] { mask.TranslationMode, mask.RotationMode, mask.ScaleMode }
+                .Count(mode => mode == AnimationTransformComponentMode.RemoveTrack);
+            if (removeCount is > 0 and < 3)
+                throw new ArgumentException("REMOVE_TRACK must apply to translation, rotation, and scale together.", nameof(masks));
+            if (!names.Add(name))
+                throw new ArgumentException($"The transform component mask for {name} was specified more than once.", nameof(masks));
+            result.Add(new AnimationTransformComponentMask
+            {
+                BoneName = name,
+                TranslationMode = mask.TranslationMode,
+                RotationMode = mask.RotationMode,
+                ScaleMode = mask.ScaleMode,
+            });
+        }
+        return result.OrderBy(mask => mask.BoneName, StringComparer.OrdinalIgnoreCase).ToArray();
+    }
+}
diff --git a/Dancy/Animation/DalamudVfxEditorPapRebuildGateway.cs b/Dancy/Animation/DalamudVfxEditorPapRebuildGateway.cs
