@@ -0,0 +1,127 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using Dancy.Animation;
+
+namespace Dancy.BoneMasking;
+
+public sealed class BoneMaskPatchCreationRequest
+{
+    public string SourceModDirectory { get; init; } = string.Empty;
+    public string SourceModName { get; init; } = string.Empty;
+    public BoneMaskPatchScopeRequest Scope { get; init; } = new();
+    public IReadOnlyList<string> ExcludedBoneNames { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<AnimationTransformComponentMask> ComponentMasks { get; init; } = Array.Empty<AnimationTransformComponentMask>();
+    public int AnimationIndex { get; init; }
+}
+
+public sealed class BoneMaskPatchCreationResult
+{
+    public InstalledModSourceResolution Source { get; init; } = new();
+    public BoneMaskPatchPlan Plan { get; init; } = new();
+    public BoneMaskPatchRecord? Record { get; init; }
+    public IReadOnlyList<string> Errors { get; init; } = Array.Empty<string>();
+    public bool Succeeded => Record is not null && Errors.Count == 0;
+}
+
+/// <summary>
+/// Runtime composition root for a complete installed-mod operation. All source
+/// inspection is read-only and all generation lands below Dancy's config path.
+/// </summary>
+public sealed class BoneMaskPatchService
+{
+    private readonly Plugin plugin;
+
+    public BoneMaskPatchService(Plugin plugin)
+        => this.plugin = plugin ?? throw new ArgumentNullException(nameof(plugin));
+
+    public string PatchRoot => Path.Combine(Plugin.PluginInterface.ConfigDirectory.FullName, "bone-mask-patches");
+
+    public BoneMaskPatchCreationResult Create(BoneMaskPatchCreationRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        var errors = new List<string>();
+        if (string.IsNullOrWhiteSpace(plugin.Configuration.PenumbraPath))
+            errors.Add("Dancy could not locate Penumbra's mod directory.");
+        if (string.IsNullOrWhiteSpace(request.SourceModDirectory))
+            errors.Add("Select an installed Penumbra source mod.");
+        if (errors.Count > 0)
+            return new BoneMaskPatchCreationResult { Errors = errors };
+
+        var activePaths = new DalamudActiveGamePathResolver();
+        var source = InstalledPenumbraSourceResolver.ResolveMod(
+            plugin.Configuration.PenumbraPath,
+            request.SourceModDirectory,
+            request.SourceModName,
+            activePaths);
+        if (!source.IsValid)
+            return new BoneMaskPatchCreationResult { Source = source, Errors = source.Errors };
+
+        var writer = new VfxEditorIpcAnimationTrackExclusionWriter(new DalamudVfxEditorPapRebuildGateway());
+        VfxEditorPapRebuildCapabilities capabilities;
+        try
+        {
+            capabilities = writer.GetCapabilities();
+        }
+        catch (Exception exception)
+        {
+            return new BoneMaskPatchCreationResult { Source = source, Errors = [$"VFXEditor PAP rebuild IPC is unavailable: {exception.Message}"] };
+        }
+        if (capabilities.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+            || !capabilities.RebuildExistingPapAnimation
+            || !capabilities.RequiresTargetSkeletonPath
+            || !capabilities.SupportsExplicitNamedExclusions
+            || !capabilities.ProvidesTrackNameEvidence
+            || (request.ComponentMasks.Count > 0 && (!capabilities.SupportsComponentTransformMasks || !capabilities.ProvidesComponentTransformEvidence))
+            || capabilities.SupportsInPlaceSourceMutation)
+        {
+            return new BoneMaskPatchCreationResult { Source = source, Errors = ["The loaded VFXEditor does not expose the required safe PAP rebuild capability."] };
+        }
+
+        var plan = BoneMaskPatchPlanner.Create(new BoneMaskPatchPlanRequest
+        {
+            Source = source,
+            Scope = request.Scope,
+            ExcludedBoneNames = request.ExcludedBoneNames,
+            ComponentMasks = request.ComponentMasks,
+            AnimationIndex = request.AnimationIndex,
+            WriterSchemaVersion = VfxEditorPapRebuildProtocol.WriterSchemaVersion,
+            TargetSkeletons = new DalamudTargetSkeletonPathResolver(activePaths, PatchRoot),
+            ReferencePaps = new DalamudVanillaReferencePapPathResolver(PatchRoot),
+        });
+        if (!plan.IsValid)
+            return new BoneMaskPatchCreationResult { Source = source, Plan = plan, Errors = plan.Errors };
+
+        try
+        {
+            var record = BoneMaskPatchGenerator.Generate(PatchRoot, plan, writer);
+            var existing = plugin.Configuration.BoneMaskPatches.FindIndex(item => string.Equals(item.PatchId, record.PatchId, StringComparison.OrdinalIgnoreCase));
+            if (existing >= 0)
+                plugin.Configuration.BoneMaskPatches[existing] = record;
+            else
+                plugin.Configuration.BoneMaskPatches.Add(record);
+            plugin.Configuration.Save();
+            return new BoneMaskPatchCreationResult { Source = source, Plan = plan, Record = record };
+        }
+        catch (Exception exception)
+        {
+            return new BoneMaskPatchCreationResult { Source = source, Plan = plan, Errors = [exception.Message] };
+        }
+    }
+
+    public BoneMaskLivePatchResult Enable(BoneMaskPatchRecord record)
+    {
+        var result = new BoneMaskLivePatchService().Enable(record);
+        if (result.Succeeded)
+            plugin.Configuration.Save();
+        return result;
+    }
+
+    public BoneMaskLivePatchResult Disable(BoneMaskPatchRecord record)
+    {
+        var result = new BoneMaskLivePatchService().Disable(record);
+        if (result.Succeeded)
+            plugin.Configuration.Save();
+        return result;
+    }
+}
