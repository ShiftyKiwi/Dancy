+    internal static string? SmokingBoneMaskEvidenceError(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+    {
+        if (!SmokingIdleFixturePolicy.IsSmokingIdle(patch.SourceModName))
+            return null;
+        var expectedExcluded = BoneMaskNames.Normalize(SmokingIdleFixturePolicy.DefaultExcludedBoneNames);
+        if (!BoneMaskNames.Normalize(patch.ExcludedBoneNames).SequenceEqual(expectedExcluded, StringComparer.OrdinalIgnoreCase))
+            return "Smoking Idle refinement requires exactly the B-F ochinko mask, with iv_ochinko_a retained.";
+
+        foreach (var asset in assets)
+        {
+            var source = new HashSet<string>(asset.SourceTrackNames, StringComparer.OrdinalIgnoreCase);
+            var output = new HashSet<string>(asset.OutputTrackNames, StringComparer.OrdinalIgnoreCase);
+            if (source.Count != asset.SourceTrackCount || output.Count != asset.OutputTrackCount)
+                return "Smoking Idle track-name evidence does not match the reported track counts: " + asset.LogicalGamePath;
+            if (!source.Contains("iv_ochinko_a") || !output.Contains("iv_ochinko_a"))
+                return "Smoking Idle did not retain iv_ochinko_a: " + asset.LogicalGamePath;
+            if (expectedExcluded.Any(name => !source.Contains(name) || output.Contains(name)))
+                return "Smoking Idle did not remove exactly iv_ochinko_b through iv_ochinko_f: " + asset.LogicalGamePath;
+            if (new[] { "iv_kougan_l", "iv_kougan_r" }.Any(name => source.Contains(name) && !output.Contains(name)))
+                return "Smoking Idle removed a retained kougan track: " + asset.LogicalGamePath;
+            var expectedOutput = source.Where(name => !expectedExcluded.Contains(name, StringComparer.OrdinalIgnoreCase))
+                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase);
+            if (!expectedOutput.SequenceEqual(output.OrderBy(name => name, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase))
+                return "Smoking Idle removed an unrelated transform track: " + asset.LogicalGamePath;
+        }
+        return null;
+    }
+
+    private static void ValidateSmokingBoneMaskEvidence(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets, bool throwOnFailure)
+    {
+        var error = SmokingBoneMaskEvidenceError(patch, assets);
+        if (error is not null && throwOnFailure)
+            throw new InvalidOperationException(error);
+    }
