+        IReadOnlyDictionary<string, string> AllRedirects,
+        IReadOnlyDictionary<string, PackageFile> Files,
+        IReadOnlyList<OrderedPackageGroup> Groups,
+        IReadOnlyList<BoneMaskCompanionAssetRecord> AllAssets);
+    internal sealed record PapPackage(
+        IReadOnlyDictionary<string, string> DefaultRedirects,
+        IReadOnlyDictionary<string, string> AllRedirects,
+        IReadOnlyDictionary<string, PackageFile> Files,
+        IReadOnlyList<OrderedPackageGroup> Groups);
+
+    internal static JArray MergeGroups(params IReadOnlyList<OrderedPackageGroup>[] packageGroups)
+        => new(packageGroups.SelectMany(groups => groups)
+            .OrderBy(group => group.SourceGroupOrder)
+            .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase)
+            .Select(group => group.Group));
+}
+
+public static class BoneMaskPmpValidator
+{
+    public static PmpValidationResult Validate(string path, BoneMaskPatchRecord patch)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+        ArgumentNullException.ThrowIfNull(patch);
+        var errors = new List<string>();
+        var papRedirects = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        var companionRedirects = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        var archiveOpened = false;
+        var metadataValid = false;
+        var referencesValid = false;
+        var papValid = false;
+        var evidenceValid = false;
+        var companionsValid = false;
+        var manifestValid = false;
+        var scopeValid = false;
+        try
+        {
+            using var archive = ZipFile.OpenRead(path);
+            archiveOpened = true;
+            var metaEntry = archive.GetEntry("meta.json");
+            if (metaEntry is null)
+            {
+                errors.Add("PMP does not contain meta.json.");
+            }
+            else
+            {
+                JObject metadata;
+                using (var reader = new StreamReader(metaEntry.Open()))
+                    metadata = JObject.Parse(reader.ReadToEnd());
+                metadataValid = (metadata["FileVersion"]?.Value<int?>() ?? 0) == 4
+                                && metadata["DefaultData"]?["Files"] is JObject
+                                && metadata["Groups"] is JArray;
+                if (!metadataValid)
+                {
+                    errors.Add("PMP metadata is not valid FileVersion 4 metadata.");
+                }
+                else
+                {
+                    var expectedPaps = patch.Assets.ToDictionary(asset => GamePathIdentity.Normalize(asset.LogicalGamePath), asset => asset, StringComparer.OrdinalIgnoreCase);
+                    var expectedPapPackage = BoneMaskPmpExporter.BuildPapPackage(patch, patch.Assets);
+                    var expectedCompanionPackage = BoneMaskPmpExporter.BuildCompanionPackage(patch);
+                    var expectedGroups = BoneMaskPmpExporter.MergeGroups(expectedCompanionPackage.Groups, expectedPapPackage.Groups);
+                    if (!JToken.DeepEquals(expectedGroups, metadata["Groups"]))
+                    {
+                        metadataValid = false;
+                        errors.Add("PMP option metadata differs from the captured source groups.");
+                    }
+
+                    var defaultFiles = (JObject)metadata["DefaultData"]!["Files"]!;
+                    foreach (var property in defaultFiles.Properties())
+                    {
+                        var pathKey = GamePathIdentity.Normalize(property.Name);
+                        var entryName = property.Value.ToString().Replace('\\', '/');
+                        AddMetadataRedirect(pathKey, entryName, pathKey.EndsWith(".pap", StringComparison.OrdinalIgnoreCase) ? papRedirects : companionRedirects, errors);
+                    }
+                    foreach (var group in (metadata["Groups"] as JArray)!.OfType<JObject>())
+                    {
+                        foreach (var files in BoneMaskPmpExporter.EnumerateGroupFiles(group))
+                        {
+                            foreach (var property in files.Properties())
+                            {
+                                var pathKey = GamePathIdentity.Normalize(property.Name);
+                                var entryName = property.Value.ToString().Replace('\\', '/');
+                                AddMetadataRedirect(pathKey, entryName, pathKey.EndsWith(".pap", StringComparison.OrdinalIgnoreCase) ? papRedirects : companionRedirects, errors);
+                            }
+                        }
+                    }
+
+                    if (!papRedirects.Keys.OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
+                            .SequenceEqual(expectedPaps.Keys.OrderBy(value => value, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase))
+                        errors.Add("PMP PAP redirects do not match the Dancy patch record.");
+
+                    var expectedCompanions = patch.DefaultCompanionAssets.Concat(patch.CompanionGroups.SelectMany(group => group.Assets))
+                        .ToDictionary(asset => GamePathIdentity.Normalize(asset.GamePath), asset => asset, StringComparer.OrdinalIgnoreCase);
+                    if (!companionRedirects.Keys.OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
+                            .SequenceEqual(expectedCompanions.Keys.OrderBy(value => value, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase))
+                        errors.Add("PMP companion redirects do not match the captured source dependencies.");
+
+                    var allRedirects = papRedirects.Concat(companionRedirects).ToArray();
+                    referencesValid = allRedirects.All(pair => archive.GetEntry(pair.Value) is not null);
+                    if (!referencesValid)
+                        errors.Add("PMP contains a redirect to a missing file.");
+                    var referencedFiles = allRedirects.Select(pair => pair.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
+                    var actualFiles = archive.Entries.Where(entry => entry.FullName.StartsWith("files/", StringComparison.OrdinalIgnoreCase))
+                        .Select(entry => entry.FullName).ToHashSet(StringComparer.OrdinalIgnoreCase);
+                    if (!actualFiles.SetEquals(referencedFiles))
+                    {
+                        referencesValid = false;
+                        errors.Add("PMP includes an unreferenced file or omits a referenced file.");
+                    }
+
+                    papValid = ValidatePapFiles(archive, papRedirects, expectedPaps, errors);
+                    companionsValid = ValidateCompanionFiles(archive, companionRedirects, expectedCompanions, patch, errors);
+                    manifestValid = ValidateAssetManifest(archive, expectedPaps, expectedCompanions, errors);
+                }
+            }
+
+            evidenceValid = patch.Assets.All(asset => asset.StructuralValidationPassed && asset.ExpectedTracksRemoved && asset.OutputTrackCount <= asset.SourceTrackCount);
+            if (!evidenceValid)
+                errors.Add("The patch record lacks successful VFXEditor track-removal evidence.");
+            var scopeError = BoneMaskPmpExporter.ScopeError(patch, patch.Assets);
+            scopeValid = scopeError is null;
+            if (scopeError is not null)
+                errors.Add(scopeError);
+            var smokingCompanionError = BoneMaskPmpExporter.SmokingCompanionError(patch);
+            if (smokingCompanionError is not null)
+            {
+                companionsValid = false;
+                errors.Add(smokingCompanionError);
+            }
+            var smokingPapOptionError = BoneMaskPmpExporter.SmokingPapOptionError(patch, patch.Assets);
+            if (smokingPapOptionError is not null)
+            {
+                metadataValid = false;
+                errors.Add(smokingPapOptionError);
+            }
+            var smokingBoneMaskError = BoneMaskPmpExporter.SmokingBoneMaskEvidenceError(patch, patch.Assets);
+            if (smokingBoneMaskError is not null)
+            {
+                evidenceValid = false;
+                errors.Add(smokingBoneMaskError);
+            }
+        }
+        catch (Exception exception)
+        {
+            errors.Add(exception.Message);
+        }
+
+        return new PmpValidationResult
+        {
+            ArchiveOpened = archiveOpened,
+            MetadataValid = metadataValid,
+            ReferencedFilesValid = referencesValid,
+            PapFilesValid = papValid,
+            BoneMaskEvidenceValid = evidenceValid,
+            CompanionAssetsValid = companionsValid,
+            AssetManifestValid = manifestValid,
+            ScopeValid = scopeValid,
+            Redirects = papRedirects,
+            CompanionRedirects = companionRedirects,
+            Errors = errors.Distinct(StringComparer.Ordinal).ToArray(),
+        };
+    }
+
+    private static bool ValidatePapFiles(
+        ZipArchive archive,
+        IReadOnlyDictionary<string, string> redirects,
+        IReadOnlyDictionary<string, BoneMaskPatchAssetRecord> expected,
+        ICollection<string> errors)
+    {
+        var valid = redirects.Count > 0;
+        foreach (var (gamePath, entryName) in redirects)
+        {
+            if (!expected.TryGetValue(gamePath, out var asset) || archive.GetEntry(entryName) is not { } entry)
+            {
+                valid = false;
+                continue;
+            }
+            var temporary = Path.Combine(Path.GetTempPath(), "dancy-pmp-" + Guid.NewGuid().ToString("N") + ".pap");
+            try
+            {
+                using (var input = entry.Open())
+                using (var output = File.Create(temporary))
+                    input.CopyTo(output);
+                _ = PapFileInspector.InspectFile(temporary);
+                using var stream = entry.Open();
+                var hash = Convert.ToHexString(SHA256.HashData(stream));
+                if (!string.Equals(hash, asset.OutputPapSha256, StringComparison.OrdinalIgnoreCase))
+                {
+                    valid = false;
+                    errors.Add("PMP PAP content hash differs from the Dancy-owned live patch asset: " + gamePath);
+                }
+            }
+            catch (Exception exception)
+            {
+                valid = false;
+                errors.Add("PMP PAP did not parse: " + exception.Message);
+            }
+            finally
+            {
+                if (File.Exists(temporary))
+                    File.Delete(temporary);
+            }
+        }
+        if (!valid && redirects.Count == 0)
+            errors.Add("PMP contains no derived PAP files.");
+        return valid;
+    }
+
+    private static void AddMetadataRedirect(string gamePath, string entryName, IDictionary<string, string> redirects, ICollection<string> errors)
+    {
+        if (redirects.TryGetValue(gamePath, out var existing) && !string.Equals(existing, entryName, StringComparison.OrdinalIgnoreCase))
+            errors.Add("PMP metadata maps one game path to multiple files: " + gamePath);
+        else
+            redirects[gamePath] = entryName;
+    }
+
+    private static bool ValidateCompanionFiles(
+        ZipArchive archive,
+        IReadOnlyDictionary<string, string> redirects,
+        IReadOnlyDictionary<string, BoneMaskCompanionAssetRecord> expected,
+        BoneMaskPatchRecord patch,
+        ICollection<string> errors)
+    {
+        if (!patch.CompanionAssetsCaptured)
+        {
+            errors.Add("PMP patch record predates companion-asset capture.");
+            return false;
+        }
+        var valid = true;
+        foreach (var (gamePath, asset) in expected)
+        {
+            if (!redirects.TryGetValue(gamePath, out var entryName) || archive.GetEntry(entryName) is not { } entry)
+            {
+                valid = false;
+                errors.Add("PMP companion redirect is missing: " + gamePath);
+                continue;
+            }
+            using var stream = entry.Open();
+            var hash = Convert.ToHexString(SHA256.HashData(stream));
+            if (!string.Equals(hash, asset.SourceSha256, StringComparison.OrdinalIgnoreCase))
+            {
+                valid = false;
+                errors.Add("PMP copied companion hash differs from source: " + gamePath);
+            }
+        }
+        return valid;
+    }
+
+    private static bool ValidateAssetManifest(
+        ZipArchive archive,
+        IReadOnlyDictionary<string, BoneMaskPatchAssetRecord> expectedPaps,
+        IReadOnlyDictionary<string, BoneMaskCompanionAssetRecord> expectedCompanions,
+        ICollection<string> errors)
+    {
+        var entry = archive.GetEntry("dancy-asset-manifest.json");
+        if (entry is null)
+        {
+            errors.Add("PMP does not contain Dancy's asset dependency manifest.");
+            return false;
+        }
+        try
+        {
+            JObject manifest;
+            using (var reader = new StreamReader(entry.Open()))
+                manifest = JObject.Parse(reader.ReadToEnd());
+            if ((manifest["SchemaVersion"]?.Value<int?>() ?? 0) != 1 || manifest["Assets"] is not JArray items)
+            {
+                errors.Add("PMP asset dependency manifest is malformed.");
+                return false;
+            }
+            var papItems = items.OfType<JObject>().Where(item => string.Equals(item["Treatment"]?.ToString(), "TRANSFORMED", StringComparison.Ordinal)).ToArray();
+            var companionItems = items.OfType<JObject>().Where(item => string.Equals(item["Treatment"]?.ToString(), "COPIED_UNCHANGED", StringComparison.Ordinal)).ToArray();
+            var papPaths = papItems.Select(item => GamePathIdentity.Normalize(item["Asset"]?.ToString() ?? string.Empty)).ToArray();
+            var companionPaths = companionItems.Select(item => GamePathIdentity.Normalize(item["Asset"]?.ToString() ?? string.Empty)).ToArray();
+            var valid = papPaths.OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
+                            .SequenceEqual(expectedPaps.Keys.OrderBy(path => path, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase)
+                        && companionPaths.OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
+                            .SequenceEqual(expectedCompanions.Keys.OrderBy(path => path, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase)
+                        && !items.OfType<JObject>().Any(item => item["SourcePhysicalPath"] is not null);
+            if (!valid)
+                errors.Add("PMP asset dependency manifest does not match the exported PAP and companion set.");
+            return valid;
+        }
+        catch (Exception exception)
+        {
+            errors.Add("PMP asset dependency manifest could not be parsed: " + exception.Message);
+            return false;
+        }
+    }
+}
diff --git a/Dancy/BoneMasking/CompanionAssetResolver.cs b/Dancy/BoneMasking/CompanionAssetResolver.cs
new file mode 100644
index 0000000..3656a5c
--- /dev/null
+++ b/Dancy/BoneMasking/CompanionAssetResolver.cs
@@ -0,0 +1,204 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using Dancy.Domain;
+using Dancy.Persistence;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace Dancy.BoneMasking;
+
+/// <summary>
+/// Captures source assets that are not PAPs but live in their own FileVersion 4
+/// option groups. Keeping the complete group preserves its original selection
+/// semantics while the source binaries stay read-only.
+/// </summary>
+public static class CompanionAssetResolver
+{
+    public static CompanionAssetResolution Resolve(JObject metadata, string modFolder)
+    {
+        ArgumentNullException.ThrowIfNull(metadata);
+        ArgumentException.ThrowIfNullOrWhiteSpace(modFolder);
+
+        var warnings = new List<string>();
+        var defaults = Materialize(
+            EnumerateFiles(metadata["DefaultData"]?["Files"] as JObject, "(default)", "(default)"),
+            modFolder,
+            warnings,
+            "default data");
+        var groups = new List<BoneMaskCompanionGroupRecord>();
+
+        foreach (var (group, groupOrder) in ((metadata["Groups"] as JArray)?.OfType<JObject>() ?? []).Select((value, index) => (value, index)))
+        {
+            var groupName = group["Name"]?.ToString() ?? "Group";
+            var mappings = EnumerateGroupFiles(group, groupName).ToArray();
+            if (mappings.Length == 0)
+                continue;
+
+            var papMappings = mappings.Where(IsPapMapping).ToArray();
+            var companionMappings = mappings.Where(mapping => !IsPapMapping(mapping)).ToArray();
+            if (companionMappings.Length == 0)
+                continue;
+
+            // A mixed PAP/non-PAP option group cannot be reproduced without
+            // changing its selection bits. Refuse partial preservation rather
+            // than silently packaging a semantically different group.
+            if (papMappings.Length > 0)
+            {
+                warnings.Add($"Skipped mixed PAP/companion group {groupName}; it requires an explicit dependency rule.");
+                continue;
+            }
+
+            var groupWarnings = new List<string>();
+            var assets = Materialize(companionMappings, modFolder, groupWarnings, $"group {groupName}");
+            if (groupWarnings.Count > 0 || assets.Count != companionMappings.Length)
+            {
+                warnings.AddRange(groupWarnings);
+                warnings.Add($"Skipped companion group {groupName} because it could not be captured completely.");
+                continue;
+            }
+
+            groups.Add(new BoneMaskCompanionGroupRecord
+            {
+                Name = groupName,
+                SourceGroupOrder = groupOrder,
+                SourceGroupMetadataJson = group.ToString(Formatting.None),
+                Assets = assets.OrderBy(asset => asset.GamePath, StringComparer.OrdinalIgnoreCase).ToList(),
+            });
+        }
+
+        return new CompanionAssetResolution
+        {
+            DefaultAssets = defaults.OrderBy(asset => asset.GamePath, StringComparer.OrdinalIgnoreCase).ToArray(),
+            Groups = groups.OrderBy(group => group.SourceGroupOrder).ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase).ToArray(),
+            Warnings = warnings.Distinct(StringComparer.Ordinal).ToArray(),
+        };
+    }
+
+    private static IReadOnlyList<BoneMaskCompanionAssetRecord> Materialize(
+        IEnumerable<SourceFileMapping> mappings,
+        string modFolder,
+        ICollection<string> warnings,
+        string context)
+    {
+        var assets = new List<BoneMaskCompanionAssetRecord>();
+        foreach (var mapping in mappings)
+        {
+            if (!PathSafety.TryResolveInsideRoot(modFolder, mapping.ModPath, out var physicalPath) || !File.Exists(physicalPath))
+            {
+                warnings.Add($"Skipped missing or unsafe companion mapping {mapping.GamePath} in {context}.");
+                continue;
+            }
+
+            assets.Add(new BoneMaskCompanionAssetRecord
+            {
+                SourceGroupName = mapping.GroupName,
+                SourceOptionName = mapping.OptionName,
+                GamePath = GamePathIdentity.Normalize(mapping.GamePath),
+                SourceRelativePath = mapping.ModPath.Replace('\\', '/'),
+                SourcePhysicalPath = Path.GetFullPath(physicalPath),
+                SourceSha256 = HashFile(physicalPath),
+                AssetType = Classify(mapping.GamePath, mapping.ModPath),
+            });
+        }
+        return assets;
+    }
+
+    private static IEnumerable<SourceFileMapping> EnumerateGroupFiles(JObject group, string groupName)
+    {
+        if (group["Options"] is JArray options)
+        {
+            foreach (var option in options.OfType<JObject>())
+            {
+                var optionName = option["Name"]?.ToString() ?? "Option";
+                foreach (var mapping in EnumerateFiles(option["Files"] as JObject, groupName, optionName))
+                    yield return mapping;
+            }
+        }
+
+        if (group["Containers"] is not JArray containers)
+            yield break;
+
+        foreach (var (container, index) in containers.OfType<JObject>().Select((value, index) => (value, index)))
+        {
+            var optionName = container["Name"]?.ToString();
+            foreach (var mapping in EnumerateFiles(container["Files"] as JObject, groupName, string.IsNullOrWhiteSpace(optionName) ? $"Container {index + 1}" : optionName))
+                yield return mapping;
+        }
+    }
+
+    private static IEnumerable<SourceFileMapping> EnumerateFiles(JObject? files, string groupName, string optionName)
+    {
+        if (files is null)
+            yield break;
+        foreach (var property in files.Properties())
+            yield return new SourceFileMapping(groupName, optionName, property.Name, property.Value.ToString());
+    }
+
+    private static bool IsPapMapping(SourceFileMapping mapping)
+        => mapping.GamePath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase)
+           || mapping.ModPath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase);
+
+    private static string Classify(string gamePath, string sourcePath)
+    {
+        var extension = Path.GetExtension(gamePath);
+        if (string.IsNullOrEmpty(extension))
+            extension = Path.GetExtension(sourcePath);
+        return extension.ToLowerInvariant() switch
+        {
+            ".tmb" => "TMB",
+            ".avfx" => "VFX",
+            ".atex" => "VFX_TEXTURE",
+            _ => "OTHER_COMPANION",
+        };
+    }
+
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+
+    private sealed record SourceFileMapping(string GroupName, string OptionName, string GamePath, string ModPath);
+}
+
+/// <summary>
+/// Captures source PAP-only groups independently of the currently active
+/// setting. The planner later filters their option mappings to the selected
+/// Dancy outputs, so inactive and excluded source options never leak into a
+/// standalone package.
+/// </summary>
+public static class PapOptionGroupResolver
+{
+    public static IReadOnlyList<BoneMaskPapOptionGroupRecord> Resolve(JObject metadata)
+    {
+        ArgumentNullException.ThrowIfNull(metadata);
+        return ((metadata["Groups"] as JArray)?.OfType<JObject>() ?? [])
+            .Select((group, order) => (group, order))
+            .Where(item => IsPapOnly(item.group))
+            .Select(item => new BoneMaskPapOptionGroupRecord
+            {
+                Name = item.group["Name"]?.ToString() ?? "Group",
+                SourceGroupOrder = item.order,
+                SourceGroupMetadataJson = item.group.ToString(Formatting.None),
+            })
+            .OrderBy(group => group.SourceGroupOrder)
+            .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase)
+            .ToArray();
+    }
+
+    private static bool IsPapOnly(JObject group)
+    {
+        var mappings = BoneMaskPmpExporter.EnumerateGroupFiles(group)
+            .SelectMany(files => files.Properties())
+            .ToArray();
+        return mappings.Length > 0
+               && mappings.All(mapping => mapping.Name.EndsWith(".pap", StringComparison.OrdinalIgnoreCase)
+                                          || mapping.Value.ToString().EndsWith(".pap", StringComparison.OrdinalIgnoreCase));
+    }
+}
+
+public sealed class CompanionAssetResolution
+{
+    public IReadOnlyList<BoneMaskCompanionAssetRecord> DefaultAssets { get; init; } = Array.Empty<BoneMaskCompanionAssetRecord>();
+    public IReadOnlyList<BoneMaskCompanionGroupRecord> Groups { get; init; } = Array.Empty<BoneMaskCompanionGroupRecord>();
+    public IReadOnlyList<string> Warnings { get; init; } = Array.Empty<string>();
+}
