+            MotionIdentity = "havok:0", TargetSkeletonIdentity = "fixture", WriterSchemaVersion = VfxEditorPapRebuildProtocol.WriterSchemaVersion,
+            ExcludedBoneNames = SmokingIdleFixturePolicy.DefaultExcludedBoneNames, ComponentMasks = [componentMask],
