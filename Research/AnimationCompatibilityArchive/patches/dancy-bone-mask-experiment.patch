+    private static void AddRedirects(IDictionary<string, string> destination, IEnumerable<KeyValuePair<string, string>> mappings, string context)
+    {
+        foreach (var pair in mappings)
+            AddRedirect(destination, pair.Key, pair.Value, context);
+    }
+
+    private static void AddRedirect(IDictionary<string, string> destination, string gamePath, string entryName, string context)
+    {
+        var normalized = GamePathIdentity.Normalize(gamePath);
+        if (destination.TryGetValue(normalized, out var existing) && !string.Equals(existing, entryName, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidOperationException($"Duplicate game-path redirect in {context}: {gamePath}");
+        destination[normalized] = entryName;
+    }
+
+    private static void WriteText(ZipArchive archive, string entryName, string value)
+    {
+        var entry = archive.CreateEntry(entryName, CompressionLevel.Optimal);
+        entry.LastWriteTime = ArchiveTimestamp;
+        using var writer = new StreamWriter(entry.Open(), new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+        writer.Write(value.Replace("\r\n", "\n", StringComparison.Ordinal));
+    }
+
+    private static void WriteFile(ZipArchive archive, string entryName, string path)
+    {
+        var entry = archive.CreateEntry(entryName, CompressionLevel.Optimal);
+        entry.LastWriteTime = ArchiveTimestamp;
+        using var input = File.OpenRead(path);
+        using var output = entry.Open();
+        input.CopyTo(output);
+    }
+
+    private static Guid DeterministicGuid(string value) => new(SHA256.HashData(Encoding.UTF8.GetBytes(value))[..16]);
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
