+        var sourceTracks = SmokingSourceTrackNames();
+        var outputTracks = sourceTracks.Where(name => !SmokingIdleFixturePolicy.DefaultExcludedBoneNames.Contains(name, StringComparer.OrdinalIgnoreCase)).ToArray();
+        var tmb = WriteCompanion(root, "idle.tmb", "tmb");
+        var avfx = WriteCompanion(root, "smoke.avfx", "avfx");
+        var atex = WriteCompanion(root, "smoke.atex", "atex");
+        return new BoneMaskPatchRecord
+        {
+            PatchId = "22222222-2222-2222-2222-222222222222", SourceModDirectory = "fixture", SourceModName = "[Noff] Smoking Idle [Idle0]",
+            WriterSchemaVersion = "vfxeditor-ipc/1.0", Scope = BoneMaskPatchScope.MaleModelsSupportedOnly,
+            ExcludedBoneNames = SmokingIdleFixturePolicy.DefaultExcludedBoneNames.ToList(), ExplicitlyExcludedCharacterCodes = ["c1101"],
+            CompanionAssetsCaptured = true,
+            PapOptionGroupsCaptured = true,
+            PapOptionGroups =
+            [
+                new BoneMaskPapOptionGroupRecord
+                {
+                    Name = "M options",
+                    SourceGroupOrder = 1,
+                    SourceGroupMetadataJson = CreateMaleOptionGroup().ToString(Newtonsoft.Json.Formatting.None),
+                },
+            ],
+            CompanionGroups =
+            [
