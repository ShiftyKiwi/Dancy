index 0000000..a840278
--- /dev/null
+++ b/Dancy/Diagnostics/DancyBoneMaskLiveSelfTestRunner.cs
@@ -0,0 +1,368 @@
+#if DEBUG
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using Dancy.Animation;
+using Dancy.BoneMasking;
+using Dancy.Domain;
+using Dancy.Penumbra;
+using Dancy.Persistence;
+using Newtonsoft.Json.Linq;
+using Penumbra.Api.IpcSubscribers;
+
+namespace Dancy.Diagnostics;
+
+/// <summary>
+/// Exercises the production VFXEditor IPC writer against the active Smoking
+/// fixture without touching the installed source. Any temporary player redirect
+/// is removed in a finally path; generated files live only in Dancy config.
+/// </summary>
+internal sealed class DancyBoneMaskLiveSelfTestRunner
+{
+    private const string SourceFallbackTag = "Dancy.BoneMask.SelfTest.Source";
+    private const int SourceFallbackPriority = 8999;
+
+    public DancySelfTestResult Run(Plugin plugin)
+    {
+        var started = DateTimeOffset.UtcNow;
+        var cases = new List<DancySelfTestCase>();
+        BoneMaskPatchRecord? patch = null;
+        BoneMaskPatchRecord? aToFExportPatch = null;
+        BoneMaskPatchRecord? maleExportPatch = null;
+        InstalledModSourceResolution? source = null;
+        string? sourceMetaPath = null;
+        string? metaBefore = null;
+        Dictionary<string, string>? sourceHashes = null;
+        Guid sourceFallbackCollection = Guid.Empty;
+        var sourceFallbackActive = false;
+
+        RunCase(cases, "VFXEditor public capability", "capability", "The public VFXEditor PAP rebuild endpoint is available.", () =>
+        {
+            var capabilities = new VfxEditorIpcAnimationTrackExclusionWriter(new DalamudVfxEditorPapRebuildGateway()).GetCapabilities();
+            if (capabilities.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+                || !capabilities.RebuildExistingPapAnimation
+                || !capabilities.RequiresTargetSkeletonPath
+                || !capabilities.SupportsExplicitNamedExclusions
+                || !capabilities.ProvidesTrackNameEvidence
+                || capabilities.SupportsInPlaceSourceMutation)
+            {
+                throw new InvalidOperationException("Loaded VFXEditor does not provide Dancy's required safe rebuild capability.");
+            }
+            return $"VFXEditor {capabilities.VfxEditorVersion} public IPC is ready.";
+        });
+
+        RunCase(cases, "Smoking source resolution", "source", "The active Smoking Idle c0701 PAP resolves through Penumbra.", () =>
+        {
+            var mods = new GetModList(Plugin.PluginInterface).Invoke();
+            var mod = mods
+                .Where(pair => SmokingIdleFixturePolicy.IsSmokingIdle(pair.Value)
+                               && !pair.Value.StartsWith("Dancy Bone Mask -", StringComparison.OrdinalIgnoreCase))
+                .OrderBy(pair => pair.Value, StringComparer.OrdinalIgnoreCase)
+                .FirstOrDefault();
+            if (string.IsNullOrWhiteSpace(mod.Key))
+                throw new InvalidOperationException("No original installed Smoking Idle fixture was found.");
+            source = InstalledPenumbraSourceResolver.ResolveMod(plugin.Configuration.PenumbraPath, mod.Key, mod.Value, new DalamudActiveGamePathResolver());
+            var fallbackMessage = string.Empty;
+            if (!source.IsValid)
+            {
+                sourceFallbackCollection = ApplySourceFallback(plugin, mod.Key);
+                sourceFallbackActive = true;
+                source = InstalledPenumbraSourceResolver.ResolveMod(plugin.Configuration.PenumbraPath, mod.Key, mod.Value, new DalamudActiveGamePathResolver());
+                fallbackMessage = " A temporary c0701 source route was used because the installed mod was not active.";
+            }
+            if (!source.IsValid)
+                throw new InvalidOperationException(string.Join(" ", source.Errors));
+            var c0701 = source.ActiveMappings.SingleOrDefault(mapping => string.Equals(mapping.Character.Code, "c0701", StringComparison.OrdinalIgnoreCase));
+            if (c0701 is null)
+                throw new InvalidOperationException("Smoking Idle c0701 is not active for the player collection.");
+            if (!PathSafety.TryResolveInsideRoot(plugin.Configuration.PenumbraPath, mod.Key, out var folder))
+                throw new InvalidOperationException("Dancy refused the Smoking source directory.");
+            sourceMetaPath = Path.Combine(folder, "meta.json");
+            metaBefore = HashFile(sourceMetaPath);
+            sourceHashes = source.ActiveMappings
+                .Select(mapping => (Path: mapping.SourcePhysicalPapPath, Hash: mapping.SourcePapSha256))
+                .Concat(source.DefaultCompanionAssets.Concat(source.CompanionGroups.SelectMany(group => group.Assets))
+                    .Select(asset => (Path: asset.SourcePhysicalPath, Hash: asset.SourceSha256)))
+                .GroupBy(sourceAsset => sourceAsset.Path, StringComparer.OrdinalIgnoreCase)
+                .ToDictionary(group => group.Key, group => HashFile(group.Key), StringComparer.OrdinalIgnoreCase);
+            var shared = source.PhysicalSourceGroups.SingleOrDefault(group => string.Equals(group.SourcePhysicalPapPath, c0701.SourcePhysicalPapPath, StringComparison.OrdinalIgnoreCase));
+            return $"c0701 source: {c0701.SourcePhysicalPapPath}; shared by {shared?.LogicalGamePaths.Count ?? 1} logical path(s).{fallbackMessage}";
+        });
+
+        if (source is not null)
+        {
+            RunCase(cases, "Dancy-owned bone-mask generation", "generation", "One c0701 derivative is created under Dancy config with five named B-F exclusions and track evidence.", () =>
+            {
+                var result = plugin.BoneMaskPatches.Create(new BoneMaskPatchCreationRequest
+                {
+                    SourceModDirectory = source.SourceModDirectory,
+                    SourceModName = source.SourceModName,
+                    AnimationIndex = 0,
+                    ExcludedBoneNames = SmokingIdleFixturePolicy.DefaultExcludedBoneNames,
+                    Scope = new BoneMaskPatchScopeRequest
+                    {
+                        Scope = BoneMaskPatchScope.SelectedPaths,
+                        SelectedGamePaths = source.ActiveMappings
+                            .Where(mapping => string.Equals(mapping.Character.Code, "c0701", StringComparison.OrdinalIgnoreCase))
+                            .Select(mapping => mapping.LogicalGamePath)
+                            .ToArray(),
+                    },
+                });
+                if (!result.Succeeded)
+                    throw new InvalidOperationException(string.Join(" ", result.Errors));
+                patch = result.Record!;
+                var asset = AssertSingle(patch.Assets);
+                if (!HasSmokingTrackEvidence(asset, SmokingIdleFixturePolicy.DefaultExcludedBoneNames))
+                    throw new InvalidOperationException("VFXEditor did not return successful track-removal evidence.");
+                if (!File.Exists(asset.OutputPapPath))
+                    throw new InvalidOperationException("Dancy output PAP is missing.");
+                return $"{asset.SourceTrackCount} -> {asset.OutputTrackCount} tracks; {asset.OutputPapPath}";
+            });
+
+            if (patch is not null)
+            {
+                RunCase(cases, "Temporary live redirect", "live", "Only c0701 resolves to the Dancy PAP while a shared non-selected consumer remains original.", () =>
+                {
+                    var enabled = plugin.BoneMaskPatches.Enable(patch);
+                    if (!enabled.Succeeded)
+                        throw new InvalidOperationException(enabled.Message);
+                    var asset = AssertSingle(patch.Assets);
+                    var resolver = new DalamudActiveGamePathResolver();
+                    var actual = resolver.ResolveForPlayer(asset.LogicalGamePath);
+                    if (!EquivalentPath(asset.OutputPapPath, actual))
+                        throw new InvalidOperationException($"c0701 resolved to {actual}, expected Dancy output {asset.OutputPapPath}.");
+                    var sourceC0701 = source.ActiveMappings.Single(mapping => string.Equals(mapping.Character.Code, "c0701", StringComparison.OrdinalIgnoreCase));
+                    var peer = source.ActiveMappings.FirstOrDefault(mapping => !string.Equals(mapping.LogicalGamePath, sourceC0701.LogicalGamePath, StringComparison.OrdinalIgnoreCase)
+                                                                            && string.Equals(mapping.SourcePhysicalPapPath, sourceC0701.SourcePhysicalPapPath, StringComparison.OrdinalIgnoreCase));
+                    if (peer is not null)
+                    {
+                        var peerActual = resolver.ResolveForPlayer(peer.LogicalGamePath);
+                        if (!EquivalentPath(peer.SourcePhysicalPapPath, peerActual))
+                            throw new InvalidOperationException($"Non-selected shared path {peer.LogicalGamePath} changed unexpectedly.");
+                    }
+                    return peer is null ? "c0701 Dancy redirect verified." : $"c0701 redirected; shared peer {peer.LogicalGamePath} remained original.";
+                });
+
+                RunCase(cases, "A-F control baseline", "control", "The prior A-F mask is generated only in Dancy-owned storage for all eight retained male paths.", () =>
+                {
+                    var disabled = plugin.BoneMaskPatches.Disable(patch);
+                    if (!disabled.Succeeded)
+                        throw new InvalidOperationException(disabled.Message);
+                    var controlResult = plugin.BoneMaskPatches.Create(new BoneMaskPatchCreationRequest
+                    {
+                        SourceModDirectory = source.SourceModDirectory,
+                        SourceModName = source.SourceModName,
+                        AnimationIndex = 0,
+                        ExcludedBoneNames = SmokingIdleFixturePolicy.PreviousExcludedBoneNames,
+                        Scope = new BoneMaskPatchScopeRequest
+                        {
+                            Scope = BoneMaskPatchScope.MaleModelsSupportedOnly,
+                            ExplicitlyExcludedCharacterCodes = SmokingIdleFixturePolicy.ExplicitlyExcludedCharacterCodes,
+                        },
+                    });
+                    if (!controlResult.Succeeded)
+                        throw new InvalidOperationException(string.Join(" ", controlResult.Errors));
+                    aToFExportPatch = controlResult.Record!;
+                    if (aToFExportPatch.Assets.Any(asset => !HasSmokingTrackEvidence(asset, SmokingIdleFixturePolicy.PreviousExcludedBoneNames)))
+                        throw new InvalidOperationException("One or more control PAPs lacks exact A-F track evidence.");
+                    return string.Join(", ", aToFExportPatch.Assets.OrderBy(asset => asset.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+                        .Select(asset => $"{Dancy.Domain.CharacterPathIdentity.FromGamePath(asset.LogicalGamePath).Code}:{asset.SourceTrackCount}->{asset.OutputTrackCount}"));
+                });
+
+                RunCase(cases, "Male-only standalone PMP", "export", "The Smoking fixture exports eight supported male PAP routes plus the VFX and TMB companion group.", () =>
+                {
+                    // Re-resolve against the original temporary source route,
+                    // never against this test's higher-priority Dancy output.
+                    var maleResult = plugin.BoneMaskPatches.Create(new BoneMaskPatchCreationRequest
+                    {
+                        SourceModDirectory = source.SourceModDirectory,
+                        SourceModName = source.SourceModName,
+                        AnimationIndex = 0,
+                        ExcludedBoneNames = SmokingIdleFixturePolicy.DefaultExcludedBoneNames,
+                        Scope = new BoneMaskPatchScopeRequest
+                        {
+                            Scope = BoneMaskPatchScope.MaleModelsSupportedOnly,
+                            ExplicitlyExcludedCharacterCodes = SmokingIdleFixturePolicy.ExplicitlyExcludedCharacterCodes,
+                        },
+                    });
+                    if (!maleResult.Succeeded)
+                        throw new InvalidOperationException(string.Join(" ", maleResult.Errors));
+                    maleExportPatch = maleResult.Record!;
+                    var actualCodes = maleExportPatch.Assets.Select(asset => Dancy.Domain.CharacterPathIdentity.FromGamePath(asset.LogicalGamePath).Code)
+                        .OrderBy(code => code, StringComparer.OrdinalIgnoreCase).ToArray();
+                    var expectedCodes = SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.OrderBy(code => code, StringComparer.OrdinalIgnoreCase).ToArray();
+                    if (!actualCodes.SequenceEqual(expectedCodes, StringComparer.OrdinalIgnoreCase))
+                        throw new InvalidOperationException("Male-only plan did not contain exactly the expected Smoking character paths.");
+                    var outputDirectory = Path.Combine(plugin.BoneMaskPatches.PatchRoot, "self-test-exports");
+                    Directory.CreateDirectory(outputDirectory);
+                    var output = Path.Combine(outputDirectory, maleExportPatch.PatchId + ".pmp");
+                    var export = BoneMaskPmpExporter.Export(new BoneMaskPmpExportRequest { Patch = maleExportPatch, OutputPath = output });
+                    if (!export.Validation.IsValid)
+                        throw new InvalidOperationException(string.Join(" ", export.Validation.Errors));
+                    if (maleExportPatch.Assets.Any(asset => !HasSmokingTrackEvidence(asset, SmokingIdleFixturePolicy.DefaultExcludedBoneNames)))
+                        throw new InvalidOperationException("One or more male PAPs lacks B-F track evidence.");
+                    if (aToFExportPatch is null)
+                        throw new InvalidOperationException("The A-F control baseline was not generated.");
+                    var controlByPath = aToFExportPatch.Assets.ToDictionary(asset => asset.LogicalGamePath, StringComparer.OrdinalIgnoreCase);
+                    foreach (var asset in maleExportPatch.Assets)
+                    {
+                        if (!controlByPath.TryGetValue(asset.LogicalGamePath, out var control)
+                            || control.SourceTrackCount != asset.SourceTrackCount
+                            || control.OutputTrackCount + 1 != asset.OutputTrackCount)
+                        {
+                            throw new InvalidOperationException("The B-F result did not restore exactly iv_ochinko_a relative to the A-F control: " + asset.LogicalGamePath);
+                        }
+                    }
+                    if (export.Redirects.Count != SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.Count
+                        || export.Redirects.Keys.Any(path => path.Contains("/c1101/", StringComparison.OrdinalIgnoreCase)
+                                                           || string.Equals(Dancy.Domain.CharacterPathIdentity.FromGamePath(path).Sex, "Female", StringComparison.OrdinalIgnoreCase)))
+                    {
+                        throw new InvalidOperationException("Male-only PMP included an unsupported path.");
+                    }
+                    var companions = maleExportPatch.DefaultCompanionAssets.Concat(maleExportPatch.CompanionGroups.SelectMany(group => group.Assets)).ToArray();
+                    var expectedCompanionPaths = companions.Select(asset => GamePathIdentity.Normalize(asset.GamePath))
+                        .OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray();
+                    var actualCompanionPaths = export.CompanionRedirects.Keys.OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray();
+                    if (!export.Validation.CompanionAssetsValid
+                        || !maleExportPatch.CompanionAssetsCaptured
+                        || companions.Count(asset => string.Equals(asset.AssetType, "TMB", StringComparison.OrdinalIgnoreCase)) != 1
+                        || companions.Count(asset => string.Equals(asset.AssetType, "VFX", StringComparison.OrdinalIgnoreCase)) != 4
+                        || companions.Count(asset => string.Equals(asset.AssetType, "VFX_TEXTURE", StringComparison.OrdinalIgnoreCase)) != 4
+                        || !expectedCompanionPaths.SequenceEqual(actualCompanionPaths, StringComparer.OrdinalIgnoreCase))
+                    {
+                        throw new InvalidOperationException("Standalone PMP did not preserve the Smoking TMB/VFX companion asset set.");
+                    }
+                    return $"{export.Redirects.Count} PAP redirects, {export.PhysicalPapCount} PAP file(s), {export.CompanionRedirects.Count} copied companion redirects, B-F track evidence verified, {export.Sha256}.";
+                });
+            }
+        }
+
+        if (patch is not null)
+        {
+            RunCase(cases, "Temporary redirect cleanup", "cleanup", "The Dancy c0701 redirect is removed and the original source resolves again.", () =>
+            {
+                var disabled = plugin.BoneMaskPatches.Disable(patch);
+                if (!disabled.Succeeded)
+                    throw new InvalidOperationException(disabled.Message);
+                var asset = AssertSingle(patch.Assets);
+                var actual = new DalamudActiveGamePathResolver().ResolveForPlayer(asset.LogicalGamePath);
+                if (!EquivalentPath(asset.SourcePhysicalPapPath, actual))
+                    throw new InvalidOperationException($"c0701 did not return to its original source: {actual}.");
+                return "Temporary Dancy redirect removed.";
+            });
+        }
+
+        if (sourceFallbackActive)
+        {
+            RunCase(cases, "Temporary source-route cleanup", "cleanup", "The test-only source route is removed from the player collection.", () =>
+            {
+                var result = DalamudFrameworkInvocation.Invoke(() => new RemoveTemporaryMod(Plugin.PluginInterface)
+                    .Invoke(SourceFallbackTag, sourceFallbackCollection, SourceFallbackPriority)
+                    .ToString());
+                if (result is not "Success" and not "NothingDone")
+                    throw new InvalidOperationException("Penumbra did not remove the test source route: " + result);
+                return "Test-only source route removed.";
+            });
+        }
+
+        RunCase(cases, "Original source integrity", "integrity", "Source metadata, PAPs, and captured companion asset hashes are unchanged.", () =>
+        {
+            if (sourceMetaPath is null || metaBefore is null || sourceHashes is null)
+                throw new InvalidOperationException("Smoking source was not resolved.");
+            if (!string.Equals(metaBefore, HashFile(sourceMetaPath), StringComparison.OrdinalIgnoreCase))
+                throw new InvalidOperationException("Smoking source meta.json changed during the self-test.");
+            foreach (var pair in sourceHashes)
+            {
+                if (!string.Equals(pair.Value, HashFile(pair.Key), StringComparison.OrdinalIgnoreCase))
+                    throw new InvalidOperationException("Smoking source asset changed during the self-test: " + pair.Key);
+            }
+            return "Source meta.json, PAPs, and companion asset hashes are unchanged.";
+        });
+
+        return new DancySelfTestResult
+        {
+            StartedAtUtc = started,
+            CompletedAtUtc = DateTimeOffset.UtcNow,
+            Cases = cases,
+            RetainedArtifacts = new[] { patch, aToFExportPatch, maleExportPatch }
+                .Where(record => record is not null)
+                .Select(record => Path.Combine(plugin.BoneMaskPatches.PatchRoot, record!.PatchId))
+                .ToArray(),
+        };
+    }
+
+    private static BoneMaskPatchAssetRecord AssertSingle(IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+        => assets.Count == 1 ? assets[0] : throw new InvalidOperationException($"Expected one selected logical asset, generated {assets.Count}.");
+
+    private static bool HasSmokingTrackEvidence(BoneMaskPatchAssetRecord asset, IReadOnlyList<string> excluded)
+    {
+        var source = new HashSet<string>(asset.SourceTrackNames, StringComparer.OrdinalIgnoreCase);
+        var output = new HashSet<string>(asset.OutputTrackNames, StringComparer.OrdinalIgnoreCase);
+        var aExcluded = excluded.Contains("iv_ochinko_a", StringComparer.OrdinalIgnoreCase);
+        return asset.StructuralValidationPassed
+               && asset.ExpectedTracksRemoved
+               && asset.OutputTrackCount == asset.SourceTrackCount - excluded.Count
+               && source.Contains("iv_ochinko_a")
+               && (aExcluded ? !output.Contains("iv_ochinko_a") : output.Contains("iv_ochinko_a"))
+               && excluded.All(name => source.Contains(name) && !output.Contains(name))
+               && new[] { "iv_kougan_l", "iv_kougan_r" }.All(name => !source.Contains(name) || output.Contains(name))
+               && source.Where(name => !excluded.Contains(name, StringComparer.OrdinalIgnoreCase)).OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
+                   .SequenceEqual(output.OrderBy(name => name, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase);
+    }
+
+    private static void RunCase(List<DancySelfTestCase> cases, string testName, string stage, string expected, Func<string> action)
+    {
+        var started = System.Diagnostics.Stopwatch.StartNew();
+        try
+        {
+            cases.Add(new DancySelfTestCase { TestName = testName, Stage = stage, Expected = expected, Actual = action(), Status = DancySelfTestStatus.Passed, DurationMilliseconds = started.ElapsedMilliseconds });
+        }
+        catch (Exception exception)
+        {
+            cases.Add(new DancySelfTestCase { TestName = testName, Stage = stage, Expected = expected, Actual = exception.Message, FailureReason = exception.ToString(), Status = DancySelfTestStatus.Failed, DurationMilliseconds = started.ElapsedMilliseconds });
+        }
+    }
+
+    private static bool EquivalentPath(string expected, string actual)
+        => string.Equals(Path.GetFullPath(expected).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar), Path.GetFullPath(actual).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar), StringComparison.OrdinalIgnoreCase);
+
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+
+    private static Guid ApplySourceFallback(Plugin plugin, string sourceModDirectory)
+    {
+        if (!PathSafety.TryResolveInsideRoot(plugin.Configuration.PenumbraPath, sourceModDirectory, out var folder))
+            throw new InvalidOperationException("Dancy refused the Smoking source directory.");
+        var meta = JObject.Parse(File.ReadAllText(Path.Combine(folder, "meta.json")));
+        var mappings = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var characterCode in SmokingIdleFixturePolicy.SupportedMaleCharacterCodes)
+        {
+            var mapping = PenumbraMetadataScanner.ScanV4(meta).FirstOrDefault(item => item.GamePath.Contains("/" + characterCode + "/", StringComparison.OrdinalIgnoreCase)
+                                                                                && item.GamePath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase));
+            if (mapping is null || !PathSafety.TryResolveInsideRoot(folder, mapping.ModPath, out var sourcePap) || !File.Exists(sourcePap))
+                throw new InvalidOperationException("Smoking Idle does not provide a safe " + characterCode + " PAP for the self-test.");
+            mappings[mapping.GamePath] = sourcePap;
+        }
+
+        return DalamudFrameworkInvocation.Invoke(() =>
+        {
+            var playerIndex = Plugin.ObjectTable.LocalPlayer?.ObjectIndex ?? -1;
+            if (playerIndex < 0)
+                throw new InvalidOperationException("The local player is unavailable.");
+            var collection = new GetCollectionForObject(Plugin.PluginInterface).Invoke(playerIndex);
+            if (!collection.Item1 || !collection.Item2 || collection.Item3.Item1 == Guid.Empty)
+                throw new InvalidOperationException("Penumbra did not provide an effective player collection.");
+            var result = new AddTemporaryMod(Plugin.PluginInterface).Invoke(
+                SourceFallbackTag,
+                collection.Item3.Item1,
+                mappings,
+                string.Empty,
+                SourceFallbackPriority).ToString();
+            if (!string.Equals(result, "Success", StringComparison.OrdinalIgnoreCase))
+                throw new InvalidOperationException("Penumbra rejected the test source route: " + result);
+            return collection.Item3.Item1;
+        });
+    }
+}
+#endif
diff --git a/Dancy/Diagnostics/DancySmokingTransformDiagnosticRunner.cs b/Dancy/Diagnostics/DancySmokingTransformDiagnosticRunner.cs
