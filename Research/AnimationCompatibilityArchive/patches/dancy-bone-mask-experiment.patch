diff --git a/Dancy/BoneMasking/BoneMaskPatchGenerator.cs b/Dancy/BoneMasking/BoneMaskPatchGenerator.cs
new file mode 100644
index 0000000..620d348
--- /dev/null
+++ b/Dancy/BoneMasking/BoneMaskPatchGenerator.cs
@@ -0,0 +1,239 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text.Json;
+using Dancy.Animation;
+using Dancy.Pap;
+
+namespace Dancy.BoneMasking;
+
+/// <summary>
+/// Generates a complete patch in a Dancy-owned directory. Source mods are
+/// read-only inputs; an existing output directory is replaced only after its
+/// Dancy marker is verified and a fully validated staging directory exists.
+/// </summary>
+public static class BoneMaskPatchGenerator
+{
+    public const string MarkerFileName = ".dancy-bone-mask.json";
+
+    public static BoneMaskPatchRecord Generate(string dancyPatchRoot, BoneMaskPatchPlan plan, IAnimationTrackExclusionWriter writer)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(dancyPatchRoot);
+        ArgumentNullException.ThrowIfNull(plan);
+        ArgumentNullException.ThrowIfNull(writer);
+        if (!plan.IsValid)
+            throw new InvalidOperationException("Dancy refused to generate an invalid Bone Mask plan: " + string.Join(" ", plan.Errors));
+
+        var root = Path.GetFullPath(dancyPatchRoot);
+        Directory.CreateDirectory(root);
+        var patchDirectory = Path.Combine(root, plan.PatchId);
+        var stagingDirectory = Path.Combine(root, "." + plan.PatchId + ".staging-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(stagingDirectory);
+        try
+        {
+            foreach (var companion in plan.DefaultCompanionAssets.Concat(plan.CompanionGroups.SelectMany(group => group.Assets)))
+            {
+                if (!File.Exists(companion.SourcePhysicalPath)
+                    || !string.Equals(HashFile(companion.SourcePhysicalPath), companion.SourceSha256, StringComparison.OrdinalIgnoreCase))
+                {
+                    throw new InvalidOperationException($"A companion source asset changed before Dancy generated {companion.GamePath}. Rebuild the plan and try again.");
+                }
+            }
+
+            var records = new List<BoneMaskPatchAssetRecord>(plan.Assets.Count);
+            foreach (var asset in plan.Assets)
+            {
+                if (!File.Exists(asset.SourcePhysicalPapPath)
+                    || !string.Equals(HashFile(asset.SourcePhysicalPapPath), asset.SourcePapSha256, StringComparison.OrdinalIgnoreCase))
+                {
+                    throw new InvalidOperationException($"The source PAP changed before Dancy generated {asset.LogicalGamePath}. Rebuild the plan and try again.");
+                }
+                if (asset.ReferencePap is not null
+                    && (!File.Exists(asset.ReferencePap.PhysicalPath)
+                        || !string.Equals(HashFile(asset.ReferencePap.PhysicalPath), asset.ReferencePap.Sha256, StringComparison.OrdinalIgnoreCase)))
+                {
+                    throw new InvalidOperationException($"The unmodified reference PAP changed before Dancy generated {asset.LogicalGamePath}. Rebuild the plan and try again.");
+                }
+                var stagingOutput = ResolveOwnedOutput(stagingDirectory, asset.OutputRelativePath);
+                Directory.CreateDirectory(Path.GetDirectoryName(stagingOutput)!);
+                var result = writer.RebuildWithExcludedBones(new AnimationTrackExclusionWriteRequest
+                {
+                    SourcePapPath = asset.SourcePhysicalPapPath,
+                    DancyOwnedOutputPath = stagingOutput,
+                    Association = new BoneMaskAnimationAssociation
+                    {
+                        SourceOverrideGamePath = asset.LogicalGamePath,
+                        ReplacementGamePath = asset.LogicalGamePath,
+                        MotionIdentity = $"havok:{asset.MotionIndex}",
+                        TargetSkeletonPath = asset.TargetSkeletonPath,
+                        TargetSkeletonIdentity = asset.TargetSkeletonIdentity,
+                    },
+                    AssetIdentity = asset.AssetIdentity,
+                    RequestedBoneNames = plan.ExcludedBoneNames,
+                    ComponentMasks = plan.ComponentMasks,
+                    ReferencePap = asset.ReferencePap,
+                });
+                var validationErrors = AnimationTrackExclusionResultValidator.Validate(new AnimationTrackExclusionWriteRequest
+                {
+                    SourcePapPath = asset.SourcePhysicalPapPath,
+                    DancyOwnedOutputPath = stagingOutput,
+                    Association = new BoneMaskAnimationAssociation
+                    {
+                        SourceOverrideGamePath = asset.LogicalGamePath,
+                        ReplacementGamePath = asset.LogicalGamePath,
+                        MotionIdentity = $"havok:{asset.MotionIndex}",
+                        TargetSkeletonPath = asset.TargetSkeletonPath,
+                        TargetSkeletonIdentity = asset.TargetSkeletonIdentity,
+                    },
+                    AssetIdentity = asset.AssetIdentity,
+                    RequestedBoneNames = plan.ExcludedBoneNames,
+                    ComponentMasks = plan.ComponentMasks,
+                    ReferencePap = asset.ReferencePap,
+                }, result);
+                if (validationErrors.Count > 0)
+                    throw new InvalidOperationException($"VFXEditor refused {asset.LogicalGamePath}: {string.Join(" ", validationErrors)}");
+                if (!File.Exists(stagingOutput))
+                    throw new InvalidOperationException($"VFXEditor reported success without creating {asset.LogicalGamePath}.");
+
+                _ = PapFileInspector.InspectFile(stagingOutput);
+
+                var outputHash = HashFile(stagingOutput);
+                if (!string.Equals(outputHash, result.OutputPapSha256, StringComparison.OrdinalIgnoreCase))
+                    throw new InvalidOperationException($"VFXEditor output hash did not match the written file for {asset.LogicalGamePath}.");
+
+                records.Add(new BoneMaskPatchAssetRecord
+                {
+                    LogicalGamePath = asset.LogicalGamePath,
+                    SourcePhysicalPapPath = asset.SourcePhysicalPapPath,
+                    SourcePapSha256 = asset.SourcePapSha256,
+                    TargetSkeletonIdentity = asset.TargetSkeletonIdentity,
+                    TargetSkeletonPath = asset.TargetSkeletonPath,
+                    MotionIndex = asset.MotionIndex,
+                    MotionName = asset.MotionName,
+                    ReferencePap = asset.ReferencePap,
+                    GeneratedAssetKey = asset.AssetIdentity.Key,
+                    OutputRelativePath = asset.OutputRelativePath,
+                    OutputPapPath = ResolveOwnedOutput(patchDirectory, asset.OutputRelativePath),
+                    OutputPapSha256 = outputHash,
+                    SourceTrackCount = result.SourceTrackCount,
+                    OutputTrackCount = result.OutputTrackCount,
+                    SourceTrackNames = result.SourceTrackNames.ToList(),
+                    OutputTrackNames = result.OutputTrackNames.ToList(),
+                    StructuralValidationPassed = result.Validation!.IsValid,
+                    ExpectedTracksRemoved = result.Validation.ExpectedTracksRemoved,
+                    ComponentTransformsValidated = result.Validation.ComponentMasksValid && result.Validation.NoUnexpectedTransformChanges,
+                    ComponentMaskEvidence = result.ComponentMaskEvidence.ToList(),
+                });
+            }
+
+            var record = new BoneMaskPatchRecord
+            {
+                PatchId = plan.PatchId,
+                DisplayName = $"Bone Mask - {plan.SourceModName}",
+                SourceModDirectory = plan.SourceModDirectory,
+                SourceModName = plan.SourceModName,
+                WriterSchemaVersion = writer.BackendId + "/" + VfxEditorPapRebuildProtocol.WriterSchemaVersion,
+                Scope = plan.Scope,
+                ExcludedBoneNames = plan.ExcludedBoneNames.ToList(),
+                ComponentMasks = plan.ComponentMasks.ToList(),
+                ExplicitlyExcludedCharacterCodes = plan.ExplicitlyExcludedCharacterCodes.ToList(),
+                Assets = records.OrderBy(asset => asset.LogicalGamePath, StringComparer.OrdinalIgnoreCase).ToList(),
+                CompanionAssetsCaptured = true,
+                DefaultCompanionAssets = plan.DefaultCompanionAssets.Select(CloneCompanion).ToList(),
+                CompanionGroups = plan.CompanionGroups.Select(group => new BoneMaskCompanionGroupRecord
+                {
+                    Name = group.Name,
+                    SourceGroupOrder = group.SourceGroupOrder,
+                    SourceGroupMetadataJson = group.SourceGroupMetadataJson,
+                    Assets = group.Assets.Select(CloneCompanion).ToList(),
+                }).ToList(),
+                PapOptionGroupsCaptured = true,
+                PapOptionGroups = plan.PapOptionGroups.Select(group => new BoneMaskPapOptionGroupRecord
+                {
+                    Name = group.Name,
+                    SourceGroupOrder = group.SourceGroupOrder,
+                    SourceGroupMetadataJson = group.SourceGroupMetadataJson,
+                }).ToList(),
+            };
+            WriteMarker(stagingDirectory, record);
+            ReplaceOwnedDirectory(patchDirectory, stagingDirectory, plan.PatchId);
+            return record;
+        }
+        catch
+        {
+            if (Directory.Exists(stagingDirectory))
+                Directory.Delete(stagingDirectory, recursive: true);
+            throw;
+        }
+    }
+
+    public static bool IsOwnedPatchDirectory(string directory, string patchId)
+    {
+        try
+        {
+            var marker = Path.Combine(directory, MarkerFileName);
+            if (!File.Exists(marker))
+                return false;
+            var record = JsonSerializer.Deserialize<BoneMaskPatchRecord>(File.ReadAllText(marker));
+            return record is not null && string.Equals(record.PatchId, patchId, StringComparison.OrdinalIgnoreCase);
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+    }
+
+    private static void WriteMarker(string directory, BoneMaskPatchRecord record)
+        => File.WriteAllText(Path.Combine(directory, MarkerFileName), JsonSerializer.Serialize(record, new JsonSerializerOptions { WriteIndented = true }));
+
+    private static void ReplaceOwnedDirectory(string destination, string staging, string patchId)
+    {
+        if (!Directory.Exists(destination))
+        {
+            Directory.Move(staging, destination);
+            return;
+        }
+        if (!IsOwnedPatchDirectory(destination, patchId))
+            throw new InvalidOperationException("Dancy refused to replace a directory it does not own.");
+
+        var backup = destination + ".backup-" + Guid.NewGuid().ToString("N");
+        Directory.Move(destination, backup);
+        try
+        {
+            Directory.Move(staging, destination);
+            Directory.Delete(backup, recursive: true);
+        }
+        catch
+        {
+            if (!Directory.Exists(destination) && Directory.Exists(backup))
+                Directory.Move(backup, destination);
+            throw;
+        }
+    }
+
+    private static string ResolveOwnedOutput(string root, string relativePath)
+    {
+        var candidate = Path.GetFullPath(Path.Combine(root, relativePath));
+        var normalizedRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
+                             + Path.DirectorySeparatorChar;
+        if (!candidate.StartsWith(normalizedRoot, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidOperationException("Dancy refused an output path outside its owned patch directory.");
+        return candidate;
+    }
+
+    private static BoneMaskCompanionAssetRecord CloneCompanion(BoneMaskCompanionAssetRecord source)
+        => new()
+        {
+            SourceGroupName = source.SourceGroupName,
+            SourceOptionName = source.SourceOptionName,
+            GamePath = source.GamePath,
+            SourceRelativePath = source.SourceRelativePath,
+            SourcePhysicalPath = source.SourcePhysicalPath,
+            SourceSha256 = source.SourceSha256,
+            AssetType = source.AssetType,
+        };
+
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+}
