+    internal static CompanionPackage BuildCompanionPackage(BoneMaskPatchRecord patch)
+    {
+        var defaultRedirects = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        var allRedirects = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        var files = new Dictionary<string, PackageFile>(StringComparer.OrdinalIgnoreCase);
+        var allAssets = patch.DefaultCompanionAssets.Concat(patch.CompanionGroups.SelectMany(group => group.Assets))
+            .OrderBy(asset => asset.GamePath, StringComparer.OrdinalIgnoreCase)
+            .ThenBy(asset => asset.SourceGroupName, StringComparer.OrdinalIgnoreCase)
+            .ToArray();
+
+        foreach (var asset in patch.DefaultCompanionAssets)
+        {
+            var entryName = AddCompanionFile(files, asset);
+            AddRedirect(defaultRedirects, asset.GamePath, entryName, "DefaultData companion assets");
+            AddRedirect(allRedirects, asset.GamePath, entryName, "companion assets");
+        }
+
+        var groups = new List<OrderedPackageGroup>();
+        foreach (var companionGroup in patch.CompanionGroups.OrderBy(group => group.SourceGroupOrder).ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase))
+        {
+            if (string.IsNullOrWhiteSpace(companionGroup.SourceGroupMetadataJson))
+                throw new InvalidOperationException("A companion group is missing its source metadata snapshot: " + companionGroup.Name);
+            var group = JObject.Parse(companionGroup.SourceGroupMetadataJson);
+            var replacements = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+            foreach (var asset in companionGroup.Assets)
+            {
+                var entryName = AddCompanionFile(files, asset);
+                AddRedirect(replacements, asset.GamePath, entryName, "companion group " + companionGroup.Name);
+                AddRedirect(allRedirects, asset.GamePath, entryName, "companion assets");
+            }
+            ReplaceGroupFilePaths(group, replacements, companionGroup.Name);
+            groups.Add(new OrderedPackageGroup(companionGroup.SourceGroupOrder, companionGroup.Name, group));
+        }
+
+        return new CompanionPackage(defaultRedirects, allRedirects, files, groups, allAssets);
+    }
+
+    private static void ValidateAssetSet(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+    {
+        if (assets.Select(asset => GamePathIdentity.Normalize(asset.LogicalGamePath)).Distinct(StringComparer.OrdinalIgnoreCase).Count() != assets.Count)
+            throw new InvalidOperationException("Dancy refused duplicate logical game paths in a standalone export.");
+        foreach (var asset in assets)
+        {
+            if (!File.Exists(asset.OutputPapPath))
+                throw new InvalidOperationException("A generated Dancy PAP is missing: " + asset.LogicalGamePath);
+            if (!string.Equals(HashFile(asset.OutputPapPath), asset.OutputPapSha256, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidOperationException("A generated Dancy PAP changed on disk: " + asset.LogicalGamePath);
+            if (!asset.StructuralValidationPassed || !asset.ExpectedTracksRemoved || asset.OutputTrackCount > asset.SourceTrackCount)
+                throw new InvalidOperationException("Dancy has no successful VFXEditor mask evidence for: " + asset.LogicalGamePath);
+        }
+        if (BoneMaskNames.Normalize(patch.ExcludedBoneNames).Count == 0)
+            throw new InvalidOperationException("Dancy cannot export a Bone Mask with no excluded bones.");
+        ValidateScope(patch, assets, throwOnFailure: true);
+        ValidateSmokingCompanionRequirement(patch, throwOnFailure: true);
+        ValidateSmokingPapOptionRequirement(patch, assets, throwOnFailure: true);
+        ValidateSmokingBoneMaskEvidence(patch, assets, throwOnFailure: true);
+    }
+
+    private static Dictionary<string, string> BuildPapPackageFiles(IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+        => assets.GroupBy(asset => asset.OutputPapSha256, StringComparer.OrdinalIgnoreCase)
+            .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
+            .ToDictionary(group => group.Key, group => "files/" + group.Key.ToLowerInvariant() + ".pap", StringComparer.OrdinalIgnoreCase);
+
+    internal static PapPackage BuildPapPackage(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+    {
+        var filesByHash = BuildPapPackageFiles(assets);
+        var allRedirects = assets.ToDictionary(
+            asset => GamePathIdentity.Normalize(asset.LogicalGamePath),
+            asset => filesByHash[asset.OutputPapSha256],
+            StringComparer.OrdinalIgnoreCase);
+        var defaultRedirects = new Dictionary<string, string>(allRedirects, StringComparer.OrdinalIgnoreCase);
+        var groups = new List<OrderedPackageGroup>();
+        var groupedPaths = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+        if (patch.PapOptionGroupsCaptured)
+        {
+            foreach (var sourceGroup in patch.PapOptionGroups
+                         .OrderBy(group => group.SourceGroupOrder)
+                         .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase))
+            {
+                if (!TryBuildPapOptionGroup(sourceGroup, allRedirects, out var group, out var groupRedirects))
+                    continue;
+                foreach (var path in groupRedirects.Keys)
+                {
+                    if (!groupedPaths.Add(path))
+                        throw new InvalidOperationException("A PAP option group maps one logical game path more than once: " + path);
+                    defaultRedirects.Remove(path);
+                }
+                groups.Add(new OrderedPackageGroup(sourceGroup.SourceGroupOrder, sourceGroup.Name, group));
+            }
+        }
+
+        var files = filesByHash.ToDictionary(
+            pair => pair.Value,
+            pair => new PackageFile(
+                pair.Value,
+                assets.First(asset => string.Equals(asset.OutputPapSha256, pair.Key, StringComparison.OrdinalIgnoreCase)).OutputPapPath,
+                pair.Key,
+                ".pap"),
+            StringComparer.OrdinalIgnoreCase);
+        return new PapPackage(defaultRedirects, allRedirects, files, groups);
+    }
+
+    private static bool TryBuildPapOptionGroup(
+        BoneMaskPapOptionGroupRecord sourceGroup,
+        IReadOnlyDictionary<string, string> allRedirects,
+        out JObject group,
+        out IReadOnlyDictionary<string, string> redirects)
+    {
+        group = new JObject();
+        redirects = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        if (string.IsNullOrWhiteSpace(sourceGroup.SourceGroupMetadataJson))
+            throw new InvalidOperationException("A PAP option group is missing its source metadata snapshot: " + sourceGroup.Name);
+
+        group = JObject.Parse(sourceGroup.SourceGroupMetadataJson);
+        if (!string.Equals(group["Type"]?.ToString(), "Multi", StringComparison.OrdinalIgnoreCase)
+            || group["Options"] is not JArray sourceOptions
+            || group["Containers"] is JArray)
+        {
+            return false;
+        }
+
+        var retained = new JArray();
+        var replacements = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var sourceOption in sourceOptions.OfType<JObject>())
+        {
+            if (sourceOption["Files"] is not JObject sourceFiles)
+                continue;
+            var optionPaths = sourceFiles.Properties()
+                .Select(property => GamePathIdentity.Normalize(property.Name))
+                .ToArray();
+            if (optionPaths.Any(path => !path.EndsWith(".pap", StringComparison.OrdinalIgnoreCase)))
+                throw new InvalidOperationException("PAP option group contains a non-PAP mapping: " + sourceGroup.Name);
+            var selectedPaths = optionPaths.Where(allRedirects.ContainsKey).ToArray();
+            if (selectedPaths.Length == 0)
+                continue;
+
+            var option = (JObject)sourceOption.DeepClone();
+            var files = (JObject)option["Files"]!;
+            foreach (var property in files.Properties().ToArray())
+            {
+                var path = GamePathIdentity.Normalize(property.Name);
+                if (!allRedirects.TryGetValue(path, out var entryName))
+                    property.Remove();
+                else
+                {
+                    property.Value = entryName;
+                    AddRedirect(replacements, path, entryName, "PAP option group " + sourceGroup.Name);
+                }
+            }
+            if (files.Properties().Any())
+                retained.Add(option);
+        }
+
+        if (retained.Count == 0)
+            return false;
+        group["Options"] = retained;
+        group["DefaultSettings"] = AllMultiOptionsEnabled(retained.Count);
+        redirects = replacements;
+        return true;
+    }
+
+    private static int AllMultiOptionsEnabled(int optionCount)
+    {
+        if (optionCount is < 1 or > 30)
+            throw new InvalidOperationException("Dancy only supports Multi PAP groups with 1 through 30 retained options.");
+        return (1 << optionCount) - 1;
+    }
+
+    private static string AddCompanionFile(IDictionary<string, PackageFile> files, BoneMaskCompanionAssetRecord asset)
+    {
+        if (string.IsNullOrWhiteSpace(asset.SourceSha256) || string.IsNullOrWhiteSpace(asset.SourcePhysicalPath))
+            throw new InvalidOperationException("A companion asset is missing source identity: " + asset.GamePath);
+        var extension = Path.GetExtension(asset.GamePath);
+        if (string.IsNullOrWhiteSpace(extension))
+            extension = Path.GetExtension(asset.SourcePhysicalPath);
+        if (string.IsNullOrWhiteSpace(extension))
+            throw new InvalidOperationException("A companion asset has no file extension: " + asset.GamePath);
+        var entryName = "files/" + asset.SourceSha256.ToLowerInvariant() + extension.ToLowerInvariant();
+        if (!files.TryGetValue(entryName, out var existing))
+            files.Add(entryName, new PackageFile(entryName, asset.SourcePhysicalPath, asset.SourceSha256, extension));
+        else if (!string.Equals(existing.Sha256, asset.SourceSha256, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidOperationException("Companion archive entry identity collision: " + asset.GamePath);
+        return entryName;
+    }
+
+    private static void ReplaceGroupFilePaths(JObject group, IReadOnlyDictionary<string, string> replacements, string groupName)
+    {
+        var replaced = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var files in EnumerateGroupFiles(group))
+        {
+            foreach (var property in files.Properties())
+            {
+                var gamePath = GamePathIdentity.Normalize(property.Name);
+                if (!replacements.TryGetValue(gamePath, out var entryName))
+                    throw new InvalidOperationException($"Companion group {groupName} contains an uncaptured mapping: {property.Name}");
+                property.Value = entryName;
+                replaced.Add(gamePath);
+            }
+        }
+        if (!replaced.SetEquals(replacements.Keys))
+            throw new InvalidOperationException("Companion group metadata did not contain every captured mapping: " + groupName);
+    }
+
+    internal static IEnumerable<JObject> EnumerateGroupFiles(JObject group)
+    {
+        if (group["Options"] is JArray options)
+        {
+            foreach (var option in options.OfType<JObject>())
+            {
+                if (option["Files"] is JObject files)
+                    yield return files;
+            }
+        }
+        if (group["Containers"] is not JArray containers)
+            yield break;
+        foreach (var container in containers.OfType<JObject>())
+        {
+            if (container["Files"] is JObject files)
+                yield return files;
+        }
+    }
+
+    private static JObject CreateMetadata(BoneMaskPatchRecord patch, IReadOnlyDictionary<string, string> defaultRedirects, JArray groups)
+    {
+        var files = new JObject();
+        foreach (var pair in defaultRedirects.OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase))
+            files[pair.Key] = pair.Value;
+        return new JObject
+        {
+            ["FileVersion"] = 4,
+            ["Identifier"] = DeterministicGuid(patch.PatchId).ToString("D"),
+            ["LastWrite"] = "1980-01-01T00:00:00.0000000Z",
+            ["Name"] = "Dancy Bone Mask - " + patch.SourceModName,
+            ["Author"] = "Dancy",
+            ["Version"] = "1.0.0",
+            ["Description"] = "Derived animation bone-mask PAPs with preserved source companion assets. Original source animation is not included.",
+            ["DefaultData"] = new JObject { ["Files"] = files },
+            ["Groups"] = groups,
+        };
+    }
