+++ b/Dancy/Diagnostics/DancySmokingTransformDiagnosticRunner.cs
@@ -0,0 +1,291 @@
+#if DEBUG
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using Dancy.Animation;
+using Dancy.BoneMasking;
+using Dancy.Domain;
+using Dancy.Pap;
+using Dancy.Penumbra;
+using Dancy.Persistence;
+using Newtonsoft.Json.Linq;
+using Penumbra.Api.IpcSubscribers;
+
+namespace Dancy.Diagnostics;
+
+/// <summary>
+/// Read-only Smoking Idle transform diagnostic. It samples the installed source
+/// against unmodified game-data Idle 0 through VFXEditor's public analysis IPC.
+/// The only retained files are immutable vanilla PAP copies under Dancy config.
+/// </summary>
+internal sealed class DancySmokingTransformDiagnosticRunner
+{
+    private static readonly IReadOnlyList<string> InspectedBones =
+    [
+        "iv_ochinko_a", "iv_ochinko_b", "iv_ochinko_c", "iv_ochinko_d", "iv_ochinko_e", "iv_ochinko_f",
+        "iv_kougan_l", "iv_kougan_r",
+    ];
+
+    public DancySelfTestResult Run(Plugin plugin)
+    {
+        var started = DateTimeOffset.UtcNow;
+        var cases = new List<DancySelfTestCase>();
+        var retainedArtifacts = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        InstalledModSourceResolution? source = null;
+        Dictionary<string, string>? sourceHashes = null;
+
+        RunCase(cases, "VFXEditor read-only transform capability", "capability",
+            "VFXEditor exposes its versioned read-only PAP transform analysis endpoint.", () =>
+            {
+                var capabilities = new VfxEditorIpcAnimationTrackExclusionWriter(new DalamudVfxEditorPapRebuildGateway()).GetCapabilities();
+                if (capabilities.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+                    || !capabilities.SupportsReadOnlyTransformAnalysis
+                    || !capabilities.ProvidesComponentTransformEvidence
+                    || capabilities.SupportsInPlaceSourceMutation)
+                {
+                    throw new InvalidOperationException("The loaded VFXEditor does not provide the required read-only transform analysis capability.");
+                }
+                return $"VFXEditor {capabilities.VfxEditorVersion} analysis IPC is available.";
+            });
+
+        RunCase(cases, "Smoking Idle male source resolution", "source",
+            "All eight supported male Idle 0 PAPs resolve from the installed Smoking metadata without activating any option.", () =>
+            {
+                var candidates = new GetModList(Plugin.PluginInterface).Invoke()
+                    .Where(pair => SmokingIdleFixturePolicy.IsSmokingIdle(pair.Value)
+                                   && !pair.Value.StartsWith("Dancy Bone Mask -", StringComparison.OrdinalIgnoreCase))
+                    .OrderBy(pair => pair.Value, StringComparer.OrdinalIgnoreCase)
+                    .Select(pair => ResolveInstalledSmokingSource(plugin.Configuration.PenumbraPath, pair.Key, pair.Value))
+                    .Where(candidate => candidate is not null)
+                    .Cast<InstalledModSourceResolution>()
+                    .ToArray();
+                if (candidates.Length == 0)
+                    throw new InvalidOperationException("No installed non-Dancy Smoking Idle mod was found.");
+
+                source = candidates
+                    .Where(candidate => SupportedMappings(candidate).Select(mapping => mapping.Character.Code)
+                        .OrderBy(code => code, StringComparer.OrdinalIgnoreCase)
+                        .SequenceEqual(SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.OrderBy(code => code, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase))
+                    .OrderBy(candidate => candidate.SourceModName, StringComparer.OrdinalIgnoreCase)
+                    .FirstOrDefault();
+                if (source is null)
+                    throw new InvalidOperationException("No installed Smoking Idle metadata entry contains all eight supported male Idle 0 PAPs.");
+
+                var maleMappings = SupportedMappings(source);
+                var expected = SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.OrderBy(code => code, StringComparer.OrdinalIgnoreCase).ToArray();
+                var actual = maleMappings.Select(mapping => mapping.Character.Code).OrderBy(code => code, StringComparer.OrdinalIgnoreCase).ToArray();
+                if (!expected.SequenceEqual(actual, StringComparer.OrdinalIgnoreCase))
+                {
+                    throw new InvalidOperationException("The installed Smoking Idle source does not expose exactly the eight supported male paths: "
+                                                        + string.Join(", ", actual));
+                }
+
+                sourceHashes = maleMappings
+                    .GroupBy(mapping => mapping.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase)
+                    .ToDictionary(group => group.Key, group => HashFile(group.Key), StringComparer.OrdinalIgnoreCase);
+                return $"{source.SourceModName}: {string.Join(", ", actual)}. Metadata inspection only; no option was activated.";
+            });
+
+        if (source is not null)
+        {
+            var writer = new VfxEditorIpcAnimationTrackExclusionWriter(new DalamudVfxEditorPapRebuildGateway());
+            var skeletons = new DalamudTargetSkeletonPathResolver(new DalamudActiveGamePathResolver(), plugin.BoneMaskPatches.PatchRoot);
+            foreach (var mapping in SupportedMappings(source))
+            {
+                var code = mapping.Character.Code;
+                RunCase(cases, $"Smoking transform analysis {code}", "analysis",
+                    "Smoking transforms are sampled against the same-rig skeleton rest pose for A-F and kougan L/R without creating an output PAP.", () =>
+                    {
+                        var sourcePap = PapFileInspector.InspectFile(mapping.SourcePhysicalPapPath);
+                        if (sourcePap.HavokIndices.Count == 0 || sourcePap.HavokIndices[0] < 0)
+                            throw new InvalidOperationException($"Smoking source {code} does not bind Idle 0 to a Havok animation.");
+                        if (!skeletons.TryResolve(mapping.LogicalGamePath, out var skeletonPath, out _, out var skeletonError))
+                            throw new InvalidOperationException("Target skeleton resolution failed: " + skeletonError);
+                        var tracks = writer.Analyze(
+                            mapping.SourcePhysicalPapPath,
+                            mapping.SourcePapSha256,
+                            string.Empty,
+                            string.Empty,
+                            skeletonPath,
+                            sourcePap.HavokIndices[0],
+                            -1,
+                            InspectedBones,
+                            useSkeletonRest: true);
+                        var indexed = tracks.ToDictionary(track => track.BoneName, StringComparer.OrdinalIgnoreCase);
+                        var missing = InspectedBones.Where(name => !indexed.ContainsKey(name)).ToArray();
+                        if (missing.Length > 0)
+                            throw new InvalidOperationException("VFXEditor did not report all requested tracks: " + string.Join(", ", missing));
+                        var a = indexed["iv_ochinko_a"];
+                        if (!a.SourceTrackPresent || !a.ReferenceTrackPresent || a.Source is null || a.Reference is null || a.SourceToReference is null)
+                            throw new InvalidOperationException("iv_ochinko_a is not available in both the Smoking source and same-rig skeleton rest reference.");
+                        return string.Join("; ", InspectedBones.Select(name => Describe(indexed[name])))
+                               + "; classification=" + ClassifyA(a)
+                               + "; reference=same-rig skeleton rest pose sampled at the Smoking motion times.";
+                    });
+            }
+
+            RunCase(cases, "Smoking source integrity", "integrity",
+                "Every inspected Smoking PAP has its original SHA-256 after the diagnostic.", () =>
+                {
+                    if (sourceHashes is null)
+                        throw new InvalidOperationException("Smoking source hashes were not captured.");
+                    foreach (var pair in sourceHashes)
+                    {
+                        if (!string.Equals(pair.Value, HashFile(pair.Key), StringComparison.OrdinalIgnoreCase))
+                            throw new InvalidOperationException("The Smoking source PAP changed during the diagnostic: " + pair.Key);
+                    }
+                    return "Smoking PAP hashes are unchanged; no PAP or Penumbra output was created.";
+                });
+        }
+
+        return new DancySelfTestResult
+        {
+            StartedAtUtc = started,
+            CompletedAtUtc = DateTimeOffset.UtcNow,
+            Cases = cases,
+            RetainedArtifacts = retainedArtifacts.OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray(),
+        };
+    }
+
+    private static IReadOnlyList<InstalledPapMapping> SupportedMappings(InstalledModSourceResolution source)
+        => source.ActiveMappings
+            .Where(mapping => string.Equals(mapping.Character.Sex, "Male", StringComparison.OrdinalIgnoreCase)
+                              && SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.Contains(mapping.Character.Code, StringComparer.OrdinalIgnoreCase))
+            .GroupBy(mapping => GamePathIdentity.Normalize(mapping.LogicalGamePath), StringComparer.OrdinalIgnoreCase)
+            .Select(group => group.OrderBy(mapping => mapping.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase).First())
+            .OrderBy(mapping => mapping.Character.Code, StringComparer.OrdinalIgnoreCase)
+            .ToArray();
+
+    private static InstalledModSourceResolution? ResolveInstalledSmokingSource(string penumbraRoot, string modDirectory, string fallbackName)
+    {
+        if (string.IsNullOrWhiteSpace(modDirectory)
+            || !PathSafety.TryResolveInsideRoot(penumbraRoot, modDirectory, out var folder)
+            || !Directory.Exists(folder))
+        {
+            return null;
+        }
+        var metaPath = Path.Combine(folder, "meta.json");
+        if (!File.Exists(metaPath))
+            return null;
+        try
+        {
+            var meta = JObject.Parse(File.ReadAllText(metaPath));
+            if ((meta["FileVersion"]?.Value<int?>() ?? 0) < 4)
+                return null;
+            var name = meta["Name"]?.ToString();
+            if (string.IsNullOrWhiteSpace(name))
+                name = fallbackName;
+            var mappings = PenumbraMetadataScanner.ScanV4(meta)
+                .Where(mapping => mapping.GamePath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase)
+                                  && mapping.ModPath.EndsWith(".pap", StringComparison.OrdinalIgnoreCase))
+                .Select(mapping =>
+                {
+                    if (!PathSafety.TryResolveInsideRoot(folder, mapping.ModPath, out var path) || !File.Exists(path))
+                        return null;
+                    var logicalPath = GamePathIdentity.Normalize(mapping.GamePath);
+                    var character = CharacterPathIdentity.FromGamePath(logicalPath);
+                    return string.Equals(character.Sex, "Male", StringComparison.OrdinalIgnoreCase)
+                           && SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.Contains(character.Code, StringComparer.OrdinalIgnoreCase)
+                        ? new InstalledPapMapping
+                        {
+                            SourceModDirectory = modDirectory,
+                            SourceModName = name,
+                            SourceGroupName = mapping.GroupName,
+                            SourceOptionName = mapping.OptionName,
+                            LogicalGamePath = logicalPath,
+                            SourceRelativePapPath = mapping.ModPath.Replace('\\', '/'),
+                            SourcePhysicalPapPath = Path.GetFullPath(path),
+                            SourcePapSha256 = HashFile(path),
+                        }
+                        : null;
+                })
+                .Where(mapping => mapping is not null)
+                .Cast<InstalledPapMapping>()
+                .GroupBy(mapping => mapping.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+                .Select(group => group.OrderBy(mapping => mapping.SourceGroupName, StringComparer.OrdinalIgnoreCase)
+                    .ThenBy(mapping => mapping.SourceOptionName, StringComparer.OrdinalIgnoreCase)
+                    .ThenBy(mapping => mapping.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase)
+                    .First())
+                .OrderBy(mapping => mapping.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+                .ToArray();
+            return new InstalledModSourceResolution
+            {
+                SourceModDirectory = modDirectory,
+                SourceModName = name,
+                ActiveMappings = mappings,
+                PhysicalSourceGroups = mappings
+                    .GroupBy(mapping => mapping.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase)
+                    .Select(group => new PhysicalPapSourceGroup
+                    {
+                        SourcePhysicalPapPath = group.Key,
+                        SourcePapSha256 = group.First().SourcePapSha256,
+                        LogicalGamePaths = group.Select(mapping => mapping.LogicalGamePath).OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray(),
+                    })
+                    .OrderBy(group => group.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase)
+                    .ToArray(),
+            };
+        }
+        catch
+        {
+            return null;
+        }
+    }
+
+    private static string Describe(AnimationTransformTrackEvidence track)
+    {
+        if (!track.SourceTrackPresent || !track.ReferenceTrackPresent || track.Source is null || track.Reference is null || track.SourceToReference is null)
+            return $"{track.BoneName}: source-present={track.SourceTrackPresent}, reference-present={track.ReferenceTrackPresent}";
+        return $"{track.BoneName}: source[{Describe(track.Source)}], reference[{Describe(track.Reference)}], "
+               + $"difference[T={Number(track.SourceToReference.MaximumTranslationDifference)},R={Number(track.SourceToReference.MaximumRotationDifferenceDegrees)}deg,S={Number(track.SourceToReference.MaximumScaleDifference)}]";
+    }
+
+    private static string Describe(AnimationTransformTrackSummary summary)
+        => $"T={Activity(summary.TranslationChanges, summary.TranslationRangeMagnitude)},"
+           + $"R={Activity(summary.RotationChanges, summary.RotationRangeDegrees)}deg,"
+           + $"S={Activity(summary.ScaleChanges, summary.ScaleRangeMagnitude)}";
+
+    private static string Activity(bool changes, float range) => (changes ? "animated:" : "constant:") + Number(range);
+    private static string Number(float value) => value.ToString("0.####", CultureInfo.InvariantCulture);
+
+    private static string ClassifyA(AnimationTransformTrackEvidence a)
+    {
+        var source = a.Source!;
+        var difference = a.SourceToReference!;
+        if (source.RotationChanges && difference.MaximumRotationDifferenceDegrees >= 1f)
+            return "rotation candidate (animated source rotation differs from skeleton rest by " + Number(difference.MaximumRotationDifferenceDegrees) + " degrees)";
+        if (source.TranslationChanges && difference.MaximumTranslationDifference >= 0.001f)
+            return "translation candidate (animated source translation differs from skeleton rest by " + Number(difference.MaximumTranslationDifference) + ")";
+        if (source.ScaleChanges && difference.MaximumScaleDifference >= 0.001f)
+            return "scale candidate (animated source scale differs from skeleton rest by " + Number(difference.MaximumScaleDifference) + ")";
+        if (difference.MaximumRotationDifferenceDegrees >= 1f)
+            return "rotation differs from skeleton rest but is constant; inherited parent motion remains possible";
+        return "unknown; A does not show a sufficiently distinct animated local component";
+    }
+
+    private static void RunCase(List<DancySelfTestCase> cases, string testName, string stage, string expected, Func<string> action)
+    {
+        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
+        try
+        {
+            cases.Add(new DancySelfTestCase
+            {
+                TestName = testName, Stage = stage, Expected = expected, Actual = action(), Status = DancySelfTestStatus.Passed,
+                DurationMilliseconds = stopwatch.ElapsedMilliseconds,
+            });
+        }
+        catch (Exception exception)
+        {
+            cases.Add(new DancySelfTestCase
+            {
+                TestName = testName, Stage = stage, Expected = expected, Actual = exception.Message, FailureReason = exception.ToString(),
+                Status = DancySelfTestStatus.Failed, DurationMilliseconds = stopwatch.ElapsedMilliseconds,
+            });
+        }
+    }
+
+    private static string HashFile(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+}
+#endif
