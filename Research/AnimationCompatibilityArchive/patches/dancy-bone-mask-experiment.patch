+    private static void ValidateScope(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets, bool throwOnFailure)
+    {
+        var error = ScopeError(patch, assets);
+        if (error is not null && throwOnFailure)
+            throw new InvalidOperationException(error);
+    }
+
+    internal static string? ScopeError(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+    {
+        if (patch.Scope != BoneMaskPatchScope.MaleModelsSupportedOnly)
+            return null;
+        if (assets.Any(asset => !CharacterPathIdentity.FromGamePath(asset.LogicalGamePath).IsKnown
+                                || !string.Equals(CharacterPathIdentity.FromGamePath(asset.LogicalGamePath).Sex, "Male", StringComparison.OrdinalIgnoreCase)))
+            return "Male-supported export contains a non-male character path.";
+        if (assets.Any(asset => string.Equals(CharacterPathIdentity.FromGamePath(asset.LogicalGamePath).Code, "c1101", StringComparison.OrdinalIgnoreCase)))
+            return "Male-supported export must not include c1101 Lalafell.";
+        if (SmokingIdleFixturePolicy.IsSmokingIdle(patch.SourceModName))
+        {
+            var actual = assets.Select(asset => CharacterPathIdentity.FromGamePath(asset.LogicalGamePath).Code).OrderBy(code => code, StringComparer.OrdinalIgnoreCase).ToArray();
+            var expected = SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.OrderBy(code => code, StringComparer.OrdinalIgnoreCase).ToArray();
+            if (!actual.SequenceEqual(expected, StringComparer.OrdinalIgnoreCase))
+                return "Smoking Idle male export must contain exactly the eight supported male character paths and no others.";
+        }
+        return null;
+    }
+
+    internal static string? SmokingCompanionError(BoneMaskPatchRecord patch)
+    {
+        if (!SmokingIdleFixturePolicy.IsSmokingIdle(patch.SourceModName))
+            return null;
+        var assets = patch.DefaultCompanionAssets.Concat(patch.CompanionGroups.SelectMany(group => group.Assets)).ToArray();
+        if (!patch.CompanionGroups.Any(group => string.Equals(group.Name, "VFX and TMB", StringComparison.OrdinalIgnoreCase)))
+            return "Smoking Idle standalone export is missing the VFX and TMB source option group.";
+        if (!assets.Any(asset => string.Equals(asset.AssetType, "TMB", StringComparison.OrdinalIgnoreCase)))
+            return "Smoking Idle standalone export is missing its TMB companion asset.";
+        if (!assets.Any(asset => string.Equals(asset.AssetType, "VFX", StringComparison.OrdinalIgnoreCase)))
+            return "Smoking Idle standalone export is missing its AVFX companion assets.";
+        return null;
+    }
+
+    internal static string? SmokingPapOptionError(BoneMaskPatchRecord patch, IReadOnlyList<BoneMaskPatchAssetRecord> assets)
+    {
+        if (!SmokingIdleFixturePolicy.IsSmokingIdle(patch.SourceModName))
+            return null;
+        if (!patch.PapOptionGroupsCaptured)
+            return "Smoking Idle standalone export needs a rebuilt patch to capture the source M options group.";
+
+        var groups = BuildPapPackage(patch, assets).Groups;
+        var maleGroup = groups.SingleOrDefault(group => string.Equals(group.Name, "M options", StringComparison.OrdinalIgnoreCase));
+        if (maleGroup is null)
+            return "Smoking Idle standalone export is missing the source M options group.";
+        if (!string.Equals(maleGroup.Group["Type"]?.ToString(), "Multi", StringComparison.OrdinalIgnoreCase)
+            || maleGroup.Group["Options"] is not JArray options
+            || maleGroup.Group["DefaultSettings"]?.Value<int?>() != 255)
+        {
+            return "Smoking Idle M options metadata is not a fully enabled eight-option Multi group.";
+        }
+
+        var expectedNames = new[] { "M Midlander", "M Highlander", "M Elezen", "M Miqo'te", "M Roe", "M Aura", "Hrothgar", "M Viera" };
+        var actualNames = options.OfType<JObject>().Select(option => option["Name"]?.ToString() ?? string.Empty).ToArray();
+        if (!actualNames.SequenceEqual(expectedNames, StringComparer.Ordinal))
+            return "Smoking Idle M options do not retain the expected labels and order.";
+
+        var expectedPaths = assets.ToDictionary(asset => GamePathIdentity.Normalize(asset.LogicalGamePath), asset => asset, StringComparer.OrdinalIgnoreCase);
+        var optionPaths = options.OfType<JObject>()
+            .SelectMany(option => (option["Files"] as JObject)?.Properties() ?? [])
+            .Select(property => GamePathIdentity.Normalize(property.Name))
+            .ToArray();
+        if (!optionPaths.OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
+                .SequenceEqual(expectedPaths.Keys.OrderBy(path => path, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase))
+        {
+            return "Smoking Idle M options do not independently map the complete retained male PAP path set.";
+        }
+        return null;
+    }
