+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using Dalamud.Bindings.ImGui;
+using Dalamud.Interface.Windowing;
+using Dancy.BoneMasking;
+using Penumbra.Api.IpcSubscribers;
+
+namespace Dancy.Windows;
+
+/// <summary>
+/// Focused front end for installed-mod bone masks. The normal override wizard
+/// remains separate because this workflow never edits the selected source mod.
+/// </summary>
+public sealed class BoneMaskWindow : Window, IDisposable
+{
+    private readonly Plugin plugin;
+    private readonly GetModList getModList = new(Plugin.PluginInterface);
+    private Dictionary<string, string> mods = new(StringComparer.OrdinalIgnoreCase);
+    private string filter = string.Empty;
+    private string? selectedDirectory;
+    private InstalledModSourceResolution? source;
+    private readonly HashSet<string> selectedPaths = new(StringComparer.OrdinalIgnoreCase);
+    private BoneMaskPatchScope scope = BoneMaskPatchScope.SelectedPaths;
+    private string boneNames = string.Join("\n", SmokingIdleFixturePolicy.DefaultExcludedBoneNames);
+    private int animationIndex;
+    private string exportPath = string.Empty;
+    private BoneMaskPatchRecord? currentPatch;
+    private string status = string.Empty;
+    private bool working;
+
+    public BoneMaskWindow(Plugin plugin) : base("Dancy - Installed Bone Mask")
+    {
+        this.plugin = plugin;
+        SizeConstraints = new WindowSizeConstraints
+        {
+            MinimumSize = new System.Numerics.Vector2(760, 560),
+            MaximumSize = new System.Numerics.Vector2(float.MaxValue, float.MaxValue),
+        };
+    }
+
+    public void Dispose() { }
+
+    public override void OnOpen()
+    {
+        base.OnOpen();
+        if (mods.Count == 0 && !working)
+            LoadMods();
+    }
+
+    public override void Draw()
+    {
+        ImGui.TextWrapped("Generate Dancy-owned masked PAPs from an active Penumbra animation. The installed source mod remains read-only.");
+        ImGui.Separator();
+        DrawModSelection();
+        ImGui.Separator();
+        DrawSourcePaths();
+        ImGui.Separator();
+        DrawMaskAndGeneration();
+        ImGui.Separator();
+        DrawPatchActions();
+        if (!string.IsNullOrWhiteSpace(status))
+        {
+            ImGui.Separator();
+            ImGui.TextWrapped(status);
+        }
+    }
+
+    private void DrawModSelection()
+    {
+        ImGui.InputText("Filter installed mods", ref filter, 256);
+        ImGui.SameLine();
+        if (ImGui.Button("Refresh") && !working)
+            LoadMods();
+        var visible = mods
+            .Where(pair => string.IsNullOrWhiteSpace(filter)
+                           || pair.Value.Contains(filter, StringComparison.OrdinalIgnoreCase)
+                           || pair.Key.Contains(filter, StringComparison.OrdinalIgnoreCase))
+            .OrderBy(pair => pair.Value, StringComparer.OrdinalIgnoreCase)
+            .ToArray();
+        if (ImGui.BeginCombo("Installed source mod", selectedDirectory is not null && mods.TryGetValue(selectedDirectory, out var name) ? name : "Select a mod"))
+        {
+            foreach (var pair in visible)
+            {
+                var selected = string.Equals(selectedDirectory, pair.Key, StringComparison.OrdinalIgnoreCase);
+                if (ImGui.Selectable(pair.Value, selected))
+                {
+                    selectedDirectory = pair.Key;
+                    source = null;
+                    currentPatch = null;
+                    selectedPaths.Clear();
+                }
+                if (selected)
+                    ImGui.SetItemDefaultFocus();
+            }
+            ImGui.EndCombo();
+        }
+        ImGui.SameLine();
+        if (ImGui.Button("Inspect active paths") && selectedDirectory is not null && !working)
+            InspectSource();
+    }
+
+    private void DrawSourcePaths()
+    {
+        if (source is null)
+        {
+            ImGui.TextDisabled("Inspect an installed mod to show the PAP paths currently active for your player collection.");
+            return;
+        }
+        ImGui.Text($"Active PAP redirects: {source.ActiveMappings.Count}  Physical source PAPs: {source.PhysicalSourceGroups.Count}");
+        foreach (var error in source.Errors)
+            ImGui.TextColored(new System.Numerics.Vector4(1f, .35f, .35f, 1f), error);
+        foreach (var warning in source.Warnings)
+            ImGui.TextDisabled(warning);
+        foreach (var mapping in source.ActiveMappings)
+        {
+            var selected = selectedPaths.Contains(mapping.LogicalGamePath);
+            var label = $"{mapping.Character.DisplayName} | {mapping.LogicalGamePath}##{mapping.LogicalGamePath}";
+            if (ImGui.Checkbox(label, ref selected))
+            {
+                if (selected)
+                    selectedPaths.Add(mapping.LogicalGamePath);
+                else
+                    selectedPaths.Remove(mapping.LogicalGamePath);
+            }
+        }
+        var shared = source.PhysicalSourceGroups.Where(group => group.LogicalGamePaths.Count > 1).ToArray();
+        if (shared.Length > 0)
+            ImGui.TextDisabled($"{shared.Length} physical PAP source group(s) serve multiple logical game paths; selection remains path-scoped.");
+    }
+
+    private void DrawMaskAndGeneration()
+    {
+        var scopeValue = (int)scope;
+        ImGui.RadioButton("Selected paths", ref scopeValue, (int)BoneMaskPatchScope.SelectedPaths);
+        ImGui.SameLine();
+        ImGui.RadioButton("Male models - supported only", ref scopeValue, (int)BoneMaskPatchScope.MaleModelsSupportedOnly);
+        scope = (BoneMaskPatchScope)scopeValue;
+        if (scope == BoneMaskPatchScope.MaleModelsSupportedOnly)
+            ImGui.TextDisabled("Smoking Idle rule: c1101 Lalafell and all female paths are excluded.");
+        ImGui.InputInt("PAP animation index", ref animationIndex);
+        if (animationIndex < 0)
+            animationIndex = 0;
+        ImGui.InputTextMultiline("Excluded bones", ref boneNames, 2048, new System.Numerics.Vector2(-1, 96));
+        if (working)
+            ImGui.BeginDisabled();
+        var apply = ImGui.Button("Generate Dancy Bone Mask");
+        if (working)
+            ImGui.EndDisabled();
+        if (apply && source is not null && selectedDirectory is not null)
+            Generate();
+    }
+
+    private void DrawPatchActions()
+    {
+        if (currentPatch is null && plugin.Configuration.BoneMaskPatches.Count > 0)
+        {
+            if (ImGui.BeginCombo("Existing Dancy patch", "Select a saved patch"))
+            {
+                foreach (var saved in plugin.Configuration.BoneMaskPatches.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
+                {
+                    if (ImGui.Selectable($"{saved.DisplayName} ({saved.Assets.Count})##{saved.PatchId}"))
+                        currentPatch = saved;
+                }
+                ImGui.EndCombo();
+            }
+        }
+
+        var patch = currentPatch;
+        if (patch is null)
+        {
+            ImGui.TextDisabled("Generate a patch before enabling it or exporting a standalone PMP.");
+            return;
+        }
+        var stale = BoneMaskPatchStaleness.FindChangedSources(patch.Assets);
+        ImGui.Text($"Patch: {patch.DisplayName} | {patch.Assets.Count} logical redirect(s)");
+        if (stale.Count > 0)
+            ImGui.TextColored(new System.Numerics.Vector4(1f, .65f, .15f, 1f), "Source animation changed. Rebuild before enabling or exporting.");
+        if (working)
+            ImGui.BeginDisabled();
+        if (ImGui.Button(patch.Enabled ? "Disable live patch" : "Enable live patch"))
+            TogglePatch(patch);
+        ImGui.SameLine();
+        if (ImGui.Button("Rebuild patch"))
+            RebuildPatch(patch);
+        ImGui.SameLine();
+        ImGui.InputText("PMP output", ref exportPath, 1024);
+        ImGui.SameLine();
+        if (ImGui.Button("Export PMP"))
+            ExportPatch(patch);
+        if (working)
+            ImGui.EndDisabled();
+    }
+
+    private void LoadMods()
+    {
+        working = true;
+        status = "Loading installed Penumbra mods...";
+        _ = Task.Run(() =>
+        {
+            try
+            {
+                mods = getModList.Invoke();
+                status = $"Loaded {mods.Count} installed Penumbra mods.";
+            }
+            catch (Exception exception)
+            {
+                status = "Could not load Penumbra mod list: " + exception.Message;
+            }
+            finally { working = false; }
+        });
+    }
+
+    private void InspectSource()
+    {
+        var directory = selectedDirectory!;
+        var name = mods.TryGetValue(directory, out var value) ? value : directory;
+        working = true;
+        status = "Resolving active PAP paths for the player collection...";
+        _ = Task.Run(() =>
+        {
+            try
+            {
+                source = InstalledPenumbraSourceResolver.ResolveMod(plugin.Configuration.PenumbraPath, directory, name, new DalamudActiveGamePathResolver());
+                selectedPaths.Clear();
+                if (source.IsValid)
+                {
+                    foreach (var path in source.ActiveMappings.Select(mapping => mapping.LogicalGamePath))
+                        selectedPaths.Add(path);
+                    status = $"Resolved {source.ActiveMappings.Count} active logical PAP paths from {source.PhysicalSourceGroups.Count} physical source PAP(s).";
+                }
+                else
+                {
+                    status = string.Join(" ", source.Errors);
+                }
+            }
+            catch (Exception exception) { status = "Could not inspect the selected mod: " + exception.Message; }
+            finally { working = false; }
+        });
+    }
+
+    private void Generate()
+    {
+        var directory = selectedDirectory!;
+        var name = mods.TryGetValue(directory, out var value) ? value : directory;
+        var request = new BoneMaskPatchCreationRequest
+        {
+            SourceModDirectory = directory,
+            SourceModName = name,
+            AnimationIndex = animationIndex,
+            ExcludedBoneNames = boneNames.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
+            Scope = new BoneMaskPatchScopeRequest
+            {
+                Scope = scope,
+                SelectedGamePaths = selectedPaths.OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray(),
+                ExplicitlyExcludedCharacterCodes = SmokingIdleFixturePolicy.IsSmokingIdle(name)
+                    ? SmokingIdleFixturePolicy.ExplicitlyExcludedCharacterCodes
+                    : Array.Empty<string>(),
+            },
+        };
+        working = true;
+        status = "Generating Dancy-owned PAPs with VFXEditor...";
+        _ = Task.Run(() =>
+        {
+            var result = plugin.BoneMaskPatches.Create(request);
+            currentPatch = result.Record;
+            status = result.Succeeded
+                ? $"Generated {result.Record!.Assets.Count} Dancy-owned PAP redirect(s)."
+                : string.Join(" ", result.Errors);
+            working = false;
+        });
+    }
+
+    private void TogglePatch(BoneMaskPatchRecord patch)
+    {
+        working = true;
+        status = patch.Enabled ? "Removing Dancy temporary redirects..." : "Applying Dancy temporary redirects...";
+        _ = Task.Run(() =>
+        {
+            var result = patch.Enabled ? plugin.BoneMaskPatches.Disable(patch) : plugin.BoneMaskPatches.Enable(patch);
+            status = result.Message;
+            working = false;
+        });
+    }
+
+    private void ExportPatch(BoneMaskPatchRecord patch)
+    {
+        if (string.IsNullOrWhiteSpace(exportPath))
+        {
+            status = "Choose an output .pmp path first.";
+            return;
+        }
+        working = true;
+        status = "Building and validating standalone PMP...";
+        var output = exportPath;
+        _ = Task.Run(() =>
+        {
+            try
+            {
+                var result = BoneMaskPmpExporter.Export(new BoneMaskPmpExportRequest { Patch = patch, OutputPath = output });
+                status = $"Exported {result.PhysicalPapCount} PAP file(s) and {result.CompanionFileCount} copied companion file(s) for {result.Redirects.Count} animation redirect(s): {result.OutputPath}";
+            }
+            catch (Exception exception) { status = "PMP export failed: " + exception.Message; }
+            finally { working = false; }
+        });
+    }
+
+    private void RebuildPatch(BoneMaskPatchRecord patch)
+    {
+        var request = new BoneMaskPatchCreationRequest
+        {
+            SourceModDirectory = patch.SourceModDirectory,
+            SourceModName = patch.SourceModName,
+            AnimationIndex = patch.Assets.Count == 0 ? 0 : patch.Assets[0].MotionIndex,
+            ExcludedBoneNames = patch.ExcludedBoneNames,
+            Scope = new BoneMaskPatchScopeRequest
+            {
+                Scope = patch.Scope,
+                SelectedGamePaths = patch.Assets.Select(asset => asset.LogicalGamePath).ToArray(),
+                ExplicitlyExcludedCharacterCodes = patch.ExplicitlyExcludedCharacterCodes,
+            },
+        };
+        var restoreEnabled = patch.Enabled;
+        working = true;
+        status = "Rebuilding Dancy-owned PAPs from the current source animation...";
+        _ = Task.Run(() =>
+        {
+            try
+            {
+                if (restoreEnabled)
+                {
+                    var disabled = plugin.BoneMaskPatches.Disable(patch);
+                    if (!disabled.Succeeded)
+                        throw new InvalidOperationException(disabled.Message);
+                }
+                var result = plugin.BoneMaskPatches.Create(request);
+                if (!result.Succeeded)
+                    throw new InvalidOperationException(string.Join(" ", result.Errors));
+                var rebuilt = result.Record!;
+                currentPatch = rebuilt;
+                if (restoreEnabled)
+                {
+                    var enabled = plugin.BoneMaskPatches.Enable(rebuilt);
+                    if (!enabled.Succeeded)
+                        throw new InvalidOperationException(enabled.Message);
+                }
+                status = "Dancy Bone Mask patch rebuilt from the current source animation.";
+            }
+            catch (Exception exception) { status = "Patch rebuild failed: " + exception.Message; }
+            finally { working = false; }
+        });
+    }
+}
