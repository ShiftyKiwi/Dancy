+
+    private static BoneMaskPatchPlan CreatePlan(string source, string sourceHash, IReadOnlyList<string> codes)
+    {
+        var assets = codes.Select(code =>
+        {
+            var path = $"chara/human/{code}/animation/a0001/bt_common/resident/idle.pap";
+            var identity = GeneratedBoneMaskAssets.CreateIdentity(new GeneratedBoneMaskAssetIdentityInput
+            {
+                SourcePapSha256 = sourceHash, ReplacementGamePath = path, MotionIdentity = "havok:0", TargetSkeletonIdentity = "fixture",
+                WriterSchemaVersion = VfxEditorPapRebuildProtocol.WriterSchemaVersion, ExcludedBoneNames = ["iv_ochinko_a"],
+            });
+            return new BoneMaskPatchAssetPlan
+            {
+                LogicalGamePath = path, SourcePhysicalPapPath = source, SourcePapSha256 = sourceHash, TargetSkeletonPath = "C:/fixture.sklb",
+                TargetSkeletonIdentity = "fixture", MotionIndex = 0, MotionName = "idle", AssetIdentity = identity,
+                OutputRelativePath = GeneratedBoneMaskAssets.CreateRelativePath(identity),
+            };
+        }).ToArray();
+        return new BoneMaskPatchPlan
+        {
+            PatchId = "11111111-1111-1111-1111-111111111111", SourceModDirectory = "fixture", SourceModName = "Fixture",
+            Scope = BoneMaskPatchScope.SelectedPaths, ExcludedBoneNames = ["iv_ochinko_a"], Assets = assets,
+        };
+    }
+
+    private static BoneMaskPatchRecord CreateSmokingRecord(string root, string source, string outputA, string outputB)
+    {
