+                        ["Name"] = "VFX and TMB",
+                        ["DefaultSettings"] = 3,
+                        ["Options"] = new JArray
+                        {
+                            new JObject { ["Id"] = "44444444-4444-4444-4444-444444444444", ["Name"] = "TMB", ["Files"] = new JObject { ["chara/action/normal/idle.tmb"] = "source/tmb/idle.tmb" } },
+                            new JObject { ["Id"] = "55555555-5555-5555-5555-555555555555", ["Name"] = "VFX", ["Priority"] = 1, ["Files"] = new JObject { ["vfx/smoke.avfx"] = "source/vfx/smoke.avfx", ["vfx/smoke.atex"] = "source/vfx/smoke.atex" } },
+                        },
