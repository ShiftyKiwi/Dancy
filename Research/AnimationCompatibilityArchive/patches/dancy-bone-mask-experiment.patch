@@ -0,0 +1,867 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using Dancy.Animation;
+using Dancy.Domain;
+using Dancy.Pap;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace Dancy.BoneMasking;
+
+public sealed class BoneMaskPmpExportRequest
+{
+    public BoneMaskPatchRecord Patch { get; init; } = new();
+    public string OutputPath { get; init; } = string.Empty;
+}
+
+public sealed class BoneMaskPmpExportResult
+{
+    public string OutputPath { get; init; } = string.Empty;
+    public string Sha256 { get; init; } = string.Empty;
+    public IReadOnlyDictionary<string, string> Redirects { get; init; } = new Dictionary<string, string>();
+    public IReadOnlyDictionary<string, string> CompanionRedirects { get; init; } = new Dictionary<string, string>();
+    public int PhysicalPapCount { get; init; }
+    public int CompanionFileCount { get; init; }
+    public PmpValidationResult Validation { get; init; } = new();
+}
+
+public sealed class PmpValidationResult
+{
+    public bool ArchiveOpened { get; init; }
+    public bool MetadataValid { get; init; }
+    public bool ReferencedFilesValid { get; init; }
+    public bool PapFilesValid { get; init; }
+    public bool BoneMaskEvidenceValid { get; init; }
+    public bool CompanionAssetsValid { get; init; }
+    public bool AssetManifestValid { get; init; }
+    public bool ScopeValid { get; init; }
+    public IReadOnlyDictionary<string, string> Redirects { get; init; } = new Dictionary<string, string>();
+    public IReadOnlyDictionary<string, string> CompanionRedirects { get; init; } = new Dictionary<string, string>();
+    public IReadOnlyList<string> Errors { get; init; } = Array.Empty<string>();
+    public bool IsValid => ArchiveOpened && MetadataValid && ReferencedFilesValid && PapFilesValid
+                           && BoneMaskEvidenceValid && CompanionAssetsValid && AssetManifestValid && ScopeValid && Errors.Count == 0;
+}
+
+/// <summary>
+/// Produces a standalone FileVersion 4 PMP from Dancy-owned derived PAPs and
+/// captured non-PAP companion groups. PAPs are transformed; companion binaries
+/// are copied byte-for-byte and retain their original Penumbra option semantics.
+/// </summary>
+public static class BoneMaskPmpExporter
+{
+    private static readonly DateTimeOffset ArchiveTimestamp = new(1980, 1, 1, 0, 0, 0, TimeSpan.Zero);
+
+    public static BoneMaskPmpExportResult Export(BoneMaskPmpExportRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        ArgumentNullException.ThrowIfNull(request.Patch);
+        if (string.IsNullOrWhiteSpace(request.OutputPath))
+            throw new ArgumentException("Choose an output .pmp path.", nameof(request));
+        if (!string.Equals(Path.GetExtension(request.OutputPath), ".pmp", StringComparison.OrdinalIgnoreCase))
+            throw new ArgumentException("Dancy standalone exports must use a .pmp path.", nameof(request));
+        if (request.Patch.Assets.Count == 0)
+            throw new InvalidOperationException("Dancy cannot export an empty Bone Mask patch.");
+        if (!request.Patch.CompanionAssetsCaptured)
+            throw new InvalidOperationException("This patch predates companion-asset capture. Rebuild it before exporting a standalone PMP.");
+
+        var stale = BoneMaskPatchStaleness.FindChangedSources(request.Patch);
+        if (stale.Count > 0)
+            throw new InvalidOperationException("A source animation or companion asset changed; rebuild this patch before exporting it.");
+
+        var assets = request.Patch.Assets.OrderBy(asset => asset.LogicalGamePath, StringComparer.OrdinalIgnoreCase).ToArray();
+        ValidateAssetSet(request.Patch, assets);
+        var paps = BuildPapPackage(request.Patch, assets);
+        var companions = BuildCompanionPackage(request.Patch);
+        var defaultRedirects = new Dictionary<string, string>(paps.DefaultRedirects, StringComparer.OrdinalIgnoreCase);
+        AddRedirects(defaultRedirects, companions.DefaultRedirects, "DefaultData");
+        var groups = MergeGroups(companions.Groups, paps.Groups);
+
+        var output = Path.GetFullPath(request.OutputPath);
+        Directory.CreateDirectory(Path.GetDirectoryName(output)!);
+        var temporary = output + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            using (var archive = ZipFile.Open(temporary, ZipArchiveMode.Create))
+            {
+                WriteText(archive, "meta.json", CreateMetadata(request.Patch, defaultRedirects, groups).ToString(Formatting.Indented));
+                WriteText(archive, "dancy-provenance.json", CreateProvenance(request.Patch, assets, companions.AllAssets).ToString(Formatting.Indented));
+                WriteText(archive, "dancy-asset-manifest.json", CreateAssetManifest(request.Patch, assets, companions.AllAssets).ToString(Formatting.Indented));
+                foreach (var packageFile in paps.Files.Values
+                             .Concat(companions.Files.Values)
+                             .GroupBy(file => file.EntryName, StringComparer.OrdinalIgnoreCase)
+                             .Select(group => group.First())
+                             .OrderBy(file => file.EntryName, StringComparer.OrdinalIgnoreCase))
+                {
+                    WriteFile(archive, packageFile.EntryName, packageFile.SourcePath);
+                }
+            }
+
+            var validation = BoneMaskPmpValidator.Validate(temporary, request.Patch);
+            if (!validation.IsValid)
+                throw new InvalidOperationException("Dancy refused to publish an invalid PMP: " + string.Join(" ", validation.Errors));
+            File.Move(temporary, output, overwrite: true);
+            return new BoneMaskPmpExportResult
+            {
+                OutputPath = output,
+                Sha256 = HashFile(output),
+                Redirects = paps.AllRedirects,
+                CompanionRedirects = companions.AllRedirects,
+                PhysicalPapCount = paps.Files.Count,
+                CompanionFileCount = companions.Files.Count,
+                Validation = validation,
+            };
+        }
+        finally
+        {
+            if (File.Exists(temporary))
+                File.Delete(temporary);
+        }
+    }
