+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using Dancy.Animation;
+using Dancy.Domain;
+
+namespace Dancy.BoneMasking;
+
+public enum BoneMaskPatchScope
+{
+    SelectedPaths,
+    CustomSelection,
+    MaleModelsSupportedOnly,
+    FemaleModelsSupportedOnly,
+    AllPatchedPaths,
+}
+
+public sealed class InstalledPapMapping
+{
+    public string SourceModDirectory { get; init; } = string.Empty;
+    public string SourceModName { get; init; } = string.Empty;
+    public string SourceGroupName { get; init; } = string.Empty;
+    public string SourceOptionName { get; init; } = string.Empty;
+    public string LogicalGamePath { get; init; } = string.Empty;
+    public string SourceRelativePapPath { get; init; } = string.Empty;
+    public string SourcePhysicalPapPath { get; init; } = string.Empty;
+    public string SourcePapSha256 { get; init; } = string.Empty;
+    public CharacterPathIdentity Character => CharacterPathIdentity.FromGamePath(LogicalGamePath);
+}
+
+public sealed class PhysicalPapSourceGroup
+{
+    public string SourcePhysicalPapPath { get; init; } = string.Empty;
+    public string SourcePapSha256 { get; init; } = string.Empty;
+    public IReadOnlyList<string> LogicalGamePaths { get; init; } = Array.Empty<string>();
+}
+
+/// <summary>
+/// An unchanged source asset required by the selected animation, for example a
+/// TMB, AVFX, ATEX, or other file in a companion-only option group.
+/// </summary>
+[Serializable]
+public sealed class BoneMaskCompanionAssetRecord
+{
+    public string SourceGroupName { get; set; } = string.Empty;
+    public string SourceOptionName { get; set; } = string.Empty;
+    public string GamePath { get; set; } = string.Empty;
+    public string SourceRelativePath { get; set; } = string.Empty;
+    public string SourcePhysicalPath { get; set; } = string.Empty;
+    public string SourceSha256 { get; set; } = string.Empty;
+    public string AssetType { get; set; } = string.Empty;
+}
+
+/// <summary>
+/// Captures the source group's FileVersion 4 option semantics without retaining
+/// local source paths. During export its file references are replaced with PMP
+/// entries backed by the companion asset records above.
+/// </summary>
+[Serializable]
+public sealed class BoneMaskCompanionGroupRecord
+{
+    public string Name { get; set; } = string.Empty;
+    public int SourceGroupOrder { get; set; }
+    public string SourceGroupMetadataJson { get; set; } = string.Empty;
+    public List<BoneMaskCompanionAssetRecord> Assets { get; set; } = [];
+}
+
+/// <summary>
+/// Captures a source PAP-only option group. During standalone export, only the
+/// selected logical PAP paths are retained and rebound to Dancy-owned outputs.
+/// This preserves Penumbra's checkbox semantics without carrying source files.
+/// </summary>
+[Serializable]
+public sealed class BoneMaskPapOptionGroupRecord
+{
+    public string Name { get; set; } = string.Empty;
+    public int SourceGroupOrder { get; set; }
+    public string SourceGroupMetadataJson { get; set; } = string.Empty;
+}
+
+public sealed class InstalledModSourceResolution
+{
+    public string SourceModDirectory { get; init; } = string.Empty;
+    public string SourceModName { get; init; } = string.Empty;
+    public IReadOnlyList<InstalledPapMapping> ActiveMappings { get; init; } = Array.Empty<InstalledPapMapping>();
+    public IReadOnlyList<PhysicalPapSourceGroup> PhysicalSourceGroups { get; init; } = Array.Empty<PhysicalPapSourceGroup>();
+    public IReadOnlyList<BoneMaskCompanionAssetRecord> DefaultCompanionAssets { get; init; } = Array.Empty<BoneMaskCompanionAssetRecord>();
+    public IReadOnlyList<BoneMaskCompanionGroupRecord> CompanionGroups { get; init; } = Array.Empty<BoneMaskCompanionGroupRecord>();
+    public IReadOnlyList<BoneMaskPapOptionGroupRecord> PapOptionGroups { get; init; } = Array.Empty<BoneMaskPapOptionGroupRecord>();
+    public IReadOnlyList<string> Warnings { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<string> Errors { get; init; } = Array.Empty<string>();
+    public bool IsValid => Errors.Count == 0 && ActiveMappings.Count > 0;
+}
+
+public sealed class BoneMaskPatchScopeRequest
+{
+    public BoneMaskPatchScope Scope { get; init; } = BoneMaskPatchScope.SelectedPaths;
+    public IReadOnlyList<string> SelectedGamePaths { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<string> ExplicitlyExcludedCharacterCodes { get; init; } = Array.Empty<string>();
+}
+
+public sealed class BoneMaskPatchPlanRequest
+{
+    public InstalledModSourceResolution Source { get; init; } = new();
+    public BoneMaskPatchScopeRequest Scope { get; init; } = new();
+    public IReadOnlyList<string> ExcludedBoneNames { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<AnimationTransformComponentMask> ComponentMasks { get; init; } = Array.Empty<AnimationTransformComponentMask>();
+    public int AnimationIndex { get; init; }
+    public string WriterSchemaVersion { get; init; } = string.Empty;
+    public ITargetSkeletonPathResolver TargetSkeletons { get; init; } = new UnavailableTargetSkeletonPathResolver();
+    public IReferencePapPathResolver ReferencePaps { get; init; } = new UnavailableReferencePapPathResolver();
+}
+
+public interface ITargetSkeletonPathResolver
+{
+    bool TryResolve(string logicalGamePath, out string skeletonPath, out string skeletonIdentity, out string error);
+}
+
+public sealed class UnavailableTargetSkeletonPathResolver : ITargetSkeletonPathResolver
+{
+    public bool TryResolve(string logicalGamePath, out string skeletonPath, out string skeletonIdentity, out string error)
+    {
+        skeletonPath = string.Empty;
+        skeletonIdentity = string.Empty;
+        error = "No target skeleton resolver is available.";
+        return false;
+    }
+}
+
+public interface IReferencePapPathResolver
+{
+    bool TryResolve(string logicalGamePath, int animationIndex, out AnimationReferencePap reference, out string error);
+}
+
+public sealed class UnavailableReferencePapPathResolver : IReferencePapPathResolver
+{
+    public bool TryResolve(string logicalGamePath, int animationIndex, out AnimationReferencePap reference, out string error)
+    {
+        reference = new AnimationReferencePap();
+        error = "No unmodified target/reference PAP resolver is available.";
+        return false;
+    }
+}
+
+public sealed class BoneMaskPatchAssetPlan
+{
+    public string LogicalGamePath { get; init; } = string.Empty;
+    public string SourcePhysicalPapPath { get; init; } = string.Empty;
+    public string SourcePapSha256 { get; init; } = string.Empty;
+    public string TargetSkeletonPath { get; init; } = string.Empty;
+    public string TargetSkeletonIdentity { get; init; } = string.Empty;
+    public int MotionIndex { get; init; }
+    public string MotionName { get; init; } = string.Empty;
+    public AnimationReferencePap? ReferencePap { get; init; }
+    public GeneratedBoneMaskAssetIdentity AssetIdentity { get; init; } = new();
+    public string OutputRelativePath { get; init; } = string.Empty;
+}
+
+public sealed class BoneMaskPatchPlan
+{
+    public string PatchId { get; init; } = string.Empty;
+    public string SourceModDirectory { get; init; } = string.Empty;
+    public string SourceModName { get; init; } = string.Empty;
+    public BoneMaskPatchScope Scope { get; init; }
+    public IReadOnlyList<string> ExcludedBoneNames { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<AnimationTransformComponentMask> ComponentMasks { get; init; } = Array.Empty<AnimationTransformComponentMask>();
+    public IReadOnlyList<string> ExplicitlyExcludedCharacterCodes { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<BoneMaskPatchAssetPlan> Assets { get; init; } = Array.Empty<BoneMaskPatchAssetPlan>();
+    public IReadOnlyList<PhysicalPapSourceGroup> PhysicalSourceGroups { get; init; } = Array.Empty<PhysicalPapSourceGroup>();
+    public IReadOnlyList<BoneMaskCompanionAssetRecord> DefaultCompanionAssets { get; init; } = Array.Empty<BoneMaskCompanionAssetRecord>();
+    public IReadOnlyList<BoneMaskCompanionGroupRecord> CompanionGroups { get; init; } = Array.Empty<BoneMaskCompanionGroupRecord>();
+    public IReadOnlyList<BoneMaskPapOptionGroupRecord> PapOptionGroups { get; init; } = Array.Empty<BoneMaskPapOptionGroupRecord>();
+    public IReadOnlyList<string> Warnings { get; init; } = Array.Empty<string>();
+    public IReadOnlyList<string> Errors { get; init; } = Array.Empty<string>();
+    public bool IsValid => Errors.Count == 0 && Assets.Count > 0;
+}
+
+[Serializable]
+public sealed class BoneMaskPatchRecord
+{
+    public const int CurrentSchemaVersion = 4;
+
+    public int SchemaVersion { get; set; } = CurrentSchemaVersion;
+    public string PatchId { get; set; } = string.Empty;
+    public string DisplayName { get; set; } = string.Empty;
+    public string SourceModDirectory { get; set; } = string.Empty;
+    public string SourceModName { get; set; } = string.Empty;
+    public string WriterSchemaVersion { get; set; } = string.Empty;
+    public string TransformationVersion { get; set; } = BoneMaskPatchIdentities.TransformationVersion;
+    public BoneMaskPatchScope Scope { get; set; }
+    public List<string> ExcludedBoneNames { get; set; } = [];
+    public List<AnimationTransformComponentMask> ComponentMasks { get; set; } = [];
+    public List<string> ExplicitlyExcludedCharacterCodes { get; set; } = [];
+    public List<BoneMaskPatchAssetRecord> Assets { get; set; } = [];
+    public bool CompanionAssetsCaptured { get; set; }
+    public List<BoneMaskCompanionAssetRecord> DefaultCompanionAssets { get; set; } = [];
+    public List<BoneMaskCompanionGroupRecord> CompanionGroups { get; set; } = [];
+    public bool PapOptionGroupsCaptured { get; set; }
+    public List<BoneMaskPapOptionGroupRecord> PapOptionGroups { get; set; } = [];
+    public bool Enabled { get; set; }
+}
+
+[Serializable]
+public sealed class BoneMaskPatchAssetRecord
+{
+    public string LogicalGamePath { get; set; } = string.Empty;
+    public string SourcePhysicalPapPath { get; set; } = string.Empty;
+    public string SourcePapSha256 { get; set; } = string.Empty;
+    public string TargetSkeletonIdentity { get; set; } = string.Empty;
+    public string TargetSkeletonPath { get; set; } = string.Empty;
+    public int MotionIndex { get; set; }
+    public string MotionName { get; set; } = string.Empty;
+    public AnimationReferencePap? ReferencePap { get; set; }
+    public string GeneratedAssetKey { get; set; } = string.Empty;
+    public string OutputPapPath { get; set; } = string.Empty;
+    public string OutputRelativePath { get; set; } = string.Empty;
+    public string OutputPapSha256 { get; set; } = string.Empty;
+    public int SourceTrackCount { get; set; }
+    public int OutputTrackCount { get; set; }
+    public List<string> SourceTrackNames { get; set; } = [];
+    public List<string> OutputTrackNames { get; set; } = [];
+    public bool StructuralValidationPassed { get; set; }
+    public bool ExpectedTracksRemoved { get; set; }
+    public bool ComponentTransformsValidated { get; set; }
+    public List<AnimationTransformComponentEvidence> ComponentMaskEvidence { get; set; } = [];
+}
+
+public static class BoneMaskPatchScopes
+{
+    public static IReadOnlyList<InstalledPapMapping> Select(IReadOnlyList<InstalledPapMapping> mappings, BoneMaskPatchScopeRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(mappings);
+        ArgumentNullException.ThrowIfNull(request);
+        var excludedCodes = request.ExplicitlyExcludedCharacterCodes
+            .Where(code => !string.IsNullOrWhiteSpace(code))
+            .Select(code => code.Trim())
+            .ToHashSet(StringComparer.OrdinalIgnoreCase);
+        var selectedPaths = request.SelectedGamePaths
+            .Select(GamePathIdentity.Normalize)
+            .Where(path => !string.IsNullOrWhiteSpace(path))
+            .ToHashSet(StringComparer.OrdinalIgnoreCase);
+
+        var selected = request.Scope switch
+        {
+            BoneMaskPatchScope.SelectedPaths or BoneMaskPatchScope.CustomSelection => mappings.Where(mapping => selectedPaths.Contains(GamePathIdentity.Normalize(mapping.LogicalGamePath))),
+            BoneMaskPatchScope.MaleModelsSupportedOnly => mappings.Where(mapping => mapping.Character.IsKnown && string.Equals(mapping.Character.Sex, "Male", StringComparison.OrdinalIgnoreCase)),
+            BoneMaskPatchScope.FemaleModelsSupportedOnly => mappings.Where(mapping => mapping.Character.IsKnown && string.Equals(mapping.Character.Sex, "Female", StringComparison.OrdinalIgnoreCase)),
+            BoneMaskPatchScope.AllPatchedPaths => mappings,
+            _ => Array.Empty<InstalledPapMapping>(),
+        };
+
+        return selected
+            .Where(mapping => !excludedCodes.Contains(mapping.Character.Code))
+            .GroupBy(mapping => GamePathIdentity.Normalize(mapping.LogicalGamePath), StringComparer.OrdinalIgnoreCase)
+            .Select(group => group.OrderBy(mapping => mapping.SourcePhysicalPapPath, StringComparer.OrdinalIgnoreCase).First())
+            .OrderBy(mapping => mapping.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+            .ToArray();
+    }
+}
+
+public static class SmokingIdleFixturePolicy
+{
+    public static readonly IReadOnlyList<string> PreviousExcludedBoneNames =
+    [
+        "iv_ochinko_a", "iv_ochinko_b", "iv_ochinko_c",
+        "iv_ochinko_d", "iv_ochinko_e", "iv_ochinko_f",
+    ];
+
+    public static readonly IReadOnlyList<string> DefaultExcludedBoneNames =
+    [
+        "iv_ochinko_b", "iv_ochinko_c", "iv_ochinko_d",
+        "iv_ochinko_e", "iv_ochinko_f",
+    ];
+
+    /// <summary>
+    /// C1 keeps the source base position for A while taking only its local
+    /// rotation from the same-rig skeleton rest pose. B-F are explicit
+    /// whole-track exclusions; kougan tracks are intentionally unmasked.
+    /// </summary>
+    public static readonly IReadOnlyList<AnimationTransformComponentMask> C1ComponentMasks =
+    [
+        new AnimationTransformComponentMask
+        {
+            BoneName = "iv_ochinko_a",
+            TranslationMode = AnimationTransformComponentMode.Source,
+            RotationMode = AnimationTransformComponentMode.Rest,
+            ScaleMode = AnimationTransformComponentMode.Source,
+        },
+    ];
+
+    public static readonly IReadOnlyList<string> SupportedMaleCharacterCodes =
+    ["c0101", "c0301", "c0501", "c0701", "c0901", "c1301", "c1501", "c1701"];
+
+    public static readonly IReadOnlyList<string> ExplicitlyExcludedCharacterCodes = ["c1101"];
+
+    public static bool IsSmokingIdle(string modName)
+        => modName.Contains("smoking idle", StringComparison.OrdinalIgnoreCase);
+}
+
+internal static class BoneMaskPatchIdentities
+{
+    public const string TransformationVersion = "dancy-bone-mask-v4";
+
+    public static string CreatePatchId(
+        BoneMaskPatchPlanRequest request,
+        IReadOnlyList<InstalledPapMapping> mappings,
+        IReadOnlyList<string> excludedNames,
+        IReadOnlyList<AnimationTransformComponentMask> componentMasks)
+    {
+        var canonical = string.Join("\n", new[]
+        {
+            TransformationVersion,
+            request.Source.SourceModDirectory.Trim(),
+            request.Scope.Scope.ToString(),
+            request.AnimationIndex.ToString(System.Globalization.CultureInfo.InvariantCulture),
+            request.WriterSchemaVersion.Trim(),
+            string.Join("\n", excludedNames),
+            string.Join("\n", componentMasks.Select(mask => mask.Canonical)),
+            string.Join("\n", request.Scope.ExplicitlyExcludedCharacterCodes.OrderBy(code => code, StringComparer.OrdinalIgnoreCase)),
+        }
+        .Concat(mappings.OrderBy(mapping => mapping.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+            .Select(mapping => $"pap|{GamePathIdentity.Normalize(mapping.LogicalGamePath)}|{mapping.SourcePapSha256}"))
+        .Concat(componentMasks.Any(mask => mask.RequiresTargetReference)
+            ? mappings.OrderBy(mapping => mapping.LogicalGamePath, StringComparer.OrdinalIgnoreCase)
+                .Select(mapping => $"reference|{GamePathIdentity.Normalize(mapping.LogicalGamePath)}")
+            : Array.Empty<string>())
+        .Concat(request.Source.DefaultCompanionAssets
+            .Concat(request.Source.CompanionGroups.SelectMany(group => group.Assets))
+            .OrderBy(asset => asset.GamePath, StringComparer.OrdinalIgnoreCase)
+            .ThenBy(asset => asset.SourceGroupName, StringComparer.OrdinalIgnoreCase)
+            .Select(asset => $"companion|{GamePathIdentity.Normalize(asset.GamePath)}|{asset.SourceSha256}"))
+        .Concat(request.Source.PapOptionGroups
+            .OrderBy(group => group.SourceGroupOrder)
+            .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase)
+            .Select(group => $"pap-group|{group.SourceGroupOrder}|{group.Name}|{group.SourceGroupMetadataJson}")));
+        return new Guid(SHA256.HashData(Encoding.UTF8.GetBytes(canonical))[..16]).ToString("D");
+    }
+}
diff --git a/Dancy/BoneMasking/BoneMaskPatchPlanner.cs b/Dancy/BoneMasking/BoneMaskPatchPlanner.cs
new file mode 100644
index 0000000..b386cf3
--- /dev/null
+++ b/Dancy/BoneMasking/BoneMaskPatchPlanner.cs
@@ -0,0 +1,205 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Dancy.Animation;
+using Dancy.Domain;
+using Dancy.Pap;
+
+namespace Dancy.BoneMasking;
+
+public static class BoneMaskPatchPlanner
+{
+    public static BoneMaskPatchPlan Create(BoneMaskPatchPlanRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        ArgumentNullException.ThrowIfNull(request.Source);
+        ArgumentNullException.ThrowIfNull(request.Scope);
+        ArgumentNullException.ThrowIfNull(request.TargetSkeletons);
+        var errors = new List<string>(request.Source.Errors);
+        var warnings = new List<string>(request.Source.Warnings);
+        var excludedNames = BoneMaskNames.Normalize(request.ExcludedBoneNames);
+        IReadOnlyList<AnimationTransformComponentMask> componentMasks;
+        try
+        {
+            componentMasks = AnimationTransformComponentMasks.Normalize(request.ComponentMasks);
+        }
+        catch (Exception exception)
+        {
+            componentMasks = Array.Empty<AnimationTransformComponentMask>();
+            errors.Add(exception.Message);
+        }
+        if (excludedNames.Count == 0)
+            errors.Add("Select at least one explicit bone name to exclude.");
+        if (string.IsNullOrWhiteSpace(request.WriterSchemaVersion))
+            errors.Add("A writer schema version is required for deterministic cache identity.");
+        if (request.AnimationIndex < 0)
+            errors.Add("Animation index must be zero or greater.");
+
+        var selected = BoneMaskPatchScopes.Select(request.Source.ActiveMappings, request.Scope);
+        if (selected.Count == 0)
+            errors.Add("The selected scope contains no active PAP paths.");
+        var patchId = BoneMaskPatchIdentities.CreatePatchId(request, selected, excludedNames, componentMasks);
+        if (errors.Count > 0)
+            return Result(request, patchId, excludedNames, componentMasks, [], warnings, errors);
+
+        var assets = new List<BoneMaskPatchAssetPlan>();
+        var inspections = new Dictionary<string, PapFileInspector.PapFileInspection>(StringComparer.OrdinalIgnoreCase);
+        foreach (var mapping in selected)
+        {
+            PapFileInspector.PapFileInspection inspection;
+            try
+            {
+                if (!inspections.TryGetValue(mapping.SourcePhysicalPapPath, out inspection!))
+                {
+                    inspection = PapFileInspector.InspectFile(mapping.SourcePhysicalPapPath);
+                    inspections.Add(mapping.SourcePhysicalPapPath, inspection);
+                }
+            }
+            catch (Exception exception)
+            {
+                errors.Add($"Could not inspect {mapping.LogicalGamePath}: {exception.Message}");
+                continue;
+            }
+
+            if (request.AnimationIndex >= inspection.AnimationNames.Count || request.AnimationIndex >= inspection.HavokIndices.Count)
+            {
+                errors.Add($"Animation index {request.AnimationIndex} is not present in {mapping.LogicalGamePath}.");
+                continue;
+            }
+
+            if (!request.TargetSkeletons.TryResolve(mapping.LogicalGamePath, out var skeletonPath, out var skeletonIdentity, out var skeletonError))
+            {
+                errors.Add($"Could not resolve the target skeleton for {mapping.LogicalGamePath}: {skeletonError}");
+                continue;
+            }
+
+            var havokIndex = inspection.HavokIndices[request.AnimationIndex];
+            if (havokIndex < 0)
+            {
+                errors.Add($"The selected PAP animation in {mapping.LogicalGamePath} has an invalid Havok binding index.");
+                continue;
+            }
+
+            AnimationReferencePap? reference = null;
+            if (componentMasks.Any(mask => mask.RequiresTargetReference))
+            {
+                if (!request.ReferencePaps.TryResolve(mapping.LogicalGamePath, request.AnimationIndex, out var resolvedReference, out var referenceError))
+                {
+                    errors.Add($"Could not resolve an unmodified reference PAP for {mapping.LogicalGamePath}: {referenceError}");
+                    continue;
+                }
+                if (string.IsNullOrWhiteSpace(resolvedReference.PhysicalPath) || string.IsNullOrWhiteSpace(resolvedReference.Sha256)
+                    || string.IsNullOrWhiteSpace(resolvedReference.Identity) || resolvedReference.MotionIndex < 0)
+                {
+                    errors.Add($"The resolved reference PAP for {mapping.LogicalGamePath} is incomplete.");
+                    continue;
+                }
+                reference = resolvedReference;
+            }
+
+            var identity = GeneratedBoneMaskAssets.CreateIdentity(new GeneratedBoneMaskAssetIdentityInput
+            {
+                SourcePapSha256 = mapping.SourcePapSha256,
+                ReplacementGamePath = mapping.LogicalGamePath,
+                MotionIdentity = $"havok:{havokIndex}",
+                TargetSkeletonIdentity = skeletonIdentity,
+                WriterSchemaVersion = request.WriterSchemaVersion,
+                ExcludedBoneNames = excludedNames,
+                ComponentMasks = componentMasks,
+                ReferenceIdentity = reference?.Identity ?? string.Empty,
+            });
+            assets.Add(new BoneMaskPatchAssetPlan
+            {
+                LogicalGamePath = mapping.LogicalGamePath,
+                SourcePhysicalPapPath = mapping.SourcePhysicalPapPath,
+                SourcePapSha256 = mapping.SourcePapSha256,
+                TargetSkeletonPath = skeletonPath,
+                TargetSkeletonIdentity = skeletonIdentity,
+                MotionIndex = havokIndex,
+                MotionName = inspection.AnimationNames[request.AnimationIndex],
+                ReferencePap = reference,
+                AssetIdentity = identity,
+                OutputRelativePath = GeneratedBoneMaskAssets.CreateRelativePath(identity),
+            });
+        }
+
+        if (assets.Count == 0 && errors.Count == 0)
+            errors.Add("Dancy did not produce any Bone Mask asset plans.");
+        return Result(request, patchId, excludedNames, componentMasks, assets, warnings, errors);
+    }
+
+    private static BoneMaskPatchPlan Result(
+        BoneMaskPatchPlanRequest request,
+        string patchId,
+        IReadOnlyList<string> excludedNames,
+        IReadOnlyList<AnimationTransformComponentMask> componentMasks,
+        IReadOnlyList<BoneMaskPatchAssetPlan> assets,
+        IReadOnlyList<string> warnings,
+        IReadOnlyList<string> errors)
+        => new()
+        {
+            PatchId = patchId,
+            SourceModDirectory = request.Source.SourceModDirectory,
+            SourceModName = request.Source.SourceModName,
+            Scope = request.Scope.Scope,
+            ExcludedBoneNames = excludedNames,
+            ComponentMasks = componentMasks,
+            ExplicitlyExcludedCharacterCodes = request.Scope.ExplicitlyExcludedCharacterCodes
+                .Where(code => !string.IsNullOrWhiteSpace(code))
+                .Select(code => code.Trim().ToLowerInvariant())
+                .Distinct(StringComparer.OrdinalIgnoreCase)
+                .OrderBy(code => code, StringComparer.OrdinalIgnoreCase)
+                .ToArray(),
+            Assets = assets.OrderBy(asset => asset.LogicalGamePath, StringComparer.OrdinalIgnoreCase).ToArray(),
+            PhysicalSourceGroups = request.Source.PhysicalSourceGroups,
+            DefaultCompanionAssets = request.Source.DefaultCompanionAssets,
+            CompanionGroups = request.Source.CompanionGroups,
+            PapOptionGroups = request.Source.PapOptionGroups,
+            Warnings = warnings.Distinct(StringComparer.Ordinal).ToArray(),
+            Errors = errors.Distinct(StringComparer.Ordinal).ToArray(),
+        };
+}
+
+public static class BoneMaskPatchStaleness
+{
+    public static IReadOnlyList<string> FindChangedSources(BoneMaskPatchRecord patch)
+    {
+        ArgumentNullException.ThrowIfNull(patch);
+        return FindChangedSources(
+            patch.Assets.Select(asset => new SourceFingerprint(asset.SourcePhysicalPapPath, asset.SourcePapSha256))
+                .Concat(patch.Assets.Where(asset => asset.ReferencePap is not null)
+                    .Select(asset => new SourceFingerprint(asset.ReferencePap!.PhysicalPath, asset.ReferencePap.Sha256))),
+            patch.DefaultCompanionAssets.Concat(patch.CompanionGroups.SelectMany(group => group.Assets))
+                .Select(asset => new SourceFingerprint(asset.SourcePhysicalPath, asset.SourceSha256)));
+    }
+
+    public static IReadOnlyList<string> FindChangedSources(IEnumerable<BoneMaskPatchAssetRecord> assets)
+    {
+        ArgumentNullException.ThrowIfNull(assets);
+        return FindChangedSources(assets.Select(asset => new SourceFingerprint(asset.SourcePhysicalPapPath, asset.SourcePapSha256)), []);
+    }
+
+    private static IReadOnlyList<string> FindChangedSources(
+        IEnumerable<SourceFingerprint> papSources,
+        IEnumerable<SourceFingerprint> companionSources)
+    {
+        var stale = new List<string>();
+        foreach (var source in papSources.Concat(companionSources)
+                     .GroupBy(source => source.Path, StringComparer.OrdinalIgnoreCase)
+                     .Select(group => group.First()))
+        {
+            if (string.IsNullOrWhiteSpace(source.Path) || !File.Exists(source.Path))
+            {
+                stale.Add(source.Path);
+                continue;
+            }
+            var current = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(File.ReadAllBytes(source.Path)));
+            if (!string.Equals(current, source.Sha256, StringComparison.OrdinalIgnoreCase))
+                stale.Add(source.Path);
+        }
+        return stale.OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray();
+    }
+
+    private sealed record SourceFingerprint(string Path, string Sha256);
+}
