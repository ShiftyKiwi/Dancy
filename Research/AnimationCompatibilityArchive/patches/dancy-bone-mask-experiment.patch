+        public string Analyze(string requestJson)
+            => JsonSerializer.Serialize(new VfxEditorPapTransformAnalysisResponse { SchemaVersion = 1, ApiVersion = "1.0", Success = true }, VfxEditorPapRebuildProtocol.JsonOptions);
+    }
