+
+    private sealed class FakeVfxGateway : IVfxEditorPapRebuildGateway
+    {
+        public VfxEditorPapRebuildRequest? Request { get; private set; }
+        public string GetCapabilities() => JsonSerializer.Serialize(new VfxEditorPapRebuildCapabilities
+        {
+            SchemaVersion = 1, ApiVersion = "1.0", RebuildExistingPapAnimation = true, RequiresTargetSkeletonPath = true,
+            SupportsExplicitNamedExclusions = true, ProvidesTrackNameEvidence = true, SupportsInPlaceSourceMutation = false,
+            SupportsComponentTransformMasks = true, ProvidesComponentTransformEvidence = true, SupportsReadOnlyTransformAnalysis = true,
+        }, VfxEditorPapRebuildProtocol.JsonOptions);
+        public string Rebuild(string requestJson)
+        {
+            Request = JsonSerializer.Deserialize<VfxEditorPapRebuildRequest>(requestJson, VfxEditorPapRebuildProtocol.JsonOptions);
+            var sourceTracks = Request!.ExcludedBoneNames
+                .Concat(["iv_ochinko_a", "iv_kougan_l", "iv_kougan_r", "n_root"])
+                .Distinct(StringComparer.OrdinalIgnoreCase)
+                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
+                .ToArray();
+            var outputTracks = sourceTracks.Where(name => !Request.ExcludedBoneNames.Contains(name, StringComparer.OrdinalIgnoreCase)).ToArray();
+            return JsonSerializer.Serialize(new VfxEditorPapRebuildResponse
+            {
+                SchemaVersion = 1, ApiVersion = "1.0", Success = true, OutputSha256 = new string('B', 64), SourceTrackCount = sourceTracks.Length,
+                OutputTrackCount = outputTracks.Length, SourceTrackNames = sourceTracks.ToList(), OutputTrackNames = outputTracks.ToList(), ActuallyExcludedBoneNames = Request.ExcludedBoneNames,
+                ReferenceSha256 = string.IsNullOrWhiteSpace(Request.ReferencePath) ? string.Empty : new string('C', 64), ReferenceMotionIndex = Request.ReferenceMotionIndex,
+                ComponentMaskEvidence = Request.ComponentMasks.Select(mask => new VfxEditorPapComponentMaskEvidence
+                {
+                    BoneName = mask.BoneName, TranslationMode = mask.TranslationMode, RotationMode = mask.RotationMode, ScaleMode = mask.ScaleMode,
+                    TranslationMatchesSelectedSource = true, RotationMatchesSelectedSource = true, ScaleMatchesSelectedSource = true,
+                }).ToList(),
+                StructuralValidation = new VfxEditorPapRebuildStructuralValidation
+                {
+                    OutputPapParsed = true, OutputHavokParsed = true, BindingValid = true, ExpectedTracksRemoved = true, NoUnexpectedTracksRemoved = true,
+                    ComponentMasksValid = true, NoUnexpectedTransformChanges = true,
+                },
+            }, VfxEditorPapRebuildProtocol.JsonOptions);
+        }
