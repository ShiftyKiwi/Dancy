+{
+    [Fact]
+    public void GeneratorCreatesOnlyDancyOwnedOutputsAndRetainsSourceBytes()
+    {
+        using var fixture = new TempDirectory();
+        var source = Path.Combine(fixture.Path, "source.pap");
+        var sourceBytes = PapFileInspectorTests.CreateValidPap("idle");
+        File.WriteAllBytes(source, sourceBytes);
+        var plan = CreatePlan(source, Hash(source), ["c0101"]);
+        var patchRoot = Path.Combine(fixture.Path, "patches");
+
+        var record = BoneMaskPatchGenerator.Generate(patchRoot, plan, new FakeWriter());
+
+        var asset = Assert.Single(record.Assets);
+        Assert.True(File.Exists(asset.OutputPapPath));
+        Assert.True(BoneMaskPatchGenerator.IsOwnedPatchDirectory(Path.Combine(patchRoot, record.PatchId), record.PatchId));
+        Assert.Equal(sourceBytes, File.ReadAllBytes(source));
+        Assert.StartsWith(Path.GetFullPath(patchRoot), asset.OutputPapPath, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void MaleSmokingExportContainsExactlyEightSupportedLogicalPathsAndNoLalafellOrFemalePaths()
+    {
+        using var fixture = new TempDirectory();
+        var source = Path.Combine(fixture.Path, "source.pap");
+        var outputA = Path.Combine(fixture.Path, "a.pap");
+        var outputB = Path.Combine(fixture.Path, "b.pap");
+        File.WriteAllBytes(source, PapFileInspectorTests.CreateValidPap("source"));
+        File.WriteAllBytes(outputA, PapFileInspectorTests.CreateValidPap("output_a"));
+        File.WriteAllBytes(outputB, PapFileInspectorTests.CreateValidPap("output_b"));
+        var record = CreateSmokingRecord(fixture.Path, source, outputA, outputB);
+        var first = Path.Combine(fixture.Path, "first.pmp");
+        var second = Path.Combine(fixture.Path, "second.pmp");
+
+        var firstResult = BoneMaskPmpExporter.Export(new BoneMaskPmpExportRequest { Patch = record, OutputPath = first });
+        var secondResult = BoneMaskPmpExporter.Export(new BoneMaskPmpExportRequest { Patch = record, OutputPath = second });
+
+        Assert.True(firstResult.Validation.IsValid, string.Join(" ", firstResult.Validation.Errors));
+        Assert.Equal(SmokingIdleFixturePolicy.SupportedMaleCharacterCodes.Count, firstResult.Redirects.Count);
+        Assert.Equal(2, firstResult.PhysicalPapCount);
+        Assert.Equal(3, firstResult.CompanionFileCount);
+        Assert.Equal(3, firstResult.CompanionRedirects.Count);
+        Assert.True(firstResult.Validation.CompanionAssetsValid, string.Join(" ", firstResult.Validation.Errors));
+        Assert.Equal(firstResult.Sha256, secondResult.Sha256);
+        Assert.DoesNotContain(firstResult.Redirects.Keys, path => path.Contains("/c1101/", StringComparison.OrdinalIgnoreCase));
+        Assert.DoesNotContain(firstResult.Redirects.Keys, path => path.Contains("/c0201/", StringComparison.OrdinalIgnoreCase));
+        Assert.True(File.Exists(first));
+
+        using var archive = System.IO.Compression.ZipFile.OpenRead(first);
+        var metaEntry = Assert.IsType<System.IO.Compression.ZipArchiveEntry>(archive.GetEntry("meta.json"));
+        using var reader = new StreamReader(metaEntry.Open());
+        var meta = JObject.Parse(reader.ReadToEnd());
+        var groups = (meta["Groups"] as JArray)!.OfType<JObject>().ToArray();
+        Assert.Equal(["VFX and TMB", "M options"], groups.Select(group => group["Name"]?.ToString()));
+        var companionGroup = groups[0];
+        Assert.Equal(3, companionGroup["DefaultSettings"]?.Value<int>());
+        var maleGroup = groups[1];
+        Assert.Equal("Multi", maleGroup["Type"]?.ToString());
+        Assert.Equal(255, maleGroup["DefaultSettings"]?.Value<int>());
+        var options = (maleGroup["Options"] as JArray)!.OfType<JObject>().ToArray();
+        Assert.Equal(["M Midlander", "M Highlander", "M Elezen", "M Miqo'te", "M Roe", "M Aura", "Hrothgar", "M Viera"], options.Select(option => option["Name"]?.ToString()));
+        Assert.DoesNotContain(options, option => string.Equals(option["Name"]?.ToString(), "M Lalafell", StringComparison.OrdinalIgnoreCase));
+        Assert.DoesNotContain(groups, group => group["Name"]?.ToString().Contains("F option", StringComparison.OrdinalIgnoreCase) == true);
+        Assert.DoesNotContain(((JObject)meta["DefaultData"]!["Files"]!).Properties(), property => property.Name.EndsWith(".pap", StringComparison.OrdinalIgnoreCase));
+        var expectedCodes = SmokingIdleFixturePolicy.SupportedMaleCharacterCodes;
+        foreach (var (option, code) in options.Zip(expectedCodes))
+        {
+            var files = Assert.IsType<JObject>(option["Files"]);
+            var mapping = Assert.Single(files.Properties());
+            var expectedPath = $"chara/human/{code}/animation/a0001/bt_common/resident/idle.pap";
+            Assert.Equal(expectedPath, mapping.Name);
+            Assert.Equal(firstResult.Redirects[expectedPath], mapping.Value.ToString());
+        }
+        var midlanderEntry = ((JObject)options[0]["Files"]!).Properties().Single().Value.ToString();
+        var highlanderEntry = ((JObject)options[1]["Files"]!).Properties().Single().Value.ToString();
+        Assert.Equal(midlanderEntry, highlanderEntry);
+        Assert.Contains(firstResult.CompanionRedirects.Keys, path => path.EndsWith(".tmb", StringComparison.OrdinalIgnoreCase));
+        Assert.Contains(firstResult.CompanionRedirects.Keys, path => path.EndsWith(".avfx", StringComparison.OrdinalIgnoreCase));
+        Assert.Contains(firstResult.CompanionRedirects.Keys, path => path.EndsWith(".atex", StringComparison.OrdinalIgnoreCase));
+    }
+
