+using Dalamud.Plugin.Ipc;
+using Dancy.BoneMasking;
+
+namespace Dancy.Animation;
+
+internal sealed class DalamudVfxEditorPapRebuildGateway : IVfxEditorPapRebuildGateway
+{
+    private readonly ICallGateSubscriber<string> capabilities = Plugin.PluginInterface.GetIpcSubscriber<string>(VfxEditorPapRebuildProtocol.CapabilitiesEndpoint);
+    private readonly ICallGateSubscriber<string, string> rebuild = Plugin.PluginInterface.GetIpcSubscriber<string, string>(VfxEditorPapRebuildProtocol.RebuildEndpoint);
+    private readonly ICallGateSubscriber<string, string> analyze = Plugin.PluginInterface.GetIpcSubscriber<string, string>(VfxEditorPapRebuildProtocol.AnalyzeEndpoint);
+
+    public string GetCapabilities() => DalamudFrameworkInvocation.Invoke(capabilities.InvokeFunc);
+    public string Rebuild(string requestJson) => DalamudFrameworkInvocation.Invoke(() => rebuild.InvokeFunc(requestJson));
+    public string Analyze(string requestJson) => DalamudFrameworkInvocation.Invoke(() => analyze.InvokeFunc(requestJson));
+}
diff --git a/Dancy/Animation/VfxEditorIpcAnimationTrackExclusionWriter.cs b/Dancy/Animation/VfxEditorIpcAnimationTrackExclusionWriter.cs
new file mode 100644
index 0000000..caced3a
--- /dev/null
+++ b/Dancy/Animation/VfxEditorIpcAnimationTrackExclusionWriter.cs
@@ -0,0 +1,307 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+
+namespace Dancy.Animation;
+
+/// <summary>
+/// Production writer adapter for VFXEditor's versioned public IPC. It does not
+/// know or expose VFXEditor's native, Havok, or UI implementation types.
+/// </summary>
+public sealed class VfxEditorIpcAnimationTrackExclusionWriter : IAnimationTrackExclusionWriter
+{
+    public const string UnavailableErrorCode = "VfxEditorUnavailable";
+    public const string UnsupportedErrorCode = "VfxEditorUnsupported";
+    public const string InvalidMotionErrorCode = "InvalidMotionIdentity";
+
+    private readonly IVfxEditorPapRebuildGateway gateway;
+
+    public VfxEditorIpcAnimationTrackExclusionWriter(IVfxEditorPapRebuildGateway gateway)
+        => this.gateway = gateway ?? throw new ArgumentNullException(nameof(gateway));
+
+    public string BackendId => "vfxeditor-ipc";
+
+    public VfxEditorPapRebuildCapabilities GetCapabilities()
+    {
+        var raw = gateway.GetCapabilities();
+        return JsonSerializer.Deserialize<VfxEditorPapRebuildCapabilities>(raw, VfxEditorPapRebuildProtocol.JsonOptions)
+               ?? throw new InvalidDataException("VFXEditor returned an empty capabilities response.");
+    }
+
+    public AnimationTrackExclusionWriteResult RebuildWithExcludedBones(AnimationTrackExclusionWriteRequest request)
+    {
+        ArgumentNullException.ThrowIfNull(request);
+        if (!TryGetMotionIndex(request.Association.MotionIdentity, out var motionIndex))
+            return Failure(request, InvalidMotionErrorCode, "Dancy requires a Havok binding motion identity in the form havok:<index>.");
+        var expectedNames = AnimationTrackExclusionResultValidator.RequestedNames(request);
+        if (expectedNames.Count == 0)
+            return Failure(request, "InvalidBoneMaskPlan", "Select at least one explicit bone name to exclude.");
+        if (request.RequestedBoneNames.Count == 0 && request.ExclusionPlan.HasBlockingResolution)
+            return Failure(request, "InvalidBoneMaskPlan", "The Bone Mask has unresolved, ambiguous, or non-animated selected tracks.");
+        if (string.IsNullOrWhiteSpace(request.Association.TargetSkeletonPath))
+            return Failure(request, "MissingTargetSkeleton", "Dancy did not resolve a local target skeleton for this logical game path.");
+        if (string.IsNullOrWhiteSpace(request.SourcePapPath) || string.IsNullOrWhiteSpace(request.DancyOwnedOutputPath))
+            return Failure(request, "InvalidOutputPath", "The source and Dancy-owned output PAP paths are required.");
+        IReadOnlyList<AnimationTransformComponentMask> componentMasks;
+        try
+        {
+            componentMasks = AnimationTransformComponentMasks.Normalize(request.ComponentMasks);
+        }
+        catch (Exception exception)
+        {
+            return Failure(request, "InvalidComponentMaskPlan", exception.Message);
+        }
+        if (componentMasks.Any(mask => mask.RequiresTargetReference)
+            && (request.ReferencePap is null || string.IsNullOrWhiteSpace(request.ReferencePap.PhysicalPath)
+                || string.IsNullOrWhiteSpace(request.ReferencePap.Sha256) || request.ReferencePap.MotionIndex < 0))
+        {
+            return Failure(request, "MissingTargetReference", "The selected transform component requires an explicit target/reference PAP and motion index.");
+        }
+
+        VfxEditorPapRebuildCapabilities capabilities;
+        try
+        {
+            capabilities = GetCapabilities();
+        }
+        catch (Exception exception)
+        {
+            return Failure(request, UnavailableErrorCode, $"VFXEditor PAP rebuild capability is unavailable: {exception.Message}");
+        }
+
+        if (capabilities.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+            || !capabilities.RebuildExistingPapAnimation
+            || !capabilities.RequiresTargetSkeletonPath
+            || !capabilities.SupportsExplicitNamedExclusions
+            || !capabilities.ProvidesTrackNameEvidence
+            || (componentMasks.Count > 0 && (!capabilities.SupportsComponentTransformMasks || !capabilities.ProvidesComponentTransformEvidence))
+            || capabilities.SupportsInPlaceSourceMutation)
+        {
+            return Failure(request, UnsupportedErrorCode, "The loaded VFXEditor does not provide the required safe PAP rebuild capability.");
+        }
+
+        var payload = new VfxEditorPapRebuildRequest
+        {
+            SourcePath = request.SourcePapPath,
+            OutputPath = request.DancyOwnedOutputPath,
+            TargetSkeletonPath = request.Association.TargetSkeletonPath,
+            MotionIndex = motionIndex,
+            ExcludedBoneNames = expectedNames.ToList(),
+            ReferencePath = request.ReferencePap?.PhysicalPath ?? string.Empty,
+            ReferenceMotionIndex = request.ReferencePap?.MotionIndex ?? -1,
+            ComponentMasks = componentMasks.Select(mask => new VfxEditorPapTransformComponentMask
+            {
+                BoneName = mask.BoneName,
+                TranslationMode = AnimationTransformComponentMask.ToProtocolMode(mask.TranslationMode),
+                RotationMode = AnimationTransformComponentMask.ToProtocolMode(mask.RotationMode),
+                ScaleMode = AnimationTransformComponentMask.ToProtocolMode(mask.ScaleMode),
+            }).ToList(),
+        };
+
+        VfxEditorPapRebuildResponse response;
+        try
+        {
+            var raw = gateway.Rebuild(JsonSerializer.Serialize(payload, VfxEditorPapRebuildProtocol.JsonOptions));
+            response = JsonSerializer.Deserialize<VfxEditorPapRebuildResponse>(raw, VfxEditorPapRebuildProtocol.JsonOptions)
+                       ?? throw new InvalidDataException("VFXEditor returned an empty PAP rebuild response.");
+        }
+        catch (Exception exception)
+        {
+            return Failure(request, UnavailableErrorCode, $"VFXEditor PAP rebuild call failed: {exception.Message}");
+        }
+
+        if (!response.Success)
+            return Failure(request, response.ErrorCode ?? "VfxEditorRebuildFailed", response.Error ?? "VFXEditor did not rebuild the PAP.");
+        if (response.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+            || !string.Equals(response.ApiVersion, VfxEditorPapRebuildProtocol.ApiVersion, StringComparison.Ordinal))
+        {
+            return Failure(request, UnsupportedErrorCode, "VFXEditor returned an unsupported PAP rebuild response version.");
+        }
+        if (!string.IsNullOrWhiteSpace(response.SourceSha256)
+            && !string.Equals(response.SourceSha256, request.AssetIdentity.SourcePapSha256, StringComparison.OrdinalIgnoreCase))
+        {
+            return Failure(request, "SourceChanged", "The source PAP changed after Dancy planned this Bone Mask operation.");
+        }
+        if (componentMasks.Any(mask => mask.RequiresTargetReference)
+            && (!string.Equals(response.ReferenceSha256, request.ReferencePap!.Sha256, StringComparison.OrdinalIgnoreCase)
+                || response.ReferenceMotionIndex != request.ReferencePap.MotionIndex))
+        {
+            return Failure(request, "ReferenceChanged", "The target/reference PAP changed after Dancy planned this component transform operation.");
+        }
+
+        var actualNames = BoneMaskNames.Normalize(response.ActuallyExcludedBoneNames);
+        var sourceTrackNames = BoneMaskNames.Normalize(response.SourceTrackNames);
+        var outputTrackNames = BoneMaskNames.Normalize(response.OutputTrackNames);
+        var expectedRetained = sourceTrackNames.Where(name => !actualNames.Contains(name, StringComparer.OrdinalIgnoreCase))
+            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase).ToArray();
+        var noUnexpectedMappings = response.SkippedBones.Count == 0
+                                  && expectedNames.SequenceEqual(actualNames, StringComparer.OrdinalIgnoreCase)
+                                  && sourceTrackNames.Count == response.SourceTrackCount
+                                  && outputTrackNames.Count == response.OutputTrackCount
+                                  && response.StructuralValidation.NoUnexpectedTracksRemoved
+                                  && expectedRetained.SequenceEqual(outputTrackNames.OrderBy(name => name, StringComparer.OrdinalIgnoreCase), StringComparer.OrdinalIgnoreCase);
+        var componentEvidence = response.ComponentMaskEvidence.Select(ToEvidence).ToArray();
+        return new AnimationTrackExclusionWriteResult
+        {
+            Succeeded = true,
+            BackendId = BackendId,
+            GeneratedAssetKey = request.AssetIdentity.Key,
+            OutputPapPath = request.DancyOwnedOutputPath,
+            OutputPapSha256 = response.OutputSha256,
+            SourceTrackCount = response.SourceTrackCount ?? -1,
+            OutputTrackCount = response.OutputTrackCount ?? -1,
+            SourceTrackNames = sourceTrackNames,
+            OutputTrackNames = outputTrackNames,
+            ExcludedBoneNames = actualNames,
+            ComponentMaskEvidence = componentEvidence,
+            Validation = new AnimationTrackExclusionStructuralValidation
+            {
+                PapParsed = response.StructuralValidation.OutputPapParsed,
+                HkxParsed = response.StructuralValidation.OutputHavokParsed,
+                BindingsValid = response.StructuralValidation.BindingValid,
+                ExpectedTracksRemoved = response.StructuralValidation.ExpectedTracksRemoved,
+                NoUnexpectedMappings = noUnexpectedMappings,
+                ComponentMasksValid = componentMasks.Count == 0 || response.StructuralValidation.ComponentMasksValid,
+                NoUnexpectedTransformChanges = componentMasks.Count == 0 || response.StructuralValidation.NoUnexpectedTransformChanges,
+                // The public VFXEditor producer validates exact tracks/bindings.
+                // Dancy does not pretend it can sample VFXEditor's native state.
+                ReconstructedRetainedTracks = false,
+                RetainedTracksSemanticallyEquivalent = false,
+                Warnings = response.Warnings,
+            },
+        };
+    }
+
+    /// <summary>Runs VFXEditor's public sampling endpoint without creating output files.</summary>
+    public IReadOnlyList<AnimationTransformTrackEvidence> Analyze(
+        string sourcePapPath,
+        string sourcePapSha256,
+        string referencePapPath,
+        string referencePapSha256,
+        string targetSkeletonPath,
+        int motionIndex,
+        int referenceMotionIndex,
+        IReadOnlyList<string> boneNames,
+        bool useSkeletonRest = false)
+    {
+        var capabilities = GetCapabilities();
+        if (capabilities.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+            || !capabilities.SupportsReadOnlyTransformAnalysis
+            || !capabilities.ProvidesComponentTransformEvidence
+            || (useSkeletonRest && !capabilities.SupportsSkeletonRestTransformAnalysis))
+        {
+            throw new InvalidOperationException("The loaded VFXEditor does not provide the required read-only transform analysis capability.");
+        }
+        var request = new VfxEditorPapTransformAnalysisRequest
+        {
+            SourcePath = sourcePapPath,
+            ReferencePath = referencePapPath,
+            TargetSkeletonPath = targetSkeletonPath,
+            MotionIndex = motionIndex,
+            ReferenceMotionIndex = referenceMotionIndex,
+            UseSkeletonRest = useSkeletonRest,
+            BoneNames = BoneMaskNames.Normalize(boneNames).ToList(),
+        };
+        var response = JsonSerializer.Deserialize<VfxEditorPapTransformAnalysisResponse>(gateway.Analyze(JsonSerializer.Serialize(request, VfxEditorPapRebuildProtocol.JsonOptions)), VfxEditorPapRebuildProtocol.JsonOptions)
+                       ?? throw new InvalidDataException("VFXEditor returned an empty PAP transform analysis response.");
+        if (!response.Success)
+            throw new InvalidOperationException(response.ErrorCode + ": " + response.Error);
+        var responseMatchesReference = useSkeletonRest
+            ? string.Equals(response.ReferenceKind, "SKELETON_REST", StringComparison.Ordinal)
+              && string.IsNullOrEmpty(response.ReferenceSha256)
+              && response.ReferenceMotionIndex is null
+            : string.Equals(response.ReferenceKind, "PAP", StringComparison.Ordinal)
+              && string.Equals(response.ReferenceSha256, referencePapSha256, StringComparison.OrdinalIgnoreCase)
+              && response.ReferenceMotionIndex == referenceMotionIndex;
+        if (response.SchemaVersion != VfxEditorPapRebuildProtocol.SchemaVersion
+            || !string.Equals(response.ApiVersion, VfxEditorPapRebuildProtocol.ApiVersion, StringComparison.Ordinal)
+            || !string.Equals(response.SourceSha256, sourcePapSha256, StringComparison.OrdinalIgnoreCase)
+            || !responseMatchesReference
+            || response.MotionIndex != motionIndex)
+        {
+            throw new InvalidDataException("VFXEditor returned transform analysis for a different source or reference asset.");
+        }
+        return response.Tracks.Select(ToEvidence).ToArray();
+    }
+
+    private AnimationTrackExclusionWriteResult Failure(AnimationTrackExclusionWriteRequest request, string errorCode, string error)
+        => new()
+        {
+            Succeeded = false,
+            BackendId = BackendId,
+            GeneratedAssetKey = request.AssetIdentity.Key,
+            ErrorCode = errorCode,
+            Error = error,
+        };
+
+    private static bool TryGetMotionIndex(string motionIdentity, out int index)
+    {
+        index = -1;
+        var value = motionIdentity?.Trim() ?? string.Empty;
+        if (value.StartsWith("havok:", StringComparison.OrdinalIgnoreCase))
+            value = value["havok:".Length..];
+        return int.TryParse(value, out index) && index >= 0;
+    }
+
+    private static AnimationTransformComponentEvidence ToEvidence(VfxEditorPapComponentMaskEvidence source)
+        => new()
+        {
+            BoneName = source.BoneName,
+            TranslationMode = ParseMode(source.TranslationMode),
+            RotationMode = ParseMode(source.RotationMode),
+            ScaleMode = ParseMode(source.ScaleMode),
+            TranslationMatchesSelectedSource = source.TranslationMatchesSelectedSource,
+            RotationMatchesSelectedSource = source.RotationMatchesSelectedSource,
+            ScaleMatchesSelectedSource = source.ScaleMatchesSelectedSource,
+            SourceReferenceAnalysis = source.Analysis is null ? null : ToEvidence(source.Analysis),
+            Output = source.Result is null ? null : ToSummary(source.Result),
+        };
+
+    private static AnimationTransformTrackEvidence ToEvidence(VfxEditorPapTransformTrackAnalysis source)
+        => new()
+        {
+            BoneName = source.BoneName,
+            SourceTrackPresent = source.SourceTrackPresent,
+            ReferenceTrackPresent = source.ReferenceTrackPresent,
+            Source = source.Source is null ? null : ToSummary(source.Source),
+            Reference = source.Reference is null ? null : ToSummary(source.Reference),
+            SourceToReference = source.SourceToReference is null ? null : new AnimationTransformDifferenceEvidence
+            {
+                MaximumTranslationDifference = source.SourceToReference.MaximumTranslationDifference,
+                MaximumRotationDifferenceDegrees = source.SourceToReference.MaximumRotationDifferenceDegrees,
+                MaximumScaleDifference = source.SourceToReference.MaximumScaleDifference,
+            },
+        };
+
+    private static AnimationTransformTrackSummary ToSummary(VfxEditorPapTransformTrackSummary source)
+        => new()
+        {
+            SampleCount = source.SampleCount,
+            TranslationChanges = source.TranslationChanges,
+            RotationChanges = source.RotationChanges,
+            ScaleChanges = source.ScaleChanges,
+            TranslationRangeMagnitude = source.TranslationRangeMagnitude,
+            RotationRangeDegrees = source.RotationRangeDegrees,
+            ScaleRangeMagnitude = source.ScaleRangeMagnitude,
+            FirstSample = source.FirstSample is null ? null : ToTransform(source.FirstSample),
+            LastSample = source.LastSample is null ? null : ToTransform(source.LastSample),
+        };
+
+    private static AnimationTransform ToTransform(VfxEditorPapTransformValue source)
+        => new()
+        {
+            TranslationX = source.TranslationX, TranslationY = source.TranslationY, TranslationZ = source.TranslationZ,
+            RotationX = source.RotationX, RotationY = source.RotationY, RotationZ = source.RotationZ, RotationW = source.RotationW,
+            ScaleX = source.ScaleX, ScaleY = source.ScaleY, ScaleZ = source.ScaleZ,
+        };
+
+    private static AnimationTransformComponentMode ParseMode(string mode) => mode switch
+    {
+        "SOURCE" => AnimationTransformComponentMode.Source,
+        "TARGET_REFERENCE" => AnimationTransformComponentMode.TargetReference,
+        "REST" => AnimationTransformComponentMode.Rest,
+        "REMOVE_TRACK" => AnimationTransformComponentMode.RemoveTrack,
+        _ => throw new InvalidDataException("VFXEditor returned an unknown transform component mode: " + mode),
+    };
+}
diff --git a/Dancy/Animation/VfxEditorPapRebuildProtocol.cs b/Dancy/Animation/VfxEditorPapRebuildProtocol.cs
new file mode 100644
index 0000000..df0c5a1
--- /dev/null
+++ b/Dancy/Animation/VfxEditorPapRebuildProtocol.cs
@@ -0,0 +1,201 @@
+using System;
+using System.Collections.Generic;
+using System.Text.Json;
+
+namespace Dancy.Animation;
+
+/// <summary>
+/// BCL-only mirror of VFXEditor's public PAP rebuild JSON contract. Dancy does
+/// not reference VFXEditor's CLR types and does not use private reflection.
+/// </summary>
+public static class VfxEditorPapRebuildProtocol
+{
+    public const int SchemaVersion = 1;
+    public const string ApiVersion = "1.0";
+    public const string RebuildEndpoint = "VFXEditor.PapAnimationRebuild";
+    public const string CapabilitiesEndpoint = "VFXEditor.PapAnimationRebuild.Capabilities";
+    public const string AnalyzeEndpoint = "VFXEditor.PapAnimationRebuild.Analyze";
+    public const string WriterSchemaVersion = "vfxeditor-ipc/1.1";
+
+    public static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        PropertyNameCaseInsensitive = true,
+    };
+}
+
+public interface IVfxEditorPapRebuildGateway
+{
+    string GetCapabilities();
+    string Rebuild(string requestJson);
+    string Analyze(string requestJson);
+}
+
+public sealed class VfxEditorPapRebuildCapabilities
+{
+    public int SchemaVersion { get; set; }
+    public string ApiVersion { get; set; } = string.Empty;
+    public string VfxEditorVersion { get; set; } = string.Empty;
+    public bool RebuildExistingPapAnimation { get; set; }
+    public bool RequiresTargetSkeletonPath { get; set; }
+    public bool SupportsExplicitNamedExclusions { get; set; }
+    public bool ProvidesTrackNameEvidence { get; set; }
+    public bool SupportsComponentTransformMasks { get; set; }
+    public bool ProvidesComponentTransformEvidence { get; set; }
+    public bool SupportsReadOnlyTransformAnalysis { get; set; }
+    public bool SupportsSkeletonRestTransformAnalysis { get; set; }
+    public bool SupportsInPlaceSourceMutation { get; set; }
+}
+
+public sealed class VfxEditorPapRebuildRequest
+{
+    public int SchemaVersion { get; set; } = VfxEditorPapRebuildProtocol.SchemaVersion;
+    public string SourcePath { get; set; } = string.Empty;
+    public string OutputPath { get; set; } = string.Empty;
+    public string TargetSkeletonPath { get; set; } = string.Empty;
+    public int MotionIndex { get; set; }
+    public List<string> ExcludedBoneNames { get; set; } = [];
+    public string ReferencePath { get; set; } = string.Empty;
+    public int ReferenceMotionIndex { get; set; } = -1;
+    public List<VfxEditorPapTransformComponentMask> ComponentMasks { get; set; } = [];
+}
+
+public sealed class VfxEditorPapRebuildResponse
+{
+    public int SchemaVersion { get; set; }
+    public string ApiVersion { get; set; } = string.Empty;
+    public string VfxEditorVersion { get; set; } = string.Empty;
+    public bool Success { get; set; }
+    public string SourceSha256 { get; set; } = string.Empty;
+    public string OutputSha256 { get; set; } = string.Empty;
+    public int? MotionIndex { get; set; }
+    public string MotionName { get; set; } = string.Empty;
+    public int? SourceTrackCount { get; set; }
+    public int? OutputTrackCount { get; set; }
+    public List<string> SourceTrackNames { get; set; } = [];
+    public List<string> OutputTrackNames { get; set; } = [];
+    public List<string> RequestedExcludedBoneNames { get; set; } = [];
+    public List<string> ActuallyExcludedBoneNames { get; set; } = [];
+    public List<VfxEditorPapRebuildSkippedBone> SkippedBones { get; set; } = [];
+    public string ReferenceSha256 { get; set; } = string.Empty;
+    public int? ReferenceMotionIndex { get; set; }
+    public float? ReferenceDurationSeconds { get; set; }
+    public List<VfxEditorPapComponentMaskEvidence> ComponentMaskEvidence { get; set; } = [];
+    public VfxEditorPapRebuildStructuralValidation StructuralValidation { get; set; } = new();
+    public string? ErrorCode { get; set; }
+    public string? Error { get; set; }
+    public List<string> Warnings { get; set; } = [];
+}
+
+public sealed class VfxEditorPapRebuildSkippedBone
+{
+    public string Name { get; set; } = string.Empty;
+    public string Reason { get; set; } = string.Empty;
+}
+
+public sealed class VfxEditorPapRebuildStructuralValidation
+{
+    public bool OutputPapParsed { get; set; }
+    public bool OutputHavokParsed { get; set; }
+    public bool BindingValid { get; set; }
+    public bool ExpectedTracksRemoved { get; set; }
+    public bool NoUnexpectedTracksRemoved { get; set; }
+    public bool ComponentMasksValid { get; set; }
+    public bool NoUnexpectedTransformChanges { get; set; }
+}
+
+public sealed class VfxEditorPapTransformComponentMask
+{
+    public string BoneName { get; set; } = string.Empty;
+    public string TranslationMode { get; set; } = string.Empty;
